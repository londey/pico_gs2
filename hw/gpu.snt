// The pico-gs2 GPU core.
//
// A 640x360 RGB565 framebuffer in SDRAM, scanned out to 1280x720 DVI with
// every framebuffer pixel shown as 2x2 screen pixels, all on the 75 MHz core
// clock, which is also the pixel clock. After the SDRAM's power-up sequence
// the core writes a test pattern into the framebuffer in bank 0 and shows
// it, then draws the built-in scene (ADR 0002), a frame at a time: the
// command parser feeds the setup engine, and the rasteriser clears the
// frame and writes its triangles back block by block, depth tested against
// a 16-bit depth buffer in bank 3.
//
// Triple buffering: colour buffers in banks 0, 1 and 2, one shown, one
// being drawn, and one either finished and waiting to be shown or spare.
// A finished frame is shown from the next frame start; the parser waits
// at an end of frame while one is already waiting.
//
// The SDRAM controller has one request port; an arbiter shares it: the
// fill until it is done, then scan-out loads first and the rasteriser's
// writes in the gaps.
//
// The framebuffer is tiled (ADR 0003): 80 x 45 blocks of 8x8 pixels, block
// (bx, by) the 64 words from (by * 80 + bx) * 64, its pixels in raster
// order. The top and bottom halves of a block (8x4, a "half block") are one
// 32-word SDRAM run each. Scan-out reads half blocks into a ring of 192
// half-block slots in block RAM, a half-block row (4 framebuffer lines, 80
// half blocks) at a time, running ahead of the display while there are free
// slots, so each pixel is read from SDRAM once.
//
// board/top.sv serialises the TMDS symbols and owns the SDRAM's clock and
// DQ buffers.

mod raster;
mod sdram;
mod setup;
mod video;

use root::raster::Parser;
use root::raster::Raster;
use root::sdram::SdramController;
use root::sdram::SdramPins;
use root::sdram::SdramReq;
use root::setup::RESULT_KEPT;
use root::setup::SetupEngine;
use root::video::TmdsEncoder;
use root::video::VideoTiming;
use root::video::cea_1280x720;

// The framebuffer's last pixel column and line.
const FB_LAST_X: u10 = 639;
const FB_LAST_Y: u10 = 359;

// The last block column of the framebuffer.
const LAST_BX: u7 = 79;

// Start address of the last SDRAM run of the framebuffer.
const LAST_RUN: u18 = 230368;

// Words per SDRAM run: a half block. A row is 512 words and the frame
// starts at word 0, so runs never cross a row.
const RUN: u6 = 32;

// Words between the starts of the two halves of the next block row.
const BLOCK_ROW: u18 = 5120;

// Half-block slots in the scan-out ring, and in a half-block row.
const RING: u13 = 192;
const ROW_SLOTS: u13 = 80;
const LAST_SLOT: u8 = 191;

// Half blocks in the frame: 90 half-block rows of 80.
const FRAME_SLOTS: u13 = 7200;

// Who an SDRAM request, or run, belongs to.
const OWNER_NONE: u2 = 0;
const OWNER_FILL: u2 = 1;
const OWNER_SCAN: u2 = 2;
const OWNER_RASTER: u2 = 3;

// The screen's active area: the first pixel after it, and its last line.
const H_ACTIVE: u11 = 1280;
const V_LAST: u11 = 719;

// The ring and the display's pipeline registers are #[no_reset] (ADR 0006):
// the fill, load and scan-out state decide when they matter.
struct Gpu {
    // Free-running counter for the heartbeat.
    count: u27 = 0,
    sdram: SdramController,
    // The arbiter: the request in front of the controller, held in a
    // register until it is accepted (so that choosing it isn't on the
    // controller's paths), whose it is, and whose run the controller's
    // words belong to.
    granted: u2 = 0,
    #[no_reset]
    granted_req: SdramReq,
    data_owner: u2 = 0,

    // The triangle pipeline.
    parser: Parser,
    setup: SetupEngine,
    raster: Raster,

    // The colour buffers' banks: shown, being drawn, and the third: a
    // finished frame waiting to be shown (`ready_valid`), else spare.
    disp: u2 = 0,
    draw: u2 = 1,
    third: u2 = 2,
    ready_valid: u1 = 0,
    // Toggled at every frame shown (LED 4).
    frame_led: u1 = 0,
    // Cycles spent on the frame being drawn, not counting the wait for the
    // display to take the last one.
    render_count: u24 = 0,

    // For the tests: frames shown, and the last finished frame's cycles.
    pub debug_frames: u16 = 0,
    pub debug_render_cycles: u24 = 0,

    // The fill: high until the test pattern is in the framebuffer, the
    // address of its next run, and the pixel it writes next: pixel (px, py)
    // of block (bx, by), in the framebuffer's word order.
    filling: u1 = 1,
    fill_addr: u18 = 0,
    fill_px: u3 = 0,
    fill_py: u3 = 0,
    fill_bx: u7 = 0,
    fill_by: u6 = 0,

    // Scan-out loading, from the end of the first frame after the fill.
    loading: u1 = 0,
    // The loads of this frame: half blocks requested, the next one's column
    // (`load_bx`), half-block row and its block row's first word.
    issued: u13 = 0,
    load_bx: u7 = 0,
    load_row: u7 = 0,
    load_rowbase: u18 = 0,
    // Arrived: complete half blocks, the next word's place in its half
    // block, and the ring slot it goes to.
    received: u13 = 0,
    recv_word: u5 = 0,
    recv_slot: u8 = 0,
    // Half blocks the display has finished with, and the ring slot of the
    // first half block of the row it is showing.
    freed: u13 = 0,
    show_slot: u8 = 0,
    // 192 half blocks, slot s holding pixel (px, py) at word s @ py @ px:
    // slots 0 to 127 in `ring_lo`, 128 to 191 in `ring_hi` (a memory's
    // depth must be a power of two, and 8192 words would take 8 block RAMs,
    // not 6). `ring_hi_1` says which the last read was from.
    #[no_reset]
    ring_lo: mem<u16, 4096> = 0,
    #[no_reset]
    ring_hi: mem<u16, 2048> = 0,
    #[no_reset]
    ring_hi_1: u1 = 0,

    // The display.
    timing: VideoTiming,
    // Sticky: an active pixel's half-block row wasn't in the ring.
    underflow: u1 = 0,
    // The beam, one cycle behind `timing`, to meet the ring's read.
    #[no_reset]
    de_1: u1 = 0,
    #[no_reset]
    hsync_1: u1 = 0,
    #[no_reset]
    vsync_1: u1 = 0,
    // The pixel shows the ring's word (else black).
    #[no_reset]
    show_1: u1 = 0,
    // The pixel's half-block row wasn't in the ring (show red).
    #[no_reset]
    missing_1: u1 = 0,
    enc_blue: TmdsEncoder,
    enc_green: TmdsEncoder,
    enc_red: TmdsEncoder,

    // The 10-bit TMDS symbols for board/top.sv, one per cycle.
    #[no_reset]
    pub tmds_blue: u10 = 0,
    #[no_reset]
    pub tmds_green: u10 = 0,
    #[no_reset]
    pub tmds_red: u10 = 0,
}

// The core's outputs to the board.
struct Out {
    // The user LEDs, active high: led[0] the heartbeat (about 0.56 Hz),
    // led[1] SDRAM initialised, led[2] framebuffer filled, led[3] a pixel's
    // half block wasn't loaded in time, led[4] toggles at every frame shown.
    led: u5,
    sdram: SdramPins,
}

impl Gpu {
    #[clock(domain = core, period = 1)]
    fn tick(self, sdram_dq: u16) -> (Gpu, Out) {
        let (timing, beam) = self.timing.step(cea_1280x720(), 1);

        // The display finishes a half-block row after the last active pixel
        // of every eighth screen line, and the frame after its last line.
        // The ring restarts there, so a frame's loads start at slot 0.
        let row_end = beam.x == H_ACTIVE & beam.y[2:0] == 7 & beam.y <= V_LAST;
        let frame_end = row_end & beam.y == V_LAST;
        let next_row = row_end & !frame_end;

        // SDRAM requests: the fill's writes, then half-block loads while
        // the ring has a free slot. Half block (bx, row) is the top
        // (row even) or bottom half of block (bx, row / 2).
        let in_use = (self.issued - self.freed) as u13 wrap;
        let reading = self.loading & self.issued != FRAME_SLOTS & in_use < RING;
        let load_addr = (self.load_rowbase + (0_u5 @ self.load_bx @ self.load_row[0:0] @ 0_u5)) as u18 wrap;
        // The triangle pipeline's outputs, from its registers.
        let pout = self.parser.out();
        let rout = self.raster.out(self.draw);
        let (setup, sout) = self.setup.step(pout.load, pout.start, rout.out_raddr);
        let kept = sout.done & sout.result == RESULT_KEPT;
        let free = !sout.busy & !sout.done & !rout.pending;
        let starting = match pout.start {
            Some(_) => 1_u1,
            None => 0_u1,
        };
        let ring_free = !sout.busy & !starting;
        // A clear waits for the last frame's triangles; an end of frame for
        // its last blocks, and for the display to take the frame before.
        let idle = !sout.busy & !sout.done & !rout.busy & !starting;
        let clear_ok = idle;
        let present_ok = idle & !self.ready_valid;
        let presenting = frame_end & self.ready_valid;
        let stalled = pout.ending & self.ready_valid;

        // The arbiter: a request, once chosen, is in front of the controller
        // from the next cycle until it is accepted. Requesters hold theirs
        // until they are accepted, so choosing a cycle early changes nothing
        // but when it is taken.
        let (raster_wants, raster_req) = match rout.req {
            Some(r) => (1_u1, r),
            None => (0_u1, SdramReq { write: 1, addr: 0, len: 0 }),
        };
        let choice: u2 = if self.filling == 1 {
            OWNER_FILL
        } else if reading == 1 {
            OWNER_SCAN
        } else if raster_wants == 1 {
            OWNER_RASTER
        } else {
            OWNER_NONE
        };
        let chosen_req = if choice == OWNER_FILL {
            SdramReq { write: 1, addr: 0_u6 @ self.fill_addr, len: RUN }
        } else if choice == OWNER_SCAN {
            SdramReq { write: 0, addr: self.disp @ 0_u4 @ load_addr, len: RUN }
        } else {
            raster_req
        };
        let req: Option<SdramReq> = if self.granted != OWNER_NONE { Some(self.granted_req) } else { None };
        let x = self.fill_bx @ self.fill_px;
        let y = 0_u1 @ self.fill_by @ self.fill_py;
        let fill_run = self.data_owner == OWNER_FILL;
        let wdata = if fill_run { pattern(x, y) } else { rout.wdata };
        let wmask: u1 = if fill_run { 0 } else { rout.wmask };
        let (sdram, mem) = self.sdram.step(req, wdata, wmask, sdram_dq);
        // `accepted` is for the request granted last cycle; `wtake` for the
        // run accepted before it.
        let accepted_fill = mem.accepted & self.granted == OWNER_FILL;
        let accepted_scan = mem.accepted & self.granted == OWNER_SCAN;
        let accepted_raster = mem.accepted & self.granted == OWNER_RASTER;
        let wtake_fill = mem.wtake & self.data_owner == OWNER_FILL;
        let wtake_raster = mem.wtake & self.data_owner == OWNER_RASTER;
        let no_word: Option<u16> = None;
        let (rdata_scan, rdata_raster) = if self.data_owner == OWNER_RASTER {
            (no_word, mem.rdata)
        } else {
            (mem.rdata, no_word)
        };

        // The fill, in word order: px, then py, then bx, then by.
        let last_run = accepted_fill & self.fill_addr == LAST_RUN;
        let fill_addr = if accepted_fill { (self.fill_addr + RUN) as u18 wrap } else { self.fill_addr };
        let next_py = wtake_fill & self.fill_px == 7;
        let next_bx = next_py & self.fill_py == 7;
        let next_by = next_bx & self.fill_bx == LAST_BX;
        let fill_bx: u7 = if next_by { 0 } else if next_bx { (self.fill_bx + 1) as u7 wrap } else { self.fill_bx };

        // The loads: the next request after each one is taken.
        let took = accepted_scan;
        let row_done = took & self.load_bx == LAST_BX;
        let load_bx: u7 = if row_done { 0 } else if took { (self.load_bx + 1) as u7 wrap } else { self.load_bx };
        let load_rowbase = if row_done & self.load_row[0:0] == 1 {
            (self.load_rowbase + BLOCK_ROW) as u18 wrap
        } else {
            self.load_rowbase
        };

        // Words arriving go to the ring in order, a slot per 32.
        let (got, word) = match rdata_scan {
            Some(w) => (1_u1, w),
            None => (0_u1, 0_u16),
        };
        let slot_done = got & self.recv_word == 31;
        let recv_slot: u8 = if !slot_done {
            self.recv_slot
        } else if self.recv_slot == LAST_SLOT {
            0
        } else {
            (self.recv_slot + 1) as u8 wrap
        };

        // The display: framebuffer pixel (x / 2, y / 2) for screen pixel
        // (x, y), in half block x / 16 of the row being shown.
        let slot_sum = (0_u1 @ self.show_slot) + (0_u2 @ beam.x[10:4]);
        let slot: u8 = if slot_sum >= 192 { (slot_sum - 192) as u8 wrap } else { slot_sum as u8 wrap };
        let ring_word = if self.ring_hi_1 == 1 { self.ring_hi.value() } else { self.ring_lo.value() };
        let row_ready = self.received >= (self.freed + ROW_SLOTS) as u13 wrap;
        let show = self.loading & beam.de;
        let next_show_sum = (0_u1 @ self.show_slot) + 80;
        let next_show: u8 = if next_show_sum >= 192 { (next_show_sum - 192) as u8 wrap } else { next_show_sum as u8 wrap };
        let rgb: u16 = if self.show_1 == 0 { 0 } else if self.missing_1 == 1 { 0xF800 } else { ring_word };
        // DVI carries HSYNC and VSYNC as C0 and C1 of the blue channel.
        let sync = self.vsync_1 @ self.hsync_1;
        let (enc_blue, blue) = self.enc_blue.step(rgb[4:0] @ rgb[4:2], sync, self.de_1, 1);
        let (enc_green, green) = self.enc_green.step(rgb[10:5] @ rgb[10:9], 0, self.de_1, 1);
        let (enc_red, red) = self.enc_red.step(rgb[15:11] @ rgb[15:13], 0, self.de_1, 1);

        (
            Gpu {
                count: (self.count + 1) as u27 wrap,
                sdram: sdram,
                granted: if mem.accepted == 1 {
                    OWNER_NONE
                } else if self.granted != OWNER_NONE {
                    self.granted
                } else {
                    choice
                },
                granted_req: if self.granted == OWNER_NONE { chosen_req } else { self.granted_req },
                data_owner: if mem.accepted == 1 { self.granted } else { self.data_owner },
                parser: self.parser.next(!self.filling, free, ring_free, clear_ok, present_ok),
                setup: setup,
                raster: self.raster.next(kept, sout.rdata, pout.clear, accepted_raster, wtake_raster, rdata_raster),
                // A finished frame becomes the one waiting, and the spare
                // the one drawn; at a frame start the one waiting is shown,
                // and the one shown becomes the spare.
                disp: if presenting { self.third } else { self.disp },
                draw: if pout.frame_done == 1 { self.third } else { self.draw },
                third: if pout.frame_done == 1 {
                    self.draw
                } else if presenting {
                    self.disp
                } else {
                    self.third
                },
                ready_valid: if pout.frame_done == 1 { 1 } else if presenting { 0 } else { self.ready_valid },
                frame_led: self.frame_led ^ presenting,
                render_count: if pout.frame_done == 1 {
                    0
                } else if self.filling == 1 | stalled {
                    self.render_count
                } else {
                    (self.render_count + 1) as u24 wrap
                },
                debug_frames: if presenting { (self.debug_frames + 1) as u16 wrap } else { self.debug_frames },
                debug_render_cycles: if pout.frame_done == 1 { self.render_count } else { self.debug_render_cycles },
                filling: self.filling & !last_run,
                fill_addr: fill_addr,
                fill_px: if wtake_fill { (self.fill_px + 1) as u3 wrap } else { self.fill_px },
                fill_py: if next_py { (self.fill_py + 1) as u3 wrap } else { self.fill_py },
                fill_bx: fill_bx,
                fill_by: if next_by { (self.fill_by + 1) as u6 wrap } else { self.fill_by },
                loading: if frame_end { !self.filling } else { self.loading },
                issued: if frame_end { 0 } else if took { (self.issued + 1) as u13 wrap } else { self.issued },
                load_bx: if frame_end { 0 } else { load_bx },
                load_row: if frame_end { 0 } else if row_done { (self.load_row + 1) as u7 wrap } else { self.load_row },
                load_rowbase: if frame_end { 0 } else { load_rowbase },
                received: if frame_end { 0 } else if slot_done { (self.received + 1) as u13 wrap } else { self.received },
                recv_word: if frame_end { 0 } else if got { (self.recv_word + 1) as u5 wrap } else { self.recv_word },
                recv_slot: if frame_end { 0 } else { recv_slot },
                freed: if frame_end { 0 } else if next_row { (self.freed + ROW_SLOTS) as u13 wrap } else { self.freed },
                show_slot: if frame_end { 0 } else if next_row { next_show } else { self.show_slot },
                ring_lo: self.ring_lo.next(
                    slot[6:0] @ beam.y[2:1] @ beam.x[3:1],
                    got & self.loading & self.recv_slot[7:7] == 0,
                    self.recv_slot[6:0] @ self.recv_word,
                    word,
                ),
                ring_hi: self.ring_hi.next(
                    slot[5:0] @ beam.y[2:1] @ beam.x[3:1],
                    got & self.loading & self.recv_slot[7:7] == 1,
                    self.recv_slot[5:0] @ self.recv_word,
                    word,
                ),
                ring_hi_1: slot[7:7],
                timing: timing,
                underflow: self.underflow | (show & !row_ready),
                de_1: beam.de,
                hsync_1: beam.hsync,
                vsync_1: beam.vsync,
                show_1: show,
                missing_1: !row_ready,
                enc_blue: enc_blue,
                enc_green: enc_green,
                enc_red: enc_red,
                tmds_blue: blue.symbol,
                tmds_green: green.symbol,
                tmds_red: red.symbol,
            },
            Out {
                led: self.frame_led @ self.underflow @ !self.filling @ mem.ready @ self.count[26:26],
                sdram: mem.pins,
            },
        )
    }
}

// The test pattern, RGB565: a white one-pixel border round the frame; inside
// it red rising left to right, green top to bottom, and blue on alternate
// 32x32 squares.
fn pattern(x: u10, y: u10) -> u16 {
    let border = x == 0 | x == FB_LAST_X | y == 0 | y == FB_LAST_Y;
    let blue: u5 = if (x[5:5] ^ y[5:5]) == 1 { 31 } else { 0 };
    if border { 0xFFFF } else { x[9:5] @ y[8:3] @ blue }
}
