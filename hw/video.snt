// Video timing and DVI (TMDS) encoding.

// One video mode's timing. Horizontal values are in pixels, vertical in
// lines, both counted from 0 at the first active pixel/line. A sync pulse
// covers [sync_start, sync_end).
pub struct Timing {
    pub h_active: u10,
    pub h_sync_start: u10,
    pub h_sync_end: u10,
    pub h_total: u10,
    pub v_active: u10,
    pub v_sync_start: u10,
    pub v_sync_end: u10,
    pub v_total: u10,
}

// 640x480 at 60 Hz: 800x525 total, both syncs active low. Run from a
// 25 MHz pixel clock (the standard is 25.175 MHz; monitors accept both).
pub fn vga_640x480() -> Timing {
    Timing {
        h_active: 640,
        h_sync_start: 656,
        h_sync_end: 752,
        h_total: 800,
        v_active: 480,
        v_sync_start: 490,
        v_sync_end: 492,
        v_total: 525,
    }
}

// The beam position and the sync and blanking signals for one pixel clock.
pub struct Beam {
    // Pixel column, 0 at the first active pixel.
    pub x: u10,
    // Line, 0 at the first active line.
    pub y: u10,
    // Display enable: high while (x, y) is in the active picture.
    pub de: u1,
    // Horizontal sync, active low.
    pub hsync_n: u1,
    // Vertical sync, active low.
    pub vsync_n: u1,
}

// Raster timing generator: walks the beam over the frame, one pixel per
// cycle with `en` high, and decodes blanking and sync from its position.
#[module]
pub struct VideoTiming {
    x: u10 = 0,
    y: u10 = 0,
}

impl VideoTiming {
    pub fn step(self, t: Timing, en: u1) -> (Self, Beam) {
        let line_end = self.x == (t.h_total - 1) as u10 wrap;
        let frame_end = self.y == (t.v_total - 1) as u10 wrap;
        let next_y: u10 = if frame_end { 0 } else { (self.y + 1) as u10 wrap };
        let in_hsync = self.x >= t.h_sync_start & self.x < t.h_sync_end;
        let in_vsync = self.y >= t.v_sync_start & self.y < t.v_sync_end;
        let next = Self {
            x: if line_end { 0 } else { (self.x + 1) as u10 wrap },
            y: if line_end { next_y } else { self.y },
        };
        (
            if en == 1 { next } else { self },
            Beam {
                x: self.x,
                y: self.y,
                de: self.x < t.h_active & self.y < t.v_active,
                hsync_n: !in_hsync,
                vsync_n: !in_vsync,
            },
        )
    }
}

// One TMDS channel's 10-bit symbol.
pub struct TmdsOut {
    pub symbol: u10,
}

// TMDS encoder for one DVI channel (DVI 1.0, section 3.2.2): 8b/10b with
// transition minimisation and DC balance while `de` is high, and one of
// four control tokens, selected by `ctrl`, while it is low. Symbols are sent
// least significant bit first.
//
// It takes a pixel in each cycle with `en` high, at most one every four
// cycles, and pipelines the encoding over those four so that each stage has
// a whole core clock cycle: the pixel is registered, then transition
// minimised, then its ones counted, then DC balanced against the running
// disparity. `symbol` comes from a register: four cycles after a pixel is
// taken it changes to that pixel's symbol, and holds until the next.
#[module]
pub struct TmdsEncoder {
    // Stage 1: the pixel, registered when `en` is high.
    data1: u8 = 0,
    ctrl1: u2 = 0,
    de1: u1 = 0,
    valid1: u1 = 0,
    // Stage 2: the transition-minimised byte, q_m[7:0], and q_m[8], which
    // says whether the chain used XOR (1) or XNOR (0).
    q_m2: u8 = 0,
    q_m8_2: u1 = 0,
    ctrl2: u2 = 0,
    de2: u1 = 0,
    valid2: u1 = 0,
    // Stage 3: q_m with the number of ones in q_m[7:0].
    q_m3: u8 = 0,
    q_m8_3: u1 = 0,
    ones3: u4 = 0,
    ctrl3: u2 = 0,
    de3: u1 = 0,
    valid3: u1 = 0,
    // Stage 4: running disparity, ones minus zeros sent since the last
    // blanking period, and the symbol.
    disparity: i5 = 0,
    symbol: u10 = 0,
}

impl TmdsEncoder {
    pub fn step(self, data: u8, ctrl: u2, de: u1, en: u1) -> (Self, TmdsOut) {
        // Stage 2: transition minimisation.
        let ones_d = popcount8(self.data1);
        let use_xnor = ones_d > 4 | (ones_d == 4 & self.data1[0:0] == 0);
        let chain = prefix_xor(self.data1);
        // An XNOR chain is the XOR chain with every odd bit inverted.
        let q_m = if use_xnor { chain ^ 0xAA } else { chain };
        let q_m8: u1 = if use_xnor { 0 } else { 1 };

        // Stage 4: DC balance. diff is ones minus zeros in q_m[7:0].
        let ones = self.ones3;
        let diff = ((ones as i8 wrap) + (ones as i8 wrap) - 8) as i8 wrap;
        let cnt = self.disparity as i8 wrap;
        let two_q_m8: i8 = if self.q_m8_3 == 1 { 2 } else { 0 };
        let two_not_q_m8: i8 = if self.q_m8_3 == 1 { 0 } else { 2 };
        let balanced = cnt == 0 | ones == 4;
        let invert = (cnt > 0 & ones > 4) | (cnt < 0 & ones < 4);
        let (symbol, next_cnt) = if balanced {
            (
                !self.q_m8_3 @ self.q_m8_3 @ (if self.q_m8_3 == 1 { self.q_m3 } else { ~self.q_m3 }),
                if self.q_m8_3 == 1 { (cnt + diff) as i5 wrap } else { (cnt - diff) as i5 wrap },
            )
        } else if invert {
            (1_u1 @ self.q_m8_3 @ ~self.q_m3, ((cnt + two_q_m8) - diff) as i5 wrap)
        } else {
            (0_u1 @ self.q_m8_3 @ self.q_m3, ((cnt - two_not_q_m8) + diff) as i5 wrap)
        };
        let disparity: i5 = if self.valid3 == 0 { self.disparity } else if self.de3 == 1 { next_cnt } else { 0 };
        let out: u10 = if self.valid3 == 0 {
            self.symbol
        } else if self.de3 == 1 {
            symbol
        } else {
            control_token(self.ctrl3)
        };

        (
            Self {
                data1: if en == 1 { data } else { self.data1 },
                ctrl1: if en == 1 { ctrl } else { self.ctrl1 },
                de1: if en == 1 { de } else { self.de1 },
                valid1: en,
                q_m2: q_m,
                q_m8_2: q_m8,
                ctrl2: self.ctrl1,
                de2: self.de1,
                valid2: self.valid1,
                q_m3: self.q_m2,
                q_m8_3: self.q_m8_2,
                ones3: popcount8(self.q_m2),
                ctrl3: self.ctrl2,
                de3: self.de2,
                valid3: self.valid2,
                disparity: disparity,
                symbol: out,
            },
            TmdsOut { symbol: self.symbol },
        )
    }
}

// The control token for (C1, C0) during blanking.
fn control_token(ctrl: u2) -> u10 {
    match ctrl {
        0 => 0b1101010100,
        1 => 0b0010101011,
        2 => 0b0101010100,
        _ => 0b1010101011,
    }
}

// The number of set bits in a byte.
fn popcount8(x: u8) -> u4 {
    let a = x[0:0] + x[1:1];
    let b = x[2:2] + x[3:3];
    let c = x[4:4] + x[5:5];
    let d = x[6:6] + x[7:7];
    (a + b) + (c + d)
}

// Bit i of the result is the XOR of bits 0 to i of x.
fn prefix_xor(x: u8) -> u8 {
    let p1 = x ^ (x[6:0] @ 0_u1);
    let p2 = p1 ^ (p1[5:0] @ 0_u2);
    p2 ^ (p2[3:0] @ 0_u4)
}
