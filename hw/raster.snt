// The front and back of the triangle pipeline around the setup engine
// (docs/design/triangle-pipeline.md §6, docs/design/host-interface.md):
//
//   Parser  takes register transactions (ADR 0008) from the built-in scene
//           ROM, or from the host link's FIFO while a host is connected:
//           latches ATTR0 and RENDER_MODE, writes each vertex into the setup
//           engine's ring and starts the triangles its kicks make,
//           carries out FRAME's present and clears, and reads and writes
//           GPU memory for MEM_DATA, four words at a time, once the
//           pipeline is idle. The ROM scene loops.
//   Raster  clears a frame (colour, depth or both), or copies a set-up
//           triangle out of the engine's output buffer and walks its bounding
//           box in 8x8 blocks: it reads a block's depths, steps the edge
//           functions and the colour, depth and texture planes one pixel per
//           clock into tile buffers, depth-tests each pixel, and for a
//           textured triangle works out each pixel's texel address (a
//           pipelined divide by Q); then, textured, it looks each drawn
//           pixel's texel up in the texture cache (fetching a missing 4x4
//           block from SDRAM) and multiplies it by the shade; and writes the
//           block's colours and depths back, each half block with a drawn
//           pixel as one masked 32-word SDRAM run, as the triangle's render
//           mode allows. Three stages work on three blocks at once (docs/
//           design/draw-speed.md §3.3): the front half (depth read, pixels,
//           texel addresses), the back half (texels, combiner, alpha test)
//           and the writer, with banked tile buffers between them.
//
// The golden model is models/setup's reference renderer (render.rs) on what
// scene.rs's `interpret` makes of the same transactions; the frame tests
// compare the framebuffer with it pixel for pixel.
//
// Both are plain structs inlined into the GPU, not #[module]s: each has
// `out`, its outputs from its registers alone, and `next`, its next state
// from its inputs. The GPU needs their outputs before it can step the
// setup engine and the SDRAM controller, whose outputs are their inputs.

use root::sdram::SdramReq;
use root::setup::Start;
use root::setup::VertexWrite;

// Register addresses (docs/design/host-interface.md §3).
const REG_ATTR0: u8 = 0x00;
const REG_VERTEX_NOKICK: u8 = 0x06;
const REG_VERTEX_KICK_FAN: u8 = 0x09;
const REG_TEX0_CFG: u8 = 0x10;
const REG_CC_MODE: u8 = 0x18;
const REG_CONST0: u8 = 0x19;
const REG_CONST1: u8 = 0x1B;
const REG_RENDER_MODE: u8 = 0x30;
const REG_FRAME: u8 = 0x40;
const REG_MEM_ADDR: u8 = 0x70;
const REG_MEM_DATA: u8 = 0x71;
const REG_SCRATCH: u8 = 0x7D;

// The scene ROM's end marker (models/setup/src/scene.rs): start again.
const ROM_END: u8 = 0xFF;

// Kicks, as a vertex register's address less VERTEX_NOKICK's.
const KICK_NONE: u2 = 0;
const KICK_012: u2 = 1;
const KICK_021: u2 = 2;

// RENDER_MODE's reset value: depth tested and written, colour written.
const MODE_RESET: u27 = 0x1C;

// CC_MODE's reset value, texture x shade; and the constants', opaque white.
const CC_RESET: u32 = 0x73717371;
const CONST_RESET: u32 = 0xFFFFFFFF;

// Parser states.
const P_FETCH: u4 = 0;
const P_DECODE: u4 = 1;
const P_EXEC: u4 = 2;
const P_WRITE: u4 = 3;
const P_START: u4 = 4;
const P_PRESENT: u4 = 5;
const P_CLEAR: u4 = 6;
const P_READ: u4 = 7;
const P_MEM: u4 = 8;
// TEX0_CFG, CC_MODE, CONST0 or CONST1: waiting for the pipeline to be idle.
const P_STATE: u4 = 9;

// A MEM_DATA access, in P_MEM: waiting for the pipeline to be idle, its run
// waiting to be accepted, then its four words moving.
const M_WAIT: u2 = 0;
const M_REQ: u2 = 1;
const M_MOVE: u2 = 2;

// Words in a MEM_DATA access: 64 bits.
const MEM_WORDS: u6 = 4;

// Raster states: the front half of the fragment pipeline (and the clear,
// the copy and the flush).
const R_IDLE: u4 = 0;
const R_COPY: u4 = 1;
const R_INIT: u4 = 2;
const R_TEST: u4 = 3;
const R_PIXELS: u4 = 4;
// HANDOFF: the front half is done with a block; it goes to the back half
// once the back half is free (or nowhere, if no pixel of it is drawn).
const R_HANDOFF: u4 = 5;
const R_NEXT: u4 = 6;
const R_DECIDE: u4 = 7;
const R_ZREAD: u4 = 8;
const R_CLEAR: u4 = 9;
const R_DRAIN: u4 = 10;
// (11 was TEXEL, now the back half's.)
const R_FLUSH: u4 = 12;

// The back half's states: free; TEXEL, its block's texels looked up,
// filtered, combined and alpha tested; HANDOFF, the block goes to the
// writer once the writer is free.
const B_FREE: u2 = 0;
const B_TEXEL: u2 = 1;
const B_HANDOFF: u2 = 2;

// DRAIN: cycles after a block's last pixel until its depth test is done,
// and until its texel address is (the texture pipeline's depth).
const DRAIN_PLAIN: u4 = 0;
const DRAIN_TEXTURED: u4 = 12;

// The largest reciprocal of Q, so that it fits 17 bits.
const R_MAX: u17 = 0x1FFFF;

// A texel coordinate's range: 20 bits, signed (4 fraction bits).
const COORD_MIN: i50 = -524288;
const COORD_MAX: i50 = 524287;

// How the edge and plane registers move this cycle.
const M_INIT: u3 = 0;
const M_BLOCK: u3 = 1;
const M_PIXEL: u3 = 2;
const M_ROW: u3 = 3;
const M_NEXT_COL: u3 = 4;
const M_NEXT_ROW: u3 = 5;
const M_HOLD: u3 = 6;

// Output buffer slots copied, in order (see copy_slot).
const COPY_SLOTS: u6 = 37;

// The depth buffer's SDRAM bank (ADR 0003), and what a clear sets it to.
const DEPTH_BANK: u2 = 3;
const FAR: u16 = 0xFFFF;

// The blocks of a buffer: 80 x 45.
const BLOCKS: u12 = 3600;

// A clear of the frame being drawn: its colour, and which buffers.
pub struct ClearCmd {
    pub colour: u16 = 0,
    pub colour_en: u1 = 0,
    pub depth_en: u1 = 0,
}

pub struct ParserOut {
    pub load: Option<VertexWrite>,
    pub start: Option<Start>,
    pub clear: Option<ClearCmd>,
    // The frame being drawn is done: hand it to the display.
    pub frame_done: u1,
    // Waiting to present.
    pub ending: u1,
    // Taking the head of the host link's FIFO.
    pub pop: u1,
    // A read of this register, waiting for the link to take its value.
    pub read: Option<u7>,
    // RENDER_MODE (bits 26:0): its write enables, depth test and alpha
    // test go with each triangle started, and a read returns it.
    pub mode: u27,
    // MEM_DATA's run, held until accepted, and the word to write, taken on
    // `wtake`; MEM_ADDR, and the last 64 bits MEM_DATA read.
    pub mem_req: Option<SdramReq>,
    pub mem_wdata: u16,
    pub mem_addr: u22,
    pub mem_rdata: u64,
    // TEX0_CFG, which changes only with the pipeline idle; and a pulse:
    // the texture cache must be emptied before the next triangle (memory
    // has been written).
    pub tex: u64,
    pub flush: u1,
    // CC_MODE's pass 0, CONST0 and CONST1, which like TEX0_CFG change only
    // with the pipeline idle.
    pub cc: u32,
    pub const0: u32,
    pub const1: u32,
    // SCRATCH: whatever the host last wrote, for it to read back.
    pub scratch: u64,
}

pub struct Parser {
    state: u4 = 0,
    // Taking transactions from the host link (else the ROM), and the next
    // ROM entry.
    from_host: u1 = 0,
    pc: u11 = 0,
    // The transaction being carried out.
    #[no_reset]
    t_addr: u8 = 0,
    #[no_reset]
    t_data: u64 = 0,
    // The latched registers.
    attr: u64 = 0,
    mode: u27 = 0x1C,
    cc: u32 = 0x73717371,
    const0: u32 = 0xFFFFFFFF,
    const1: u32 = 0xFFFFFFFF,
    // The primitive: whether the last vertex was a kick (as after reset),
    // its vertices so far (to 3), whether it is a fan (its third vertex
    // was a KICK_FAN), and this vertex's kick.
    kicked: u1 = 1,
    count: u2 = 0,
    fan: u1 = 0,
    kick: u2 = 0,
    // The ring slots of the vertex two back, one back, and this one.
    s0: u2 = 0,
    s1: u2 = 0,
    s2: u2 = 3,
    // The vertex field being written (0 to 9).
    field: u4 = 0,
    // GPU memory: MEM_ADDR (in 64-bit units), a MEM_DATA access's step and
    // its words moved so far, and the 64 bits read (the first word in bits
    // 15:0).
    mem_addr: u22 = 0,
    mem_step: u2 = 0,
    mem_i: u2 = 0,
    #[no_reset]
    mem_rdata: u64 = 0,
    tex: u64 = 0,
    flush: u1 = 0,
    // SCRATCH: no effect; a link reset leaves it.
    scratch: u64 = 0,
    // The registered outputs.
    load_valid: u1 = 0,
    start_valid: u1 = 0,
    clear_valid: u1 = 0,
    frame_done: u1 = 0,
    #[no_reset]
    load: VertexWrite,
    #[no_reset]
    start: Start,
    #[no_reset]
    clear: ClearCmd,
    // The scene (generated: build/gen/scene_*.hex): each transaction's
    // address byte and data.
    #[storage(bram)]
    #[no_reset]
    rom_addr: rom<u8, 2048> = include_hex!("../build/gen/scene_addr.hex"),
    #[storage(bram)]
    #[no_reset]
    rom_data: rom<u64, 2048> = include_hex!("../build/gen/scene_data.hex"),
}

impl Parser {
    // The outputs, from the registers.
    pub fn out(self) -> ParserOut {
        ParserOut {
            load: if self.load_valid == 1 { Some(self.load) } else { None },
            start: if self.start_valid == 1 { Some(self.start) } else { None },
            clear: if self.clear_valid == 1 { Some(self.clear) } else { None },
            frame_done: self.frame_done,
            ending: (self.state == P_PRESENT),
            pop: (self.state == P_DECODE & self.from_host == 1),
            read: if self.state == P_READ { Some(self.t_addr[6:0]) } else { None },
            mode: self.mode,
            mem_req: if self.state == P_MEM & self.mem_step == M_REQ {
                Some(SdramReq { write: !self.t_addr[7:7], addr: self.mem_addr @ 0_u2, len: 0_u1 @ MEM_WORDS })
            } else {
                None
            },
            mem_wdata: if self.mem_i == 0 {
                self.t_data[15:0]
            } else if self.mem_i == 1 {
                self.t_data[31:16]
            } else if self.mem_i == 2 {
                self.t_data[47:32]
            } else {
                self.t_data[63:48]
            },
            mem_addr: self.mem_addr,
            mem_rdata: self.mem_rdata,
            tex: self.tex,
            flush: self.flush,
            cc: self.cc,
            const0: self.const0,
            const1: self.const1,
            scratch: self.scratch,
        }
    }

    // `enable`: parse (after the framebuffer fill). `free`: the setup
    // engine can take a triangle: idle, and its last outputs copied.
    // `ring_free`: no triangle is using the vertex ring. `clear_ok`: the
    // pipeline is idle. `present_ok`: idle, and the display can take a
    // frame. `link`: the host link's outputs: its FIFO's head, whether a
    // host is connected, and whether it can take a read's reply. `mem_*`:
    // the SDRAM's answers to MEM_DATA's run: accepted, a word taken, a word
    // read.
    pub fn next(
        self,
        enable: u1,
        free: u1,
        ring_free: u1,
        clear_ok: u1,
        present_ok: u1,
        link_enabled: u1,
        head_avail: u1,
        head_addr: u8,
        head_data: u64,
        reply_busy: u1,
        mem_accepted: u1,
        mem_wtake: u1,
        mem_word: Option<u16>,
    ) -> Self {
        let st = self.state;

        // ---- FETCH: the next transaction's source. A host that has gone
        // hands back to the ROM, which starts again from its beginning. --
        let host_gone = st == P_FETCH & self.from_host == 1 & link_enabled == 0;
        let fetching = st == P_FETCH & enable == 1 & !host_gone & (self.from_host == 0 | head_avail == 1);

        // ---- DECODE: the ROM's word, or the FIFO's head, into registers.
        // Nothing is decided from it until EXEC: a block RAM's output is
        // too slow to choose the ROM's next address in the same cycle. ----
        let addr: u8 = if self.from_host == 1 { head_addr } else { self.rom_addr.value() };
        let data: u64 = if self.from_host == 1 { head_data } else { self.rom_data.value() };
        let rom_end = st == P_EXEC & self.from_host == 0 & self.t_addr == ROM_END;

        // ---- EXEC. ------------------------------------------------------
        let a = self.t_addr;
        let is_vertex = a >= REG_VERTEX_NOKICK & a <= REG_VERTEX_KICK_FAN;
        // 0x06 to 0x09 end in 2, 3, 0, 1.
        let kick: u2 = (a[1:0] + 2) as u2 wrap;
        let new_prim = kick == KICK_NONE & self.kicked == 1;
        // A new primitive starts again from slot 0, which the last triangle
        // may still be using: wait for the ring.
        let vertex_go = st == P_EXEC & is_vertex & (!new_prim | ring_free == 1);
        let count: u2 = if new_prim { 1 } else if self.count == 3 { 3 } else { (self.count + 1) as u2 wrap };
        // A vertex's slot is one no triangle still needs: a strip cycles
        // through 0 to 3; a fan keeps 0 for its first vertex and cycles
        // the rest through 1 to 3.
        let new_slot: u2 = if new_prim {
            0
        } else if self.fan == 1 & self.s2 == 3 {
            1
        } else {
            (self.s2 + 1) as u2 wrap
        };
        let present = self.t_data[0:0];
        let clears = self.t_data[2:1] != 0;
        let is_frame = a == REG_FRAME;

        // ---- WRITE: the vertex's ten fields, one a cycle: position and
        // Z and Q from the register, colour and S'T' from ATTR0. ----------
        let d = self.t_data;
        let attr = self.attr;
        let f = self.field;
        let value: u36 = if f == 0 {
            sext16(d[63:48])
        } else if f == 1 {
            sext16(d[47:32])
        } else if f == 2 {
            0_u28 @ attr[63:56]
        } else if f == 3 {
            0_u28 @ attr[55:48]
        } else if f == 4 {
            0_u28 @ attr[47:40]
        } else if f == 5 {
            0_u28 @ attr[39:32]
        } else if f == 6 {
            0_u20 @ d[31:16]
        } else if f == 7 {
            sext16(attr[31:16])
        } else if f == 8 {
            sext16(attr[15:0])
        } else {
            0_u20 @ d[15:0]
        };
        let last_field = st == P_WRITE & f == 9;
        let draws = self.kick != KICK_NONE & self.count == 3;

        // ---- START: the triangle's roles by its kick; its cull mode and
        // program from RENDER_MODE. ----------------------------------------
        let starting = st == P_START & free == 1;
        let roles: u6 = if self.kick == KICK_012 {
            self.s0 @ self.s1 @ self.s2
        } else if self.kick == KICK_021 {
            self.s0 @ self.s2 @ self.s1
        } else {
            0_u2 @ self.s1 @ self.s2
        };
        let cull: u2 = if self.mode[6:5] == 3 { 0 } else { self.mode[6:5] };

        let presenting = st == P_PRESENT & present_ok == 1;
        let latching = st == P_STATE & clear_ok == 1;
        let clearing = st == P_CLEAR & clear_ok == 1;
        let replied = st == P_READ & (reply_busy == 0 | link_enabled == 0);

        // ---- MEM: MEM_DATA, written (from either source) or read (from a
        // host), once everything before it is drawn. ----------------------
        let is_mem_data = (0_u1 @ a[6:0]) == REG_MEM_DATA;
        let mem_read = a[7:7] == 1;
        let in_mem = st == P_MEM;
        let (got_word, word) = match mem_word {
            Some(w) => (1_u1, w),
            None => (0_u1, 0_u16),
        };
        let moved = in_mem & self.mem_step == M_MOVE & ((!mem_read & mem_wtake == 1) | (mem_read & got_word == 1));
        let mem_done = moved & self.mem_i == 3;

        let state: u4 = if st == P_FETCH {
            if fetching { P_DECODE } else { P_FETCH }
        } else if st == P_DECODE {
            P_EXEC
        } else if st == P_EXEC {
            if rom_end {
                P_FETCH
            } else if is_mem_data & (a[7:7] == 0 | self.from_host == 1) {
                P_MEM
            } else if a == REG_TEX0_CFG | a == REG_CC_MODE | a == REG_CONST0 | a == REG_CONST1 {
                P_STATE
            } else if a[7:7] == 1 {
                if self.from_host == 1 { P_READ } else { P_FETCH }
            } else if is_vertex {
                if vertex_go { P_WRITE } else { P_EXEC }
            } else if is_frame & present == 1 {
                P_PRESENT
            } else if is_frame & clears {
                P_CLEAR
            } else {
                P_FETCH
            }
        } else if st == P_WRITE {
            if !last_field { P_WRITE } else if draws { P_START } else { P_FETCH }
        } else if st == P_START {
            if starting { P_FETCH } else { P_START }
        } else if st == P_PRESENT {
            if !presenting { P_PRESENT } else if clears { P_CLEAR } else { P_FETCH }
        } else if st == P_CLEAR {
            if clearing { P_FETCH } else { P_CLEAR }
        } else if in_mem {
            if !mem_done { P_MEM } else if mem_read { P_READ } else { P_FETCH }
        } else if st == P_STATE {
            if clear_ok == 1 { P_FETCH } else { P_STATE }
        } else if replied {
            P_FETCH
        } else {
            P_READ
        };
        let exec_plain = st == P_EXEC & a[7:7] == 0;
        let next_pc: u11 = if host_gone | rom_end {
            0
        } else if st == P_DECODE & self.from_host == 0 {
            (self.pc + 1) as u11 wrap
        } else {
            self.pc
        };

        Self {
            state: state,
            // The ROM hands over to a host only at a present, so a frame is
            // never half from each.
            from_host: if host_gone {
                0
            } else if presenting & self.from_host == 0 & link_enabled == 1 {
                1
            } else {
                self.from_host
            },
            pc: next_pc,
            t_addr: if st == P_DECODE { addr } else { self.t_addr },
            t_data: if st == P_DECODE { data } else { self.t_data },
            attr: if exec_plain & a == REG_ATTR0 { self.t_data } else { self.attr },
            mode: if host_gone {
                MODE_RESET
            } else if exec_plain & a == REG_RENDER_MODE {
                self.t_data[26:0]
            } else {
                self.mode
            },
            kicked: if host_gone { 1 } else if vertex_go { (kick != KICK_NONE) } else { self.kicked },
            count: if host_gone { 0 } else if vertex_go { count } else { self.count },
            fan: if host_gone {
                0
            } else if vertex_go & new_prim {
                0
            } else if vertex_go & self.count == 2 {
                (a == REG_VERTEX_KICK_FAN)
            } else {
                self.fan
            },
            kick: if vertex_go { kick } else { self.kick },
            s0: if vertex_go { self.s1 } else { self.s0 },
            s1: if vertex_go { self.s2 } else { self.s1 },
            s2: if vertex_go { new_slot } else { self.s2 },
            field: if st == P_WRITE { (self.field + 1) as u4 wrap } else { 0 },
            mem_addr: if host_gone {
                0
            } else if exec_plain & a == REG_MEM_ADDR {
                self.t_data[21:0]
            } else if mem_done {
                (self.mem_addr + 1) as u22 wrap
            } else {
                self.mem_addr
            },
            mem_step: if !in_mem {
                M_WAIT
            } else if self.mem_step == M_WAIT & clear_ok == 1 {
                M_REQ
            } else if self.mem_step == M_REQ & mem_accepted == 1 {
                M_MOVE
            } else {
                self.mem_step
            },
            mem_i: if !in_mem { 0 } else if moved { (self.mem_i + 1) as u2 wrap } else { self.mem_i },
            // TEX0_CFG, CC_MODE, CONST0 and CONST1 wait for the triangles
            // before them to be drawn.
            tex: if host_gone {
                0
            } else if latching & self.t_addr == REG_TEX0_CFG {
                self.t_data
            } else {
                self.tex
            },
            cc: if host_gone {
                CC_RESET
            } else if latching & self.t_addr == REG_CC_MODE {
                self.t_data[31:0]
            } else {
                self.cc
            },
            const0: if host_gone {
                CONST_RESET
            } else if latching & self.t_addr == REG_CONST0 {
                self.t_data[31:0]
            } else {
                self.const0
            },
            const1: if host_gone {
                CONST_RESET
            } else if latching & self.t_addr == REG_CONST1 {
                self.t_data[31:0]
            } else {
                self.const1
            },
            // A write of SCRATCH needs nothing to wait for.
            scratch: if st == P_EXEC & self.t_addr == REG_SCRATCH { self.t_data } else { self.scratch },
            // The cache's tags are whole addresses, so only new memory
            // contents make it stale, not a new texture.
            flush: host_gone | (mem_done & !mem_read),
            mem_rdata: if in_mem & mem_read & got_word == 1 { word @ self.mem_rdata[63:16] } else { self.mem_rdata },
            load_valid: (st == P_WRITE),
            start_valid: starting,
            clear_valid: clearing,
            frame_done: presenting,
            load: VertexWrite { slot: self.s2, field: f, value: value },
            start: Start { roles: roles, cull: cull, untextured: !self.tex[0:0] },
            clear: ClearCmd { colour: self.t_data[31:16], colour_en: self.t_data[1:1], depth_en: self.t_data[2:2] },
            rom_addr: self.rom_addr.next(next_pc),
            rom_data: self.rom_data.next(next_pc),
        }
    }
}

pub struct RasterOut {
    // The setup engine's output buffer slot to read.
    pub out_raddr: u6,
    // A kept triangle's outputs are waiting to be copied: the engine must
    // not start another.
    pub pending: u1,
    // Clearing, or copying or drawing a triangle.
    pub busy: u1,
    // A run, held until `accepted`.
    pub req: Option<SdramReq>,
    // The word, and whether to leave it as it was, taken on `wtake`.
    pub wdata: u16,
    pub wmask: u1,
    // Cleared flags (a bit per bank, `cflags`): of the block `scan_block`
    // named last cycle, for scan-out; and of the block `mem_block` named
    // last cycle, for a host's MEM_DATA read (while this unit is idle).
    pub scan_flags: u4,
    pub mem_flags: u4,
    // Each colour buffer's clear colour, bank 2 in bits 47:32.
    pub clear_colours: u48,
}

// One edge function: A and B (Q13.4 counts), whether a value of 0 is
// inside (a top or left edge), and its value (Q26.8 counts, widened) at
// the current pixel, the current pixel row's start, the current block's
// start, and the current block row's start.
struct EdgeState {
    a: i17 = 0,
    b: i17 = 0,
    tie: u1 = 0,
    // How far the edge's value can rise from a block's first pixel to its
    // other corners: 112 * max(A, 0) + 112 * max(B, 0).
    corner: i24 = 0,
    pix: i40 = 0,
    row: i40 = 0,
    blk: i40 = 0,
    blkrow: i40 = 0,
}

// One plane (a colour, or depth): d/dx and d/dy, and its value (36-bit
// iterator counts, wrapping) at the current pixel, pixel row, block and
// block row.
struct PlaneState {
    dx: i36 = 0,
    dy: i36 = 0,
    pix: i36 = 0,
    row: i36 = 0,
    blk: i36 = 0,
    blkrow: i36 = 0,
}

pub struct Raster {
    state: u4 = 0,
    pending: u1 = 0,
    // COPY: the slot being addressed.
    copy: u6 = 0,
    // The bounding box (Q12.4 counts), its first and last blocks, and the
    // current block.
    #[no_reset]
    xs: i16 = 0,
    #[no_reset]
    ys: i16 = 0,
    #[no_reset]
    xmax: i16 = 0,
    #[no_reset]
    ymax: i16 = 0,
    #[no_reset]
    bx0: i10 = 0,
    #[no_reset]
    bx1: i10 = 0,
    #[no_reset]
    by1: i10 = 0,
    #[no_reset]
    bx: i10 = 0,
    #[no_reset]
    by: i10 = 0,
    #[no_reset]
    e0: EdgeState,
    #[no_reset]
    e1: EdgeState,
    #[no_reset]
    e2: EdgeState,
    #[no_reset]
    pr: PlaneState,
    #[no_reset]
    pg: PlaneState,
    #[no_reset]
    pb: PlaneState,
    #[no_reset]
    pz: PlaneState,
    #[no_reset]
    ps: PlaneState,
    #[no_reset]
    pt: PlaneState,
    #[no_reset]
    pq: PlaneState,
    #[no_reset]
    pa: PlaneState,
    // PIXELS: the pixel (py @ px); WRITE and CLEAR: the word being sent.
    pix: u6 = 0,
    // The depth test, a cycle after PIXELS: the pixel, whether it is
    // covered, its depth and its shade (8 bits a channel).
    zt_valid: u1 = 0,
    #[no_reset]
    zt_pix: u6 = 0,
    #[no_reset]
    zt_cov: u1 = 0,
    #[no_reset]
    zt_z: u16 = 0,
    // The depth there, from the depth tile (read a pixel ahead, so that
    // the block RAM's slow output only reaches this register), or FAR for
    // a block whose depth is cleared.
    #[no_reset]
    zt_zbuf: u16 = 0,
    #[no_reset]
    zt_shade: u32 = 0,
    // DRAIN: cycles left.
    drain: u4 = 0,
    // TEX0_CFG decoded, a cycle behind it (it only changes while this unit
    // is idle): textured; bilinear; ARGB4444; log2 of the width and height (2 to 10)
    // and each as a mask; the width's log2 less 2 (blocks across); the
    // wrap modes; the base address over 16.
    tc_textured: u1 = 0,
    tc_bilinear: u1 = 0,
    tc_argb: u1 = 0,
    tc_lw: u4 = 2,
    tc_lh: u4 = 2,
    tc_wmask: u10 = 3,
    tc_hmask: u10 = 3,
    tc_bshift: u4 = 0,
    tc_uwrap: u2 = 0,
    tc_vwrap: u2 = 0,
    tc_base: u20 = 0,
    // CC_MODE's pass 0, CONST0 and CONST1, a cycle behind the parser's.
    tc_cc: u32 = 0x73717371,
    tc_const0: u32 = 0xFFFFFFFF,
    tc_const1: u32 = 0xFFFFFFFF,
    // The texel address pipeline, thirteen stages from a pixel's S', T'
    // and Q to its four texels' places in memory and the cache.
    #[no_reset]
    tp1: Tp1,
    #[no_reset]
    tp2: Tp2,
    #[no_reset]
    tp3: Tp3,
    #[no_reset]
    tp4: Tp4,
    #[no_reset]
    tp5: Tp5,
    #[no_reset]
    tp6: Tp6,
    #[no_reset]
    tp7: Tp7,
    #[no_reset]
    tp8: Tp8,
    #[no_reset]
    tp9: Tp9,
    #[no_reset]
    tp10: Tp10,
    #[no_reset]
    tp11: Tp11,
    #[no_reset]
    tp12: Tp12,
    #[no_reset]
    tp13: Tp13,
    // TEXEL: the next pixel to look up; then the address read, the cache
    // read (each bank's tag and texel routed to the block and texel it
    // serves), and the hit test.
    tx_issue: u7 = 0,
    tx1_valid: u1 = 0,
    #[no_reset]
    tx1_pix: u6 = 0,
    tx2_valid: u1 = 0,
    #[no_reset]
    tx2_pix: u6 = 0,
    #[no_reset]
    tx2_addr: u64 = 0,
    #[no_reset]
    tx2_addr2: u48 = 0,
    #[no_reset]
    tx2_drawn: u1 = 0,
    tx3_valid: u1 = 0,
    #[no_reset]
    tx3_pix: u6 = 0,
    #[no_reset]
    tx3_addr: u64 = 0,
    #[no_reset]
    tx3_addr2: u48 = 0,
    #[no_reset]
    tx3_drawn: u1 = 0,
    // The tags of the blocks holding the four texels: (first row, first
    // column), (first, second), (second, first), (second, second).
    #[no_reset]
    tx3_tag00: u21 = 0,
    #[no_reset]
    tx3_tag01: u21 = 0,
    #[no_reset]
    tx3_tag10: u21 = 0,
    #[no_reset]
    tx3_tag11: u21 = 0,
    // The four texels, in the same order from the top.
    #[no_reset]
    tx3_texel: u64 = 0,
    #[no_reset]
    tx3_shade: u32 = 0,
    // Then the filter: the texels decoded, with each row's second less
    // its first; each row blended across; the second row less the first;
    // the rows blended down.
    f1_valid: u1 = 0,
    f2_valid: u1 = 0,
    f3_valid: u1 = 0,
    f4_valid: u1 = 0,
    #[no_reset]
    f1: Filt1,
    #[no_reset]
    f2: Filt2,
    #[no_reset]
    f3: Filt3,
    #[no_reset]
    f4: Filt4,
    // Then the combiner: its inputs; A, B, C (stretched to 0 to 256) and D
    // for each channel; (A - B) x C, and D; the result; and the alpha test
    // with the colour tile's write. Channels R, G, B, A from the top.
    tx4_valid: u1 = 0,
    tx5_valid: u1 = 0,
    tx6_valid: u1 = 0,
    tx7_valid: u1 = 0,
    #[no_reset]
    tx4: Comb4,
    #[no_reset]
    tx5: Comb5,
    #[no_reset]
    tx6: Comb6,
    #[no_reset]
    tx7: Comb7,
    // TEXEL: a missing block being fetched, the words of it so far, and
    // which line and tag it goes to.
    filling: u1 = 0,
    fill_got: u5 = 0,
    #[no_reset]
    fill_tag: u20 = 0,
    #[no_reset]
    fill_line: u8 = 0,
    // The cache must be emptied before the next triangle (as after reset,
    // when its tags are unknown); FLUSH: the tag being cleared in each
    // bank.
    need_flush: u1 = 1,
    flush_line: u8 = 0,
    // Which of the front half's block's pixels are drawn (covered and
    // nearer).
    #[no_reset]
    mask: u64 = 0,
    // TEST's verdict, acted on in DECIDE.
    rejected: u1 = 0,
    // ZREAD: depth runs requested (0 to 2), and depths received.
    zreq: u2 = 0,
    zgot: u7 = 0,
    // TEXEL: whether the missing block's request has been taken.
    requested: u1 = 0,
    // Whose run is in front of the SDRAM arbiter, held until accepted: the
    // front half's depth read (1), the writer's (2), the back half's
    // texture block (3); 0 none.
    pres: u2 = 0,
    // The banks of the buffers between the stages (two of each, three of
    // the depth tile): the shade and texel-address tiles the front half
    // fills (`fsel`) and the back half reads (`bsel`); the colour tile the
    // back half fills (`csel`) and the writer reads (`w_sel`); the depth
    // tile the front half fills (`fz`, 0 to 2), the back half holds (`bz`)
    // and the writer reads (`w_z`).
    fsel: u1 = 0,
    bsel: u1 = 0,
    csel: u1 = 0,
    fz: u2 = 0,
    bz: u2 = 0,
    // The back half: looks texels up for a block the front half has
    // finished (HANDOFF) while the front half goes on to the next. Its
    // state (`B_*`), its block (word base and number), drawn pixels (the
    // alpha test may clear some), cleared flags and the triangle's
    // RENDER_MODE bits.
    b_state: u2 = 0,
    #[no_reset]
    b_base: u19 = 0,
    #[no_reset]
    b_blk: u12 = 0,
    #[no_reset]
    b_mask: u64 = 0,
    b_bflags: u4 = 0,
    b_flags: u13 = 7,
    // The writer: writes a block the back half has finished (its HANDOFF)
    // while it goes on to the next. Its state (0 free, 1 writing its runs,
    // 2 writing its block's flags back), its tile banks, its block (word
    // base and number), drawn pixels, cleared flags and the triangle's
    // colour and depth write enables; its run (bit 0 the half block, bit 1
    // depth rather than colour), the word being sent, and whether the run
    // has been taken.
    w_state: u2 = 0,
    w_sel: u1 = 0,
    w_z: u2 = 0,
    #[no_reset]
    w_base: u19 = 0,
    #[no_reset]
    w_blk: u12 = 0,
    #[no_reset]
    w_mask: u64 = 0,
    w_bflags: u4 = 0,
    w_en: u2 = 0,
    w_run: u2 = 0,
    w_pix: u6 = 0,
    w_requested: u1 = 0,
    // CLEAR: the colour, which buffers, and the block whose flags are read
    // (0 to 3,600); each block's flags are written a cycle after they are
    // read, with the cleared buffers' bits set.
    #[no_reset]
    clear_colour: u16 = 0,
    clear_colour_en: u1 = 0,
    clear_depth_en: u1 = 0,
    clear_blk: u12 = 0,
    // Cleared flags, a word per 8x8 block (`by * 80 + bx`) with a bit per
    // SDRAM bank: set, that bank's buffer (colour 0 to 2, depth 3) holds
    // its clear value in the block, whatever the SDRAM says. A clear sets
    // them; a block's first write after it writes the whole block and
    // clears its bit. Read ports: this unit (the block in TEST, the next
    // in CLEAR, else `mem_block`), and scan-out.
    #[storage(bram)]
    #[no_reset]
    cflags: mem<u4, 4096, 2> = 0,
    // The current block's flags, from TEST's read (the writer takes them
    // at HANDOFF).
    bflags: u4 = 0,
    // Each colour buffer's clear colour, bank 2 in bits 47:32.
    clear_colours: u48 = 0,
    // RENDER_MODE's COLOR_WRITE, Z_WRITE and Z_TEST (bits 2 to 0) for the
    // triangle being drawn, and for the one waiting to be copied.
    flags: u13 = 7,
    pending_flags: u13 = 7,
    // A block's colours, in raster order: two banks, one the back half
    // fills (`csel`), one the writer reads (`w_sel`).
    #[storage(lutram)]
    #[no_reset]
    tile: mem<u16, 128> = 0,
    // A block's depths: three banks (of four), the front half's (`fz`),
    // the back half's (`bz`, held for the writer) and the writer's (`w_z`).
    // Read ports: the depth test, the writer.
    #[storage(bram)]
    #[no_reset]
    ztile: mem<u16, 256, 2> = 0,
    // A block's shades, and its pixels' texel addresses, in raster order:
    // the tags of the blocks of the four texels a pixel takes, then the
    // texels' columns and rows (low 6 bits; first, second), and the weights
    // of the second column and row (`atile`: tags 00 and 01, then the
    // columns and rows; `btile`: tags 10 and 11, then the weights). Two
    // banks, the front half's (`fsel`) and the back half's (`bsel`).
    #[storage(lutram)]
    #[no_reset]
    stile: mem<u32, 128> = 0,
    #[storage(bram)]
    #[no_reset]
    atile: mem<u64, 128> = 0,
    #[storage(bram)]
    #[no_reset]
    btile: mem<u48, 128> = 0,
    // The texture cache: 256 lines, each a 4x4 block of texels, line
    // (by mod 16, bx mod 16). The texels are in four banks by the parity
    // of their column and row (bank v[0] @ u[0], at line @ v[1] @ u[1]),
    // so that the four a bilinear sample takes are read at once; the tags
    // in four by the parity of the block's column and row (bank by[0] @
    // bx[0], at by[3:1] @ bx[3:1]), so that the up to four blocks those
    // texels are in are tested at once. A tag is valid @ the block's word
    // address over 16.
    #[storage(bram)]
    #[no_reset]
    ctag0: mem<u21, 64> = 0,
    #[storage(bram)]
    #[no_reset]
    ctag1: mem<u21, 64> = 0,
    #[storage(bram)]
    #[no_reset]
    ctag2: mem<u21, 64> = 0,
    #[storage(bram)]
    #[no_reset]
    ctag3: mem<u21, 64> = 0,
    #[storage(bram)]
    #[no_reset]
    cdata0: mem<u16, 1024> = 0,
    #[storage(bram)]
    #[no_reset]
    cdata1: mem<u16, 1024> = 0,
    #[storage(bram)]
    #[no_reset]
    cdata2: mem<u16, 1024> = 0,
    #[storage(bram)]
    #[no_reset]
    cdata3: mem<u16, 1024> = 0,
    // 1 / x seeds for the divide by Q: setup's table.
    #[storage(bram)]
    #[no_reset]
    seeds: rom<u17, 1024> = include_hex!("../build/gen/setup_seed.hex"),
}

// The pipelines' stages. Each holds only what a later stage reads, so
// that every register is used (`-Wall`). Every stage has its pixel; the
// texel address pipeline's stages carry their valid bit, the filter's and
// the combiner's have theirs in registers of their own (reset).

// The texel address pipeline, 1 to 7: S' and T' bits 31:7 (signed), Q's
// low 32 bits; then Q's leading zeros; its mantissa (UQ1.16); the seed; x
// x seed; the Newton-Raphson factor; the reciprocal.
struct Tp1 {
    valid: u1 = 0,
    pix: u6 = 0,
    sp: i25 = 0,
    tp: i25 = 0,
    q: u32 = 0,
}

struct Tp2 {
    valid: u1 = 0,
    pix: u6 = 0,
    sp: i25 = 0,
    tp: i25 = 0,
    q: u32 = 0,
    lz: u5 = 0,
}

struct Tp3 {
    valid: u1 = 0,
    pix: u6 = 0,
    sp: i25 = 0,
    tp: i25 = 0,
    lz: u5 = 0,
    x: u17 = 0,
}

struct Tp4 {
    valid: u1 = 0,
    pix: u6 = 0,
    sp: i25 = 0,
    tp: i25 = 0,
    lz: u5 = 0,
    x: u17 = 0,
    r0: u17 = 0,
}

struct Tp5 {
    valid: u1 = 0,
    pix: u6 = 0,
    sp: i25 = 0,
    tp: i25 = 0,
    lz: u5 = 0,
    r0: u17 = 0,
    p: u34 = 0,
}

struct Tp6 {
    valid: u1 = 0,
    pix: u6 = 0,
    sp: i25 = 0,
    tp: i25 = 0,
    lz: u5 = 0,
    r0: u17 = 0,
    c: u17 = 0,
}

struct Tp7 {
    valid: u1 = 0,
    pix: u6 = 0,
    sp: i25 = 0,
    tp: i25 = 0,
    lz: u5 = 0,
    r: u17 = 0,
}

// 8: S' and T' times the reciprocal, and the right shifts that scale them
// to texels; 9: shifted.
struct Tp8 {
    valid: u1 = 0,
    pix: u6 = 0,
    us: i43 = 0,
    vt: i43 = 0,
    ru: u6 = 0,
    rv: u6 = 0,
}

struct Tp9 {
    valid: u1 = 0,
    pix: u6 = 0,
    su: i50 = 0,
    sv: i50 = 0,
}

// 10: the texel coordinates (4 fraction bits).
struct Tp10 {
    valid: u1 = 0,
    pix: u6 = 0,
    u: i20 = 0,
    v: i20 = 0,
}

// 11: the first column and row a sample takes (whole texels, before
// wrapping), the next ones, and the next ones' weights (sixteenths).
struct Tp11 {
    valid: u1 = 0,
    pix: u6 = 0,
    ui0: i17 = 0,
    ui1: i17 = 0,
    vi0: i17 = 0,
    vi1: i17 = 0,
    fu: u4 = 0,
    fv: u4 = 0,
}

// 12: the four wrapped.
struct Tp12 {
    valid: u1 = 0,
    pix: u6 = 0,
    tu: u10 = 0,
    tu1: u10 = 0,
    tv: u10 = 0,
    tv1: u10 = 0,
    fu: u4 = 0,
    fv: u4 = 0,
}

// 13: the texel addresses, `atile`'s and `btile`'s entries.
struct Tp13 {
    valid: u1 = 0,
    pix: u6 = 0,
    entry: u64 = 0,
    entry2: u48 = 0,
}

// The filter, after the texel pass's hit test, channels R, G, B, A from
// the top of each field. 1: the pixel drawn by the depth test, its shade;
// the second column's and row's weights; each row's first texel
// (RGBA8888), and its second less its first (9 bits a channel, signed).
struct Filt1 {
    pix: u6 = 0,
    drawn: u1 = 0,
    shade: u32 = 0,
    fu: u4 = 0,
    fv: u4 = 0,
    b0: u32 = 0,
    b1: u32 = 0,
    d0: u36 = 0,
    d1: u36 = 0,
}

// 2: each row blended across (12 bits a channel, 4 fraction bits).
struct Filt2 {
    pix: u6 = 0,
    drawn: u1 = 0,
    shade: u32 = 0,
    fv: u4 = 0,
    r0: u48 = 0,
    r1: u48 = 0,
}

// 3: the second row less the first (13 bits a channel, signed).
struct Filt3 {
    pix: u6 = 0,
    drawn: u1 = 0,
    shade: u32 = 0,
    fv: u4 = 0,
    r0: u48 = 0,
    dv: u52 = 0,
}

// 4: the sample, RGBA8888.
struct Filt4 {
    pix: u6 = 0,
    drawn: u1 = 0,
    shade: u32 = 0,
    out: u32 = 0,
}

// The combiner. 4: its inputs, RGBA8888, texel and shade; 5: A - B for
// each channel (9 bits, signed), C stretched (9 bits a channel), and D;
// 6: (A - B) x C for each channel, and D; 7: the result, RGBA8888.
struct Comb4 {
    pix: u6 = 0,
    drawn: u1 = 0,
    tex: u32 = 0,
    shade: u32 = 0,
}

struct Comb5 {
    pix: u6 = 0,
    drawn: u1 = 0,
    dr: i9 = 0,
    dg: i9 = 0,
    db: i9 = 0,
    da: i9 = 0,
    c: u36 = 0,
    d: u32 = 0,
}

struct Comb6 {
    pix: u6 = 0,
    drawn: u1 = 0,
    pr: i20 = 0,
    pg: i20 = 0,
    pb: i20 = 0,
    pa: i20 = 0,
    d: u32 = 0,
}

struct Comb7 {
    pix: u6 = 0,
    drawn: u1 = 0,
    out: u32 = 0,
}

impl Raster {
    // The bank of the writer's run: colour for runs 0 and 1, depth for 2
    // and 3. `draw`: the colour buffer's bank.
    fn run_bank(self, draw: u2) -> u2 {
        if self.w_run[1:1] == 1 { DEPTH_BANK } else { draw }
    }

    // The run's buffer is cleared in the writer's block: it is written
    // whole.
    fn run_cleared(self, draw: u2) -> u1 {
        (self.w_bflags >> self.run_bank(draw))[0:0]
    }

    // The writer's run is wanted: the triangle writes its buffer, and its
    // half block has a drawn pixel, or (the buffer cleared here) the block
    // has.
    fn run_used(self, draw: u2) -> u1 {
        let half = if self.w_run[0:0] == 0 { self.w_mask[31:0] != 0 } else { self.w_mask[63:32] != 0 };
        let drawn = if self.run_cleared(draw) == 1 { self.w_mask != 0 } else { half };
        let enabled = if self.w_run[1:1] == 0 { self.w_en[1:1] } else { self.w_en[0:0] };
        drawn & enabled == 1
    }

    // The front half's depth read has a run accepted and its data still
    // coming; the back half's texture block has.
    fn z_inflight(self) -> u1 {
        self.state == R_ZREAD & self.zreq != 0
    }

    fn fill_inflight(self) -> u1 {
        self.b_state == B_TEXEL & self.filling == 1 & self.requested == 1
    }

    // The front half wants a depth run, not yet taken; the back half its
    // missing texture block. Neither while the other's data is coming:
    // the words that come back are then the one in flight's.
    fn want_z(self) -> u1 {
        self.state == R_ZREAD & self.zreq != 2 & !self.fill_inflight()
    }

    fn want_fill(self) -> u1 {
        self.b_state == B_TEXEL & self.filling == 1 & self.requested == 0 & !self.z_inflight()
    }

    // The writer wants its run, not yet taken.
    fn want_writer(self, draw: u2) -> u1 {
        self.w_state == 1 & self.run_used(draw) & self.w_requested == 0
    }

    // Whose run is in front of the arbiter: the one already there until it
    // is accepted, else the front half's, else the back half's, else the
    // writer's (1 front, 3 back, 2 writer, 0 none).
    fn presenting(self, draw: u2) -> u2 {
        if self.pres != 0 {
            self.pres
        } else if self.want_z() == 1 {
            1
        } else if self.want_fill() == 1 {
            3
        } else if self.want_writer(draw) == 1 {
            2
        } else {
            0
        }
    }

    // The outputs, from the registers. `draw`: the colour buffer's bank.
    pub fn out(self, draw: u2) -> RasterOut {
        let base = block_base(self.bx, self.by);
        let who = self.presenting(draw);
        let req = if who == 2 {
            let addr = (self.w_base + (0_u13 @ self.w_run[0:0] @ 0_u5)) as u19 wrap;
            SdramReq { write: 1, addr: self.run_bank(draw) @ 0_u3 @ addr, len: 32 }
        } else if who == 1 {
            let addr = (base + (0_u13 @ self.zreq[0:0] @ 0_u5)) as u19 wrap;
            SdramReq { write: 0, addr: DEPTH_BANK @ 0_u3 @ addr, len: 32 }
        } else {
            SdramReq { write: 0, addr: self.fill_tag @ 0_u4, len: 16 }
        };
        // The writer's word: a pixel not drawn is left as it was, or, its
        // buffer cleared in this block, written with the clear value.
        let drawn_here = (self.w_mask >> self.w_pix)[0:0];
        let cleared = self.run_cleared(draw) == 1;
        let wdata = if self.w_run[1:1] == 1 {
            if cleared & drawn_here == 0 { FAR } else { self.ztile.value()[1] }
        } else if cleared & drawn_here == 0 {
            clear_colour_of(self.clear_colours, draw)
        } else {
            self.tile.value()
        };
        let flags = self.cflags.value();
        RasterOut {
            out_raddr: copy_slot(self.copy),
            pending: self.pending,
            busy: self.state != R_IDLE | self.pending == 1 | self.b_state != B_FREE | self.w_state != 0,
            req: if who != 0 { Some(req) } else { None },
            wdata: wdata,
            wmask: if cleared { 0 } else { !drawn_here },
            scan_flags: flags[1],
            mem_flags: flags[0],
            clear_colours: self.clear_colours,
        }
    }

    // `kept`: the setup engine has just finished a triangle it kept, and
    // `kept_flags` are its write enables and depth test (RENDER_MODE's bits
    // 4 to 2). `rdata`: the output buffer slot addressed last cycle.
    // `clear`: clear the frame being drawn. `accepted`, `wtake`,
    // `sdram_rdata`: the SDRAM controller's, for this unit's runs. `tex`:
    // TEX0_CFG, which only changes while this unit is idle. `flush`: empty
    // the texture cache before the next triangle. `draw`: the colour
    // buffer's bank. `mem_block`, `scan_block`: blocks whose cleared flags
    // to read for a host's MEM_DATA read and for scan-out.
    pub fn next(
        self,
        kept: u1,
        kept_flags: u13,
        rdata: u36,
        clear: Option<ClearCmd>,
        accepted: u1,
        wtake: u1,
        sdram_rdata: Option<u16>,
        tex: u64,
        flush: u1,
        cc: u32,
        const0: u32,
        const1: u32,
        draw: u2,
        mem_block: u12,
        scan_block: u12,
    ) -> Self {
        let st = self.state;
        // TEX0_CFG's fields, from their registers; sizes clamped to 4 to
        // 1024 texels.
        let lw_in = log2_size(tex[11:8]);
        let lh_in = log2_size(tex[15:12]);
        let textured = self.tc_textured == 1;
        let argb = self.tc_argb;
        let lw = self.tc_lw;
        let lh = self.tc_lh;
        let (clearing, clear_in) = match clear {
            Some(c) => (1_u1, c),
            None => (0_u1, ClearCmd { colour: 0, colour_en: 0, depth_en: 0 }),
        };
        let (zin, zword) = match sdram_rdata {
            Some(w) => (1_u1, w),
            None => (0_u1, 0_u16),
        };

        // ---- COPY: each slot arrives a cycle after its address. --------
        let got = st == R_COPY & self.copy != 0;
        let k = (self.copy - 1) as u6 wrap;
        let word = rdata as i36 wrap;
        let copy_done = st == R_COPY & self.copy == COPY_SLOTS;

        // ---- INIT: the box in blocks. The last pixel whose centre is in
        // the box is (max - 8) >> 4, and its block that >> 3. ------------
        let bx0 = (self.xs >> 7) as i10 wrap;
        let by0 = (self.ys >> 7) as i10 wrap;
        let bx1 = ((self.xmax - 8) >> 7) as i10 wrap;
        let by1 = ((self.ymax - 8) >> 7) as i10 wrap;
        let empty = bx1 < bx0 | by1 < by0;

        // ---- TEST: a block wholly outside an edge is skipped; DECIDE acts
        // on the verdict a cycle later. ----------------------------------
        let reject = outside(self.e0) | outside(self.e1) | outside(self.e2);

        // ---- ZREAD: the block's 64 depths, two runs. ---------------------
        let reading = st == R_ZREAD;
        let zread_done = reading & self.zgot == 64;
        // Read data is the depth read's while it is in flight, else the
        // texture block's.
        let z_word = zin & self.z_inflight();

        // ---- PIXELS: each pixel's coverage, depth and shade, then (a cycle
        // later, in the depth test's stage) drawn if covered and (with the
        // depth test) nearer than the depth there. -------------------------
        let stepping = st == R_PIXELS;
        let covered = inside(self.e0) & inside(self.e1) & inside(self.e2);
        let shade = s8(self.pr.pix) @ s8(self.pg.pix) @ s8(self.pb.pix) @ s8(self.pa.pix);
        let nearer = self.zt_z < self.zt_zbuf | self.flags[0:0] == 0;
        let drawn = self.zt_valid == 1 & self.zt_cov == 1 & nearer;
        let row_end = self.pix[2:0] == 7;
        let block_end = self.pix == 63;
        let draining = st == R_DRAIN;
        let drained = draining & self.drain == 0;

        // ---- The texel address pipeline (PIXELS and DRAIN): S' / Q and
        // T' / Q by a reciprocal (setup's seed and a Newton-Raphson step),
        // scaled to texels, wrapped, then the texel's block and line. ----
        let q_low = (self.pq.pix as u36 wrap)[31:0];
        let t0 = Tp1 {
            valid: stepping,
            pix: self.pix,
            sp: (self.ps.pix as u36 wrap)[31:7] as i25 wrap,
            tp: (self.pt.pix as u36 wrap)[31:7] as i25 wrap,
            q: if q_low == 0 { 1 } else { q_low },
        };
        let t1 = self.tp1;
        let t2 = self.tp2;
        let t3 = self.tp3;
        let t4 = self.tp4;
        let t5 = self.tp5;
        let t6 = self.tp6;
        let t7 = self.tp7;
        let t8 = self.tp8;
        let t9 = self.tp9;
        let t10 = self.tp10;
        let t11 = self.tp11;
        let t12 = self.tp12;
        let t13 = self.tp13;
        let normal = t2.q << t2.lz;
        let rr = t6.r0 * t6.c;
        let u_right = (41 - (0_u2 @ t7.lz) - (0_u3 @ lw)) as u6 wrap;
        let v_right = (41 - (0_u2 @ t7.lz) - (0_u3 @ lh)) as u6 wrap;
        // The tags of the four texels' blocks: row (first or second) then
        // column.
        let bs = self.tc_bshift;
        let tag00 = block_tag(self.tc_base, t12.tv[9:2], t12.tu[9:2], bs);
        let tag01 = block_tag(self.tc_base, t12.tv[9:2], t12.tu1[9:2], bs);
        let tag10 = block_tag(self.tc_base, t12.tv1[9:2], t12.tu[9:2], bs);
        let tag11 = block_tag(self.tc_base, t12.tv1[9:2], t12.tu1[9:2], bs);
        let entry = tag00 @ tag01 @ t12.tu[5:0] @ t12.tu1[5:0] @ t12.tv[5:0] @ t12.tv1[5:0];
        let entry2 = tag10 @ tag11 @ t12.fu @ t12.fv;

        // ---- The back half, TEXEL: each pixel's texels through the cache,
        // in order: its
        // addresses read; the cache's banks and its shade read, each bank's
        // tag and texel routed to the block and texel it serves; then a
        // hit, or a pixel not drawn, goes on to the filter, and a miss
        // fetches the first missing block and looks that pixel up again. A
        // second column or row with no weight is not needed. ---------------
        let texeling = self.b_state == B_TEXEL;
        let pass = texeling & self.filling == 0;
        let a1 = self.atile.value();
        let b1 = self.btile.value();
        let e2 = self.tx2_addr;
        let e3 = self.tx3_addr;
        let e3b = self.tx3_addr2;
        let m00 = self.tx3_tag00 != (1_u1 @ e3[63:44]);
        let m01 = e3b[7:4] != 0 & self.tx3_tag01 != (1_u1 @ e3[43:24]);
        let m10 = e3b[3:0] != 0 & self.tx3_tag10 != (1_u1 @ e3b[47:28]);
        let m11 = e3b[7:4] != 0 & e3b[3:0] != 0 & self.tx3_tag11 != (1_u1 @ e3b[27:8]);
        // Untextured, every lookup is a hit (on opaque white).
        let hit = !textured | !(m00 | m01 | m10 | m11);
        let miss_tag = if m00 { e3[63:44] } else if m01 { e3[43:24] } else if m10 { e3b[47:28] } else { e3b[27:8] };
        let miss_line = if m00 {
            e3[11:8] @ e3[23:20]
        } else if m01 {
            e3[11:8] @ e3[17:14]
        } else if m10 {
            e3[5:2] @ e3[23:20]
        } else {
            e3[5:2] @ e3[17:14]
        };
        // The texels decoded (white untextured): row then column.
        let x3 = self.tx3_texel;
        let d00: u32 = if textured { decode(x3[63:48], argb) } else { 0xFFFFFFFF };
        let d01: u32 = if textured { decode(x3[47:32], argb) } else { 0xFFFFFFFF };
        let d10: u32 = if textured { decode(x3[31:16], argb) } else { 0xFFFFFFFF };
        let d11: u32 = if textured { decode(x3[15:0], argb) } else { 0xFFFFFFFF };
        let f1 = self.f1;
        let f2 = self.f2;
        let f3 = self.f3;
        let f4 = self.f4;
        let tx_ok = pass & self.tx3_valid == 1 & (hit | self.tx3_drawn == 0);
        let tx_miss = pass & self.tx3_valid == 1 & !hit & self.tx3_drawn == 1;
        let issuing = pass & !tx_miss & self.tx_issue != 64;
        // The combiner: each channel's A, B, C and D by CC_MODE; (A - B) x
        // C; + D, clamped; then the alpha test on the result's alpha.
        let ccm = self.tc_cc;
        let c4 = self.tx4;
        let k0 = self.tc_const0;
        let k1 = self.tc_const1;
        let op_a = operand(ccm[3:0], 0, 0, c4.tex, c4.shade, k0, k1)
            @ operand(ccm[3:0], 0, 1, c4.tex, c4.shade, k0, k1)
            @ operand(ccm[3:0], 0, 2, c4.tex, c4.shade, k0, k1)
            @ operand(ccm[19:16], 0, 3, c4.tex, c4.shade, k0, k1);
        let op_b = operand(ccm[7:4], 0, 0, c4.tex, c4.shade, k0, k1)
            @ operand(ccm[7:4], 0, 1, c4.tex, c4.shade, k0, k1)
            @ operand(ccm[7:4], 0, 2, c4.tex, c4.shade, k0, k1)
            @ operand(ccm[23:20], 0, 3, c4.tex, c4.shade, k0, k1);
        let op_c = stretch(operand(ccm[11:8], 1, 0, c4.tex, c4.shade, k0, k1))
            @ stretch(operand(ccm[11:8], 1, 1, c4.tex, c4.shade, k0, k1))
            @ stretch(operand(ccm[11:8], 1, 2, c4.tex, c4.shade, k0, k1))
            @ stretch(operand(ccm[27:24], 0, 3, c4.tex, c4.shade, k0, k1));
        let op_d = operand(ccm[15:12], 0, 0, c4.tex, c4.shade, k0, k1)
            @ operand(ccm[15:12], 0, 1, c4.tex, c4.shade, k0, k1)
            @ operand(ccm[15:12], 0, 2, c4.tex, c4.shade, k0, k1)
            @ operand(ccm[31:28], 0, 3, c4.tex, c4.shade, k0, k1);
        let c5 = self.tx5;
        let c6 = self.tx6;
        let c7 = self.tx7;
        let alpha_test = self.b_flags[4:3];
        let alpha_ref = self.b_flags[12:5];
        let alpha = c7.out[7:0];
        let alpha_pass = alpha_test == 0
            | (alpha_test == 1 & alpha < alpha_ref)
            | (alpha_test == 2 & alpha >= alpha_ref)
            | (alpha_test == 3 & alpha != alpha_ref);
        let tx_write = texeling & self.tx7_valid == 1;
        let alpha_fail = tx_write & c7.drawn == 1 & !alpha_pass;
        let texel_done = tx_write & c7.pix == 63;
        let fill_word = texeling & self.filling == 1 & self.requested == 1 & zin == 1;
        let fill_done = fill_word & self.fill_got == 15;

        // ---- FLUSH: every cache line's tag cleared. ----------------------
        let flushing = st == R_FLUSH;
        let flush_done = flushing & self.flush_line == 63;

        // ---- The SDRAM: whose run was accepted (the one presented). ------
        let who = self.presenting(draw);
        let acc_z = accepted & who == 1;
        let acc_fill = accepted & who == 3;
        let acc_writer = accepted & who == 2;

        // ---- HANDOFF: the front half's block goes to the back half once
        // it is free; a block with no pixel drawn goes nowhere. The back
        // half's goes to the writer once it is free. ---------------------
        let f_handing = st == R_HANDOFF & (self.b_state == B_FREE | self.mask == 0);
        let to_back = f_handing & self.mask != 0;
        let b_handing = self.b_state == B_HANDOFF & self.w_state == 0;
        let blk = block_base(self.bx, self.by)[17:6];
        // A block the back half or the writer still has (its flags not yet
        // written back) is not tested again until it has been written: a
        // later triangle's block must see the earlier one's depths and
        // flags.
        let wait_writer = (self.b_state != B_FREE & self.b_blk == blk) | (self.w_state != 0 & self.w_blk == blk);

        // ---- The writer: colours then depths, each half block with a
        // drawn pixel one run (both halves for a cleared buffer); then the
        // block's flags back. --------------------------------------------
        let writing = self.w_state == 1;
        let sent_last = wtake & self.w_pix[4:0] == 31;
        let used = self.run_used(draw) == 1;
        let run_done = writing & (!used | sent_last);
        let read_ptr: u6 = if writing & wtake == 1 { (self.w_pix + 1) as u6 wrap } else { self.w_pix };
        let next_run = (self.w_run + 1) as u2 wrap;
        // CLEAR: every block's flags read, then written a cycle later.
        let clear_done = st == R_CLEAR & self.clear_blk == BLOCKS;

        // ---- NEXT: the next block in raster order, or done. -------------
        let last_col = self.bx == self.bx1;
        let last_row = self.by == self.by1;

        let state: u4 = if st == R_IDLE {
            if clearing == 1 {
                R_CLEAR
            } else if self.pending == 1 & self.need_flush == 1 {
                // The back half uses the cache: it must be done.
                if self.b_state == B_FREE { R_FLUSH } else { R_IDLE }
            } else if self.pending == 1 {
                R_COPY
            } else {
                R_IDLE
            }
        } else if flushing {
            if flush_done { R_IDLE } else { R_FLUSH }
        } else if draining {
            if !drained { R_DRAIN } else { R_HANDOFF }
        } else if st == R_HANDOFF {
            if f_handing { R_NEXT } else { R_HANDOFF }
        } else if st == R_CLEAR {
            if clear_done { R_IDLE } else { R_CLEAR }
        } else if st == R_COPY {
            if copy_done { R_INIT } else { R_COPY }
        } else if st == R_INIT {
            if empty { R_IDLE } else { R_TEST }
        } else if st == R_TEST {
            if wait_writer { R_TEST } else { R_DECIDE }
        } else if st == R_DECIDE {
            // Without the depth test, or with the block's depth cleared,
            // there is nothing to read.
            if self.rejected == 1 {
                R_NEXT
            } else if self.flags[0:0] == 1 & self.cflags.value()[0][3:3] == 0 {
                R_ZREAD
            } else {
                R_PIXELS
            }
        } else if reading {
            if zread_done { R_PIXELS } else { R_ZREAD }
        } else if stepping {
            if block_end { R_DRAIN } else { R_PIXELS }
        } else if last_col & last_row {
            R_IDLE
        } else {
            R_TEST
        };
        let mode: u3 = if st == R_INIT {
            M_INIT
        } else if st == R_DECIDE & self.rejected == 0 {
            M_BLOCK
        } else if stepping & !row_end {
            M_PIXEL
        } else if stepping & !block_end {
            M_ROW
        } else if st == R_NEXT & !last_col {
            M_NEXT_COL
        } else if st == R_NEXT & !last_row {
            M_NEXT_ROW
        } else {
            M_HOLD
        };
        // The depth tile: filled by ZREAD; read a pixel ahead in PIXELS (and
        // pixel 0 the cycle before), so that each pixel's depth is there as
        // it is stepped, registered for the depth test a cycle later, and
        // written with the pixel's depth there; read by the writer.
        let zraddr: u6 = if stepping { (self.pix + 1) as u6 wrap } else { 0 };
        let zwe = (reading & z_word) | self.zt_valid;
        let zwaddr: u6 = if reading { self.zgot[5:0] } else { self.zt_pix };
        let zwdata: u16 = if reading { zword } else { self.zt_z };
        // The colour tile: each pixel's colour from TEXEL's last stage.
        // The cache's writes: a fetched block's words, each to its texel's
        // bank; its tag when the last arrives; or, in FLUSH, a tag of each
        // bank cleared each cycle.
        let data_bank = self.fill_got[2:2] @ self.fill_got[0:0];
        let data_waddr = self.fill_line @ self.fill_got[3:3] @ self.fill_got[1:1];
        let tag_bank = self.fill_line[4:4] @ self.fill_line[0:0];
        let tag_waddr = if flushing { self.flush_line[5:0] } else { self.fill_line[7:5] @ self.fill_line[3:1] };
        let tag_wdata: u21 = if flushing { 0 } else { 1_u1 @ self.fill_tag };
        let cwdata = c7.out[31:8];

        // The cleared flags: CLEAR reads each block and writes it back a
        // cycle later with the cleared buffers' bits set; TEST reads the
        // block, the writer writes it back; otherwise a host's MEM_DATA
        // block.
        let flags_raddr: u12 = if st == R_CLEAR {
            self.clear_blk
        } else if st == R_TEST {
            blk
        } else {
            mem_block
        };
        let set_bits: u4 = (if self.clear_colour_en == 1 { bank_bit(draw) } else { 0 })
            | (if self.clear_depth_en == 1 { bank_bit(DEPTH_BANK) } else { 0 });
        let clearing_flags = st == R_CLEAR & self.clear_blk != 0;
        let flags_we = clearing_flags | self.w_state == 2;
        let flags_waddr: u12 = if st == R_CLEAR { (self.clear_blk - 1) as u12 wrap } else { self.w_blk };
        let flags_wdata: u4 = if st == R_CLEAR { self.cflags.value()[0] | set_bits } else { self.w_bflags };

        Self {
                state: state,
                pending: if kept == 1 { 1 } else if copy_done { 0 } else { self.pending },
                pending_flags: if kept == 1 { kept_flags } else { self.pending_flags },
                flags: if st == R_IDLE & clearing == 0 & self.pending == 1 { self.pending_flags } else { self.flags },
                copy: if st == R_COPY { (self.copy + 1) as u6 wrap } else { 0 },
                xs: if got & k == 9 { word as i16 wrap } else { self.xs },
                ys: if got & k == 10 { word as i16 wrap } else { self.ys },
                xmax: if got & k == 11 { word as i16 wrap } else { self.xmax },
                ymax: if got & k == 12 { word as i16 wrap } else { self.ymax },
                bx0: if st == R_INIT { bx0 } else { self.bx0 },
                bx1: if st == R_INIT { bx1 } else { self.bx1 },
                by1: if st == R_INIT { by1 } else { self.by1 },
                bx: if st == R_INIT {
                    bx0
                } else if st == R_NEXT & last_col {
                    self.bx0
                } else if st == R_NEXT {
                    (self.bx + 1) as i10 wrap
                } else {
                    self.bx
                },
                by: if st == R_INIT {
                    by0
                } else if st == R_NEXT & last_col {
                    (self.by + 1) as i10 wrap
                } else {
                    self.by
                },
                e0: copy_edge(step_edge(self.e0, mode), got, k, word, 0, 3, 4),
                e1: copy_edge(step_edge(self.e1, mode), got, k, word, 1, 5, 6),
                e2: copy_edge(step_edge(self.e2, mode), got, k, word, 2, 7, 8),
                pr: copy_plane(step_plane(self.pr, mode), got, k, word, 13, 16, 17),
                pg: copy_plane(step_plane(self.pg, mode), got, k, word, 14, 18, 19),
                pb: copy_plane(step_plane(self.pb, mode), got, k, word, 15, 20, 21),
                pz: copy_plane(step_plane(self.pz, mode), got, k, word, 22, 23, 24),
                ps: copy_plane(step_plane(self.ps, mode), got, k, word, 25, 26, 27),
                pt: copy_plane(step_plane(self.pt, mode), got, k, word, 28, 29, 30),
                pq: copy_plane(step_plane(self.pq, mode), got, k, word, 31, 32, 33),
                pa: copy_plane(step_plane(self.pa, mode), got, k, word, 34, 35, 36),
                zt_valid: stepping,
                zt_pix: self.pix,
                zt_cov: covered,
                zt_z: depth(self.pz.pix),
                // A block whose depth is cleared wasn't read: it is all FAR.
                zt_zbuf: if self.bflags[3:3] == 1 { FAR } else { self.ztile.value()[0] },
                zt_shade: shade,
                drain: if stepping { if textured { DRAIN_TEXTURED } else { DRAIN_PLAIN } } else { (self.drain - 1) as u4 wrap },
                tp1: t0,
                tp2: Tp2 { valid: t1.valid, pix: t1.pix, sp: t1.sp, tp: t1.tp, q: t1.q, lz: lz32(t1.q) },
                tp3: Tp3 { valid: t2.valid, pix: t2.pix, sp: t2.sp, tp: t2.tp, lz: t2.lz, x: normal[31:15] },
                tp4: Tp4 { valid: t3.valid, pix: t3.pix, sp: t3.sp, tp: t3.tp, lz: t3.lz, x: t3.x, r0: self.seeds.value() },
                tp5: Tp5 { valid: t4.valid, pix: t4.pix, sp: t4.sp, tp: t4.tp, lz: t4.lz, r0: t4.r0, p: t4.x * t4.r0 },
                tp6: Tp6 {
                    valid: t5.valid,
                    pix: t5.pix,
                    sp: t5.sp,
                    tp: t5.tp,
                    lz: t5.lz,
                    r0: t5.r0,
                    c: ((0x400000000_u35 - (0_u1 @ t5.p)) as u35 wrap)[33:17],
                },
                tp7: Tp7 {
                    valid: t6.valid,
                    pix: t6.pix,
                    sp: t6.sp,
                    tp: t6.tp,
                    lz: t6.lz,
                    r: if rr[33:33] == 1 { R_MAX } else { rr[32:16] },
                },
                tp8: Tp8 {
                    valid: t7.valid,
                    pix: t7.pix,
                    us: t7.sp * ((0_u1 @ t7.r) as i18 wrap),
                    vt: t7.tp * ((0_u1 @ t7.r) as i18 wrap),
                    ru: u_right,
                    rv: v_right,
                },
                tp9: Tp9 { valid: t8.valid, pix: t8.pix, su: widen7(t8.us) >> t8.ru, sv: widen7(t8.vt) >> t8.rv },
                tp10: Tp10 { valid: t9.valid, pix: t9.pix, u: saturate20(t9.su), v: saturate20(t9.sv) },
                tp11: Tp11 {
                    valid: t10.valid,
                    pix: t10.pix,
                    ui0: first_index(t10.u, self.tc_bilinear),
                    ui1: next_index(t10.u, self.tc_bilinear),
                    vi0: first_index(t10.v, self.tc_bilinear),
                    vi1: next_index(t10.v, self.tc_bilinear),
                    fu: weight(t10.u, self.tc_bilinear),
                    fv: weight(t10.v, self.tc_bilinear),
                },
                tp12: Tp12 {
                    valid: t11.valid,
                    pix: t11.pix,
                    tu: wrap_texel(t11.ui0, lw, self.tc_wmask, self.tc_uwrap),
                    tu1: wrap_texel(t11.ui1, lw, self.tc_wmask, self.tc_uwrap),
                    tv: wrap_texel(t11.vi0, lh, self.tc_hmask, self.tc_vwrap),
                    tv1: wrap_texel(t11.vi1, lh, self.tc_hmask, self.tc_vwrap),
                    fu: t11.fu,
                    fv: t11.fv,
                },
                tp13: Tp13 { valid: t12.valid, pix: t12.pix, entry: entry, entry2: entry2 },
                tc_textured: tex[0:0],
                tc_bilinear: (tex[3:2] == 1),
                tc_argb: (tex[7:4] == 1),
                tc_lw: lw_in,
                tc_lh: lh_in,
                tc_wmask: size_mask(lw_in),
                tc_hmask: size_mask(lh_in),
                tc_bshift: (lw_in - 2) as u4 wrap,
                tc_uwrap: tex[17:16],
                tc_vwrap: tex[19:18],
                tc_base: tex[47:32] @ 0_u4,
                tc_cc: cc,
                tc_const0: const0,
                tc_const1: const1,
                tx_issue: if !texeling {
                    0
                } else if tx_miss {
                    0_u1 @ self.tx3_pix
                } else if issuing {
                    (self.tx_issue + 1) as u7 wrap
                } else {
                    self.tx_issue
                },
                tx1_valid: issuing,
                tx1_pix: self.tx_issue[5:0],
                tx2_valid: pass & !tx_miss & self.tx1_valid == 1,
                tx2_pix: self.tx1_pix,
                tx2_addr: a1,
                tx2_addr2: b1,
                tx2_drawn: (self.b_mask >> self.tx1_pix)[0:0],
                tx3_valid: pass & !tx_miss & self.tx2_valid == 1,
                tx3_pix: self.tx2_pix,
                tx3_addr: e2,
                tx3_addr2: self.tx2_addr2,
                tx3_drawn: self.tx2_drawn,
                tx3_tag00: pick21(e2[8:8] @ e2[20:20], self.ctag0.value(), self.ctag1.value(), self.ctag2.value(), self.ctag3.value()),
                tx3_tag01: pick21(e2[8:8] @ e2[14:14], self.ctag0.value(), self.ctag1.value(), self.ctag2.value(), self.ctag3.value()),
                tx3_tag10: pick21(e2[2:2] @ e2[20:20], self.ctag0.value(), self.ctag1.value(), self.ctag2.value(), self.ctag3.value()),
                tx3_tag11: pick21(e2[2:2] @ e2[14:14], self.ctag0.value(), self.ctag1.value(), self.ctag2.value(), self.ctag3.value()),
                tx3_texel: pick16(e2[6:6] @ e2[18:18], self.cdata0.value(), self.cdata1.value(), self.cdata2.value(), self.cdata3.value())
                    @ pick16(e2[6:6] @ e2[12:12], self.cdata0.value(), self.cdata1.value(), self.cdata2.value(), self.cdata3.value())
                    @ pick16(e2[0:0] @ e2[18:18], self.cdata0.value(), self.cdata1.value(), self.cdata2.value(), self.cdata3.value())
                    @ pick16(e2[0:0] @ e2[12:12], self.cdata0.value(), self.cdata1.value(), self.cdata2.value(), self.cdata3.value()),
                tx3_shade: self.stile.value(),
                f1_valid: tx_ok,
                f2_valid: texeling & self.f1_valid == 1,
                f3_valid: texeling & self.f2_valid == 1,
                f4_valid: texeling & self.f3_valid == 1,
                f1: Filt1 {
                    pix: self.tx3_pix,
                    drawn: self.tx3_drawn,
                    shade: self.tx3_shade,
                    fu: e3b[7:4],
                    fv: e3b[3:0],
                    b0: d00,
                    b1: d10,
                    d0: differences(d01, d00),
                    d1: differences(d11, d10),
                },
                f2: Filt2 {
                    pix: f1.pix,
                    drawn: f1.drawn,
                    shade: f1.shade,
                    fv: f1.fv,
                    r0: rows(f1.b0, f1.d0, f1.fu),
                    r1: rows(f1.b1, f1.d1, f1.fu),
                },
                f3: Filt3 { pix: f2.pix, drawn: f2.drawn, shade: f2.shade, fv: f2.fv, r0: f2.r0, dv: row_differences(f2.r1, f2.r0) },
                f4: Filt4 { pix: f3.pix, drawn: f3.drawn, shade: f3.shade, out: blend(f3.r0, f3.dv, f3.fv) },
                tx4_valid: texeling & self.f4_valid == 1,
                tx5_valid: texeling & self.tx4_valid == 1,
                tx6_valid: texeling & self.tx5_valid == 1,
                tx7_valid: texeling & self.tx6_valid == 1,
                tx4: Comb4 { pix: f4.pix, drawn: f4.drawn, tex: f4.out, shade: f4.shade },
                tx5: Comb5 {
                    pix: c4.pix,
                    drawn: c4.drawn,
                    dr: difference(op_a[31:24], op_b[31:24]),
                    dg: difference(op_a[23:16], op_b[23:16]),
                    db: difference(op_a[15:8], op_b[15:8]),
                    da: difference(op_a[7:0], op_b[7:0]),
                    c: op_c,
                    d: op_d,
                },
                tx6: Comb6 {
                    pix: c5.pix,
                    drawn: c5.drawn,
                    pr: product(c5.dr, c5.c[35:27]),
                    pg: product(c5.dg, c5.c[26:18]),
                    pb: product(c5.db, c5.c[17:9]),
                    pa: product(c5.da, c5.c[8:0]),
                    d: c5.d,
                },
                tx7: Comb7 {
                    pix: c6.pix,
                    drawn: c6.drawn,
                    out: finish(c6.pr, c6.d[31:24])
                        @ finish(c6.pg, c6.d[23:16])
                        @ finish(c6.pb, c6.d[15:8])
                        @ finish(c6.pa, c6.d[7:0]),
                },
                filling: if tx_miss { 1 } else if fill_done { 0 } else { self.filling },
                fill_got: if fill_done | !texeling { 0 } else if fill_word { (self.fill_got + 1) as u5 wrap } else { self.fill_got },
                fill_tag: if tx_miss { miss_tag } else { self.fill_tag },
                fill_line: if tx_miss { miss_line } else { self.fill_line },
                need_flush: flush | (self.need_flush & !flushing),
                flush_line: if flushing { (self.flush_line + 1) as u8 wrap } else { 0 },
                pix: if stepping { (self.pix + 1) as u6 wrap } else { 0 },
                rejected: reject,
                mask: if st == R_TEST {
                    0
                } else if drawn {
                    self.mask | ((0_u63 @ drawn) << self.zt_pix)
                } else {
                    self.mask
                },
                b_mask: if to_back {
                    self.mask
                } else if alpha_fail {
                    // A pixel the alpha test fails writes neither colour
                    // nor depth.
                    self.b_mask & (((0_u63 @ 1_u1) << c7.pix) ^ 0xFFFFFFFFFFFFFFFF)
                } else {
                    self.b_mask
                },
                zreq: if reading { (self.zreq + acc_z) as u2 wrap } else { 0 },
                zgot: if reading { (self.zgot + z_word) as u7 wrap } else { 0 },
                requested: if texeling & self.filling == 1 & !fill_done { self.requested | acc_fill } else { 0 },
                pres: if accepted == 1 { 0 } else { who },
                fsel: if to_back { !self.fsel } else { self.fsel },
                bsel: if to_back { self.fsel } else { self.bsel },
                csel: if b_handing { !self.csel } else { self.csel },
                fz: if to_back { if self.fz == 2 { 0 } else { (self.fz + 1) as u2 wrap } } else { self.fz },
                bz: if to_back { self.fz } else { self.bz },
                b_state: if to_back {
                    B_TEXEL
                } else if texel_done {
                    B_HANDOFF
                } else if b_handing {
                    B_FREE
                } else {
                    self.b_state
                },
                b_base: if to_back { block_base(self.bx, self.by) } else { self.b_base },
                b_blk: if to_back { blk } else { self.b_blk },
                b_bflags: if to_back { self.bflags } else { self.b_bflags },
                b_flags: if to_back { self.flags } else { self.b_flags },
                w_state: if b_handing {
                    1
                } else if run_done & self.w_run == 3 {
                    2
                } else if self.w_state == 2 {
                    0
                } else {
                    self.w_state
                },
                w_sel: if b_handing { self.csel } else { self.w_sel },
                w_z: if b_handing { self.bz } else { self.w_z },
                w_base: if b_handing { self.b_base } else { self.w_base },
                w_blk: if b_handing { self.b_blk } else { self.w_blk },
                w_mask: if b_handing { self.b_mask } else { self.w_mask },
                w_bflags: if b_handing {
                    self.b_bflags
                } else if run_done & self.w_run[0:0] == 1 & used {
                    // Both of this buffer's runs are out: the block is in
                    // SDRAM now.
                    self.w_bflags & (bank_bit(self.run_bank(draw)) ^ 0xF)
                } else {
                    self.w_bflags
                },
                w_en: if b_handing { self.b_flags[2:1] } else { self.w_en },
                w_run: if b_handing { 0 } else if run_done { next_run } else { self.w_run },
                w_pix: if b_handing {
                    0
                } else if run_done {
                    // The next run's half block.
                    next_run[0:0] @ 0_u5
                } else if writing {
                    read_ptr
                } else {
                    self.w_pix
                },
                w_requested: if writing & !run_done { self.w_requested | acc_writer } else { 0 },
                clear_colour: if st == R_IDLE & clearing == 1 { clear_in.colour } else { self.clear_colour },
                clear_colour_en: if st == R_IDLE & clearing == 1 { clear_in.colour_en } else { self.clear_colour_en },
                clear_depth_en: if st == R_IDLE & clearing == 1 { clear_in.depth_en } else { self.clear_depth_en },
                clear_blk: if st == R_CLEAR { (self.clear_blk + 1) as u12 wrap } else { 0 },
                cflags: self.cflags.next([flags_raddr, scan_block], flags_we, flags_waddr, flags_wdata),
                bflags: if st == R_DECIDE { self.cflags.value()[0] } else { self.bflags },
                clear_colours: if st == R_IDLE & clearing == 1 & clear_in.colour_en == 1 {
                    set_clear_colour(self.clear_colours, draw, clear_in.colour)
                } else {
                    self.clear_colours
                },
                tile: self.tile.next(self.w_sel @ read_ptr, tx_write, self.csel @ c7.pix, cwdata[23:19] @ cwdata[15:10] @ cwdata[7:3]),
                ztile: self.ztile.next([self.fz @ zraddr, self.w_z @ read_ptr], zwe, self.fz @ zwaddr, zwdata),
                stile: self.stile.next(self.bsel @ self.tx1_pix, self.zt_valid, self.fsel @ self.zt_pix, self.zt_shade),
                atile: self.atile.next(self.bsel @ self.tx_issue[5:0], t13.valid, self.fsel @ t13.pix, t13.entry),
                btile: self.btile.next(self.bsel @ self.tx_issue[5:0], t13.valid, self.fsel @ t13.pix, t13.entry2),
                ctag0: self.ctag0.next(tag_index(0, a1), (fill_done & tag_bank == 0) | flushing, tag_waddr, tag_wdata),
                ctag1: self.ctag1.next(tag_index(1, a1), (fill_done & tag_bank == 1) | flushing, tag_waddr, tag_wdata),
                ctag2: self.ctag2.next(tag_index(2, a1), (fill_done & tag_bank == 2) | flushing, tag_waddr, tag_wdata),
                ctag3: self.ctag3.next(tag_index(3, a1), (fill_done & tag_bank == 3) | flushing, tag_waddr, tag_wdata),
                cdata0: self.cdata0.next(bank_addr(0, a1), fill_word & data_bank == 0, data_waddr, zword),
                cdata1: self.cdata1.next(bank_addr(1, a1), fill_word & data_bank == 1, data_waddr, zword),
                cdata2: self.cdata2.next(bank_addr(2, a1), fill_word & data_bank == 2, data_waddr, zword),
                cdata3: self.cdata3.next(bank_addr(3, a1), fill_word & data_bank == 3, data_waddr, zword),
                seeds: self.seeds.next(normal[30:21]),
        }
    }
}

// The output buffer slot copied in COPY cycle c: E01, E12, E20 (0x00-0x02);
// A01, B01, A12, B12, A20, B20 (0x20-0x25); xs, ys, xmax, ymax (0x26-0x29);
// the R, G, B starts (0x2A-0x2C); R, G, B d/dx and d/dy (0x03-0x08); the Z
// start (0x2E), d/dx and d/dy (0x0B, 0x0C); then S', T' and Q, each its
// start (0x2F-0x31), d/dx and d/dy (0x0D-0x12). (The untextured program
// leaves those last nine slots as they were; they go unused.)
fn copy_slot(c: u6) -> u6 {
    if c < 3 {
        c
    } else if c < 16 {
        (0x1D + c) as u6 wrap
    } else if c < 22 {
        (c - 13) as u6 wrap
    } else if c == 22 {
        0x2E
    } else if c == 23 {
        0x0B
    } else if c == 24 {
        0x0C
    } else if c == 25 {
        0x2F
    } else if c == 26 {
        0x0D
    } else if c == 27 {
        0x0E
    } else if c == 28 {
        0x30
    } else if c == 29 {
        0x0F
    } else if c == 30 {
        0x10
    } else if c == 31 {
        0x31
    } else if c == 32 {
        0x11
    } else if c == 33 {
        0x12
    } else if c == 34 {
        0x2D
    } else if c == 35 {
        0x09
    } else if c == 36 {
        0x0A
    } else {
        0
    }
}

// An edge's registers after a COPY cycle: its value is slot `ei`, A slot
// `ai`, B slot `bi`.
fn copy_edge(e: EdgeState, got: u1, k: u6, word: i36, ei: u6, ai: u6, bi: u6) -> EdgeState {
    EdgeState {
        a: if got & k == ai { word as i17 wrap } else { e.a },
        b: if got & k == bi { word as i17 wrap } else { e.b },
        blk: if got & k == ei { word as i40 wrap } else { e.blk },
        ..e
    }
}

// A plane's registers after a COPY cycle: its start is slot `si`, d/dx
// `xi`, d/dy `yi`.
fn copy_plane(p: PlaneState, got: u1, k: u6, word: i36, si: u6, xi: u6, yi: u6) -> PlaneState {
    PlaneState {
        dx: if got & k == xi { word } else { p.dx },
        dy: if got & k == yi { word } else { p.dy },
        blk: if got & k == si { word } else { p.blk },
        ..p
    }
}

// 16 * x, for a Q13.4 count: the step to the next pixel.
fn times16(x: i17) -> i21 {
    ((x as u17 wrap) @ 0_u4) as i21 wrap
}

// 128 * x: the step to the next block.
fn times128(x: i17) -> i24 {
    ((x as u17 wrap) @ 0_u7) as i24 wrap
}

// An edge's registers, moved by `mode`.
fn step_edge(e: EdgeState, mode: u3) -> EdgeState {
    if mode == M_INIT {
        // The value copied is at the box's first pixel, which is the first
        // block's. A top or left edge's 0 is inside.
        EdgeState {
            tie: e.a > 0 | (e.a == 0 & e.b > 0),
            corner: corner(e.a, e.b),
            pix: e.blk,
            row: e.blk,
            blkrow: e.blk,
            ..e
        }
    } else if mode == M_BLOCK {
        EdgeState { pix: e.blk, row: e.blk, ..e }
    } else if mode == M_PIXEL {
        EdgeState { pix: (e.pix + times16(e.a)) as i40 wrap, ..e }
    } else if mode == M_ROW {
        let row = (e.row + times16(e.b)) as i40 wrap;
        EdgeState { pix: row, row: row, ..e }
    } else if mode == M_NEXT_COL {
        EdgeState { blk: (e.blk + times128(e.a)) as i40 wrap, ..e }
    } else if mode == M_NEXT_ROW {
        let blkrow = (e.blkrow + times128(e.b)) as i40 wrap;
        EdgeState { blk: blkrow, blkrow: blkrow, ..e }
    } else {
        e
    }
}

// 8 * x, wrapping: a plane's step to the next block.
fn times8(x: i36) -> i36 {
    ((x as u36 wrap)[32:0] @ 0_u3) as i36 wrap
}

// A plane's registers, moved by `mode`.
fn step_plane(p: PlaneState, mode: u3) -> PlaneState {
    if mode == M_INIT {
        PlaneState { pix: p.blk, row: p.blk, blkrow: p.blk, ..p }
    } else if mode == M_BLOCK {
        PlaneState { pix: p.blk, row: p.blk, ..p }
    } else if mode == M_PIXEL {
        PlaneState { pix: (p.pix + p.dx) as i36 wrap, ..p }
    } else if mode == M_ROW {
        let row = (p.row + p.dy) as i36 wrap;
        PlaneState { pix: row, row: row, ..p }
    } else if mode == M_NEXT_COL {
        PlaneState { blk: (p.blk + times8(p.dx)) as i36 wrap, ..p }
    } else if mode == M_NEXT_ROW {
        let blkrow = (p.blkrow + times8(p.dy)) as i36 wrap;
        PlaneState { blk: blkrow, blkrow: blkrow, ..p }
    } else {
        p
    }
}

// How far an edge's value rises from a block's first pixel to its other
// corners, seven pixels on: 112 * max(A, 0) + 112 * max(B, 0).
fn corner(a: i17, b: i17) -> i24 {
    let pa: u16 = if a > 0 { (a as u17 wrap)[15:0] } else { 0 };
    let pb: u16 = if b > 0 { (b as u17 wrap)[15:0] } else { 0 };
    // 112 * x = 128 * x - 16 * x.
    let ma = ((pa @ 0_u7) - (0_u3 @ pa @ 0_u4)) as u23 wrap;
    let mb = ((pb @ 0_u7) - (0_u3 @ pb @ 0_u4)) as u23 wrap;
    ((0_u1 @ ma) + (0_u1 @ mb)) as i24 wrap
}

// The edge's largest value over the block's four corner pixels is below
// 0: no pixel of the block is inside it.
fn outside(e: EdgeState) -> u1 {
    e.blk + e.corner < 0
}

// The current pixel is inside the edge: its value is positive, or 0 on a
// top or left edge.
fn inside(e: EdgeState) -> u1 {
    e.pix > 0 | (e.pix == 0 & e.tie == 1)
}

// An 8-bit channel's iterator count as 8 bits: over 2^16, rounded half
// up, clamped (models/setup/src/texture.rs `shade8`).
fn s8(v: i36) -> u8 {
    let q = (v + 32768) >> 16;
    if q < 0 {
        0
    } else if q > 255 {
        255
    } else {
        (q as u21 wrap)[7:0]
    }
}

// A 16-bit field, sign-extended to a vertex ring word.
fn sext16(v: u16) -> u36 {
    ((v as i16 wrap) as i36 wrap) as u36 wrap
}

// The depth plane's iterator count as a 16-bit depth: over 2^16, rounded
// half up, clamped.
fn depth(v: i36) -> u16 {
    let q = (v + 32768) >> 16;
    if q < 0 {
        0
    } else if q > 65535 {
        65535
    } else {
        (q as u21 wrap)[15:0]
    }
}

// A block's first word in the tiled framebuffer: (by * 80 + bx) * 64.
// A bank's bit in a block's cleared flags.
fn bank_bit(bank: u2) -> u4 {
    if bank == 0 {
        1
    } else if bank == 1 {
        2
    } else if bank == 2 {
        4
    } else {
        8
    }
}

// A colour buffer's clear colour (bank 2 in bits 47:32).
pub fn clear_colour_of(colours: u48, bank: u2) -> u16 {
    if bank == 0 {
        colours[15:0]
    } else if bank == 1 {
        colours[31:16]
    } else {
        colours[47:32]
    }
}

// The clear colours with one colour buffer's replaced.
fn set_clear_colour(colours: u48, bank: u2, colour: u16) -> u48 {
    if bank == 0 {
        colours[47:16] @ colour
    } else if bank == 1 {
        colours[47:32] @ colour @ colours[15:0]
    } else {
        colour @ colours[31:0]
    }
}

fn block_base(bx: i10, by: i10) -> u19 {
    let x = (bx as u10 wrap)[6:0];
    let y = (by as u10 wrap)[5:0];
    let index = ((0_u1 @ y @ 0_u6) + (0_u3 @ y @ 0_u4) + (0_u6 @ x)) as u13 wrap;
    index @ 0_u6
}

// TEX0_CFG's WIDTH_LOG2 or HEIGHT_LOG2 as used: 2 to 10.
fn log2_size(f: u4) -> u4 {
    if f < 2 {
        2
    } else if f > 10 {
        10
    } else {
        f
    }
}

// The leading zeros of a nonzero 32-bit value.
fn lz32(q: u32) -> u5 {
    if q[31:16] == 0 {
        if q[15:8] == 0 {
            (24 + (0_u2 @ lz8(q[7:0]))) as u5 wrap
        } else {
            (16 + (0_u2 @ lz8(q[15:8]))) as u5 wrap
        }
    } else if q[31:24] == 0 {
        (8 + (0_u2 @ lz8(q[23:16]))) as u5 wrap
    } else {
        0_u2 @ lz8(q[31:24])
    }
}

// The leading zeros of a byte (7 for 0 or 1).
fn lz8(b: u8) -> u3 {
    if b[7:7] == 1 {
        0
    } else if b[6:6] == 1 {
        1
    } else if b[5:5] == 1 {
        2
    } else if b[4:4] == 1 {
        3
    } else if b[3:3] == 1 {
        4
    } else if b[2:2] == 1 {
        5
    } else if b[1:1] == 1 {
        6
    } else {
        7
    }
}

// A texture coordinate in texels (4 fraction bits) from S' (or T') times
// the reciprocal: shifted left by 7 (here), then right by 0 to 39,
// rounding down, then saturated to 20 bits (texture.rs `coordinate`).
fn widen7(us: i43) -> i50 {
    ((us as u43 wrap) @ 0_u7) as i50 wrap
}

// A shifted texture coordinate, saturated to 20 bits.
fn saturate20(shifted: i50) -> i20 {
    if shifted < COORD_MIN {
        COORD_MIN as i20 wrap
    } else if shifted > COORD_MAX {
        COORD_MAX as i20 wrap
    } else {
        shifted as i20 wrap
    }
}

// 2^log2 - 1: a size's mask.
fn size_mask(log2: u4) -> u10 {
    (((1_u11 << log2) as u11 wrap) - 1) as u10 wrap
}

// The first column (or row) a sample takes, whole texels before
// wrapping, from the coordinate (4 fraction bits): nearest, the one it is
// in; bilinear, the one half a texel before it is in (texture.rs `taps`).
fn first_index(u: i20, bilinear: u1) -> i17 {
    if bilinear == 1 {
        (((u as i21 wrap) - 8) as i21 wrap) >> 4
    } else {
        (u as i21 wrap) >> 4
    }
}

// The column (or row) after it, before wrapping.
fn next_index(u: i20, bilinear: u1) -> i17 {
    if bilinear == 1 {
        (((u as i21 wrap) + 8) as i21 wrap) >> 4
    } else {
        (((u as i21 wrap) + 16) as i21 wrap) >> 4
    }
}

// The next column's (or row's) weight, sixteenths: bilinear, the fraction
// of the coordinate less half a texel; nearest, none.
fn weight(u: i20, bilinear: u1) -> u4 {
    if bilinear == 1 {
        (u as u20 wrap)[3:0] ^ 8
    } else {
        0
    }
}

// A texel index's texel along it, by its wrap mode: 0 repeat, 1 clamp to
// the edge, 2 mirror, 3 (reserved) repeat; the texture is 2^log2 texels
// along it, `size_mask` being 2^log2 - 1 (texture.rs `wrap_index`).
fn wrap_texel(ui: i17, log2: u4, size_mask: u10, mode: u2) -> u10 {
    let low = (ui as u17 wrap)[9:0];
    let flipped = (((ui as u17 wrap) >> log2)[0:0]) == 1;
    if mode == 1 {
        if ui < 0 {
            0
        } else if ui > (0_u7 @ size_mask) as i17 wrap {
            size_mask
        } else {
            low
        }
    } else if mode == 2 & flipped {
        (low & size_mask) ^ size_mask
    } else {
        low & size_mask
    }
}

// The cache tag of the block at block row `by` and column `bx`: the
// texture's base plus its block number, the row shifted by the width in
// blocks' log2.
fn block_tag(base: u20, by: u8, bx: u8, bshift: u4) -> u20 {
    (base + (0_u4 @ (((0_u8 @ by) << bshift) | (0_u8 @ bx)))) as u20 wrap
}

// Tag bank k's read address for a pixel's texel addresses (an `atile`
// entry): the line of whichever of the pixel's blocks is in that bank (by
// the parity of its column and row).
fn tag_index(k: u2, e: u64) -> u6 {
    let u = if e[20:20] == k[0:0] { e[23:18] } else { e[17:12] };
    let v = if e[8:8] == k[1:1] { e[11:6] } else { e[5:0] };
    v[5:3] @ u[5:3]
}

// Texel bank k's read address for an `atile` entry: whichever of the
// pixel's texels is in that bank (by the parity of its column and row).
fn bank_addr(k: u2, e: u64) -> u10 {
    let u = if e[18:18] == k[0:0] { e[23:18] } else { e[17:12] };
    let v = if e[6:6] == k[1:1] { e[11:6] } else { e[5:0] };
    v[5:2] @ u[5:2] @ v[1:1] @ u[1:1]
}

// Bank k's value of four.
fn pick21(k: u2, a: u21, b: u21, c: u21, d: u21) -> u21 {
    if k == 0 {
        a
    } else if k == 1 {
        b
    } else if k == 2 {
        c
    } else {
        d
    }
}

fn pick16(k: u2, a: u16, b: u16, c: u16, d: u16) -> u16 {
    if k == 0 {
        a
    } else if k == 1 {
        b
    } else if k == 2 {
        c
    } else {
        d
    }
}

// Each channel of b less a, 9 bits signed.
fn differences(b: u32, a: u32) -> u36 {
    (difference(b[31:24], a[31:24]) as u9 wrap)
        @ (difference(b[23:16], a[23:16]) as u9 wrap)
        @ (difference(b[15:8], a[15:8]) as u9 wrap)
        @ (difference(b[7:0], a[7:0]) as u9 wrap)
}

// d x f, f 0 to 15, by shifts and adds (|d| x 15 fits 17 bits).
fn times4(d: i13, f: u4) -> i17 {
    let w = d as i17 wrap;
    let a: i17 = if f[0:0] == 1 { w } else { 0 };
    let b: i17 = if f[1:1] == 1 { ((w as u17 wrap)[15:0] @ 0_u1) as i17 wrap } else { 0 };
    let c: i17 = if f[2:2] == 1 { ((w as u17 wrap)[14:0] @ 0_u2) as i17 wrap } else { 0 };
    let e: i17 = if f[3:3] == 1 { ((w as u17 wrap)[13:0] @ 0_u3) as i17 wrap } else { 0 };
    (a + b + c + e) as i17 wrap
}

// 16 x a + d x f: a blended towards a + d by f sixteenths (texture.rs
// `lerp16`), which is never negative nor over 16 bits here.
fn lerp16(a16: u16, d: i13, f: u4) -> u16 {
    (((0_u2 @ a16) as i18 wrap) + (times4(d, f) as i18 wrap)) as u16 wrap
}

// One channel of a row blended across: 12 bits, 4 fraction bits.
fn row(a: u8, d: u9, f: u4) -> u12 {
    lerp16(0_u4 @ a @ 0_u4, (d as i9 wrap) as i13 wrap, f)[11:0]
}

// Each channel of a row blended across.
fn rows(a: u32, d: u36, f: u4) -> u48 {
    row(a[31:24], d[35:27], f) @ row(a[23:16], d[26:18], f) @ row(a[15:8], d[17:9], f) @ row(a[7:0], d[8:0], f)
}

// One channel of the second row less the first, 13 bits signed.
fn row_difference(r1: u12, r0: u12) -> u13 {
    (((0_u1 @ r1) as i13 wrap) - ((0_u1 @ r0) as i13 wrap)) as u13 wrap
}

fn row_differences(r1: u48, r0: u48) -> u52 {
    row_difference(r1[47:36], r0[47:36])
        @ row_difference(r1[35:24], r0[35:24])
        @ row_difference(r1[23:12], r0[23:12])
        @ row_difference(r1[11:0], r0[11:0])
}

// One channel of the rows blended down, rounded to 8 bits.
fn blend1(r0: u12, dv: u13, f: u4) -> u8 {
    ((lerp16(r0 @ 0_u4, dv as i13 wrap, f) + 128) as u16 wrap)[15:8]
}

// The sample: the rows blended down, each channel (texture.rs `filter`).
fn blend(r0: u48, dv: u52, f: u4) -> u32 {
    blend1(r0[47:36], dv[51:39], f) @ blend1(r0[35:24], dv[38:26], f) @ blend1(r0[23:12], dv[25:13], f) @ blend1(r0[11:0], dv[12:0], f)
}

// A texel as 8 bits a channel, R @ G @ B @ A: RGB565 with each field's
// bits repeated and opaque, or ARGB4444 with each nibble repeated
// (texture.rs `decode`).
fn decode(t: u16, argb: u1) -> u32 {
    if argb == 1 {
        t[11:8] @ t[11:8] @ t[7:4] @ t[7:4] @ t[3:0] @ t[3:0] @ t[15:12] @ t[15:12]
    } else {
        t[15:11] @ t[15:13] @ t[10:5] @ t[10:9] @ t[4:0] @ t[4:2] @ 0xFF_u8
    }
}

// Channel k (0 R, 1 G, 2 B, 3 A) of an RGBA8888 value.
fn channel(x: u32, k: u2) -> u8 {
    if k == 0 {
        x[31:24]
    } else if k == 1 {
        x[23:16]
    } else if k == 2 {
        x[15:8]
    } else {
        x[7:0]
    }
}

// A combiner input's channel k, by its code (host-interface.md §7): 1 the
// texel, 3 the shade, 4 CONST0, 5 CONST1, 6 one, 7 zero; where `broadcast`
// (RGB_C), 8, 10 and 11 the texel's, shade's and CONST0's alpha; anything
// else 0 (texture.rs `combine`).
fn operand(code: u4, broadcast: u1, k: u2, tex: u32, shade: u32, c0: u32, c1: u32) -> u8 {
    if code == 1 {
        channel(tex, k)
    } else if code == 3 {
        channel(shade, k)
    } else if code == 4 {
        channel(c0, k)
    } else if code == 5 {
        channel(c1, k)
    } else if code == 6 {
        255
    } else if broadcast == 1 & code == 8 {
        tex[7:0]
    } else if broadcast == 1 & code == 10 {
        shade[7:0]
    } else if broadcast == 1 & code == 11 {
        c0[7:0]
    } else {
        0
    }
}

// A - B, signed.
fn difference(a: u8, b: u8) -> i9 {
    (((0_u1 @ a) as i9 wrap) - ((0_u1 @ b) as i9 wrap)) as i9 wrap
}

// (A - B) x C, C stretched.
fn product(diff: i9, c: u9) -> i20 {
    (diff as i10 wrap) * ((0_u1 @ c) as i10 wrap)
}

// D + ((A - B) x C + 128) / 256 rounded down, clamped to 0 to 255.
fn finish(p: i20, d: u8) -> u8 {
    let v = ((p + 128) >> 8) + ((0_u1 @ d) as i9 wrap);
    if v < 0 {
        0
    } else if v > 255 {
        255
    } else {
        (v as u14 wrap)[7:0]
    }
}

// A channel stretched from 0 to 255 to 0 to 256, so that 255 is 1.
fn stretch(c: u8) -> u9 {
    ((0_u1 @ c) + (0_u8 @ c[7:7])) as u9 wrap
}

