// The front and back of the triangle pipeline around the setup engine
// (docs/design/triangle-pipeline.md §6, docs/design/host-interface.md):
//
//   Parser  takes register transactions (ADR 0008) from the built-in scene
//           ROM, or from the host link's FIFO while a host is connected:
//           latches ATTR0 and RENDER_MODE, writes each vertex into the setup
//           engine's ring and starts the triangles its kicks make,
//           carries out FRAME's present and clears, and reads and writes
//           GPU memory for MEM_DATA, four words at a time, once the
//           pipeline is idle. The ROM scene loops.
//   Raster  clears a frame (colour, depth or both), or copies a set-up
//           triangle out of the engine's output buffer and walks its bounding
//           box in 8x8 blocks: it reads a block's depths, steps the edge
//           functions and the colour, depth and texture planes one pixel per
//           clock into tile buffers, depth-tests each pixel, and for a
//           textured triangle works out each pixel's texel address (a
//           pipelined divide by Q); then, textured, it looks each drawn
//           pixel's texel up in the texture cache (fetching a missing 4x4
//           block from SDRAM) and multiplies it by the shade; and writes the
//           block's colours and depths back, each half block with a drawn
//           pixel as one masked 32-word SDRAM run, as the triangle's render
//           mode allows.
//
// The golden model is models/setup's reference renderer (render.rs) on what
// scene.rs's `interpret` makes of the same transactions; the frame tests
// compare the framebuffer with it pixel for pixel.
//
// Both are plain structs inlined into the GPU, not #[module]s: each has
// `out`, its outputs from its registers alone, and `next`, its next state
// from its inputs. The GPU needs their outputs before it can step the
// setup engine and the SDRAM controller, whose outputs are their inputs.

use root::sdram::SdramReq;
use root::setup::Start;
use root::setup::VertexWrite;

// Register addresses (docs/design/host-interface.md §3).
const REG_ATTR0: u8 = 0x00;
const REG_VERTEX_NOKICK: u8 = 0x06;
const REG_VERTEX_KICK_FAN: u8 = 0x09;
const REG_TEX0_CFG: u8 = 0x10;
const REG_CC_MODE: u8 = 0x18;
const REG_CONST0: u8 = 0x19;
const REG_CONST1: u8 = 0x1B;
const REG_RENDER_MODE: u8 = 0x30;
const REG_FRAME: u8 = 0x40;
const REG_MEM_ADDR: u8 = 0x70;
const REG_MEM_DATA: u8 = 0x71;

// The scene ROM's end marker (models/setup/src/scene.rs): start again.
const ROM_END: u8 = 0xFF;

// Kicks, as a vertex register's address less VERTEX_NOKICK's.
const KICK_NONE: u2 = 0;
const KICK_012: u2 = 1;
const KICK_021: u2 = 2;

// RENDER_MODE's reset value: depth tested and written, colour written.
const MODE_RESET: u27 = 0x1C;

// CC_MODE's reset value, texture x shade; and the constants', opaque white.
const CC_RESET: u32 = 0x73717371;
const CONST_RESET: u32 = 0xFFFFFFFF;

// Parser states.
const P_FETCH: u4 = 0;
const P_DECODE: u4 = 1;
const P_EXEC: u4 = 2;
const P_WRITE: u4 = 3;
const P_START: u4 = 4;
const P_PRESENT: u4 = 5;
const P_CLEAR: u4 = 6;
const P_READ: u4 = 7;
const P_MEM: u4 = 8;
// TEX0_CFG, CC_MODE, CONST0 or CONST1: waiting for the pipeline to be idle.
const P_STATE: u4 = 9;

// A MEM_DATA access, in P_MEM: waiting for the pipeline to be idle, its run
// waiting to be accepted, then its four words moving.
const M_WAIT: u2 = 0;
const M_REQ: u2 = 1;
const M_MOVE: u2 = 2;

// Words in a MEM_DATA access: 64 bits.
const MEM_WORDS: u6 = 4;

// Raster states.
const R_IDLE: u4 = 0;
const R_COPY: u4 = 1;
const R_INIT: u4 = 2;
const R_TEST: u4 = 3;
const R_PIXELS: u4 = 4;
const R_WRITE: u4 = 5;
const R_NEXT: u4 = 6;
const R_DECIDE: u4 = 7;
const R_ZREAD: u4 = 8;
const R_CLEAR: u4 = 9;
const R_DRAIN: u4 = 10;
const R_TEXEL: u4 = 11;
const R_FLUSH: u4 = 12;

// DRAIN: cycles after a block's last pixel until its depth test is done,
// and until its texel address is (the texture pipeline's depth).
const DRAIN_PLAIN: u4 = 0;
const DRAIN_TEXTURED: u4 = 11;

// The largest reciprocal of Q, so that it fits 17 bits.
const R_MAX: u17 = 0x1FFFF;

// A texel coordinate's range: 20 bits, signed (4 fraction bits).
const COORD_MIN: i50 = -524288;
const COORD_MAX: i50 = 524287;

// How the edge and plane registers move this cycle.
const M_INIT: u3 = 0;
const M_BLOCK: u3 = 1;
const M_PIXEL: u3 = 2;
const M_ROW: u3 = 3;
const M_NEXT_COL: u3 = 4;
const M_NEXT_ROW: u3 = 5;
const M_HOLD: u3 = 6;

// Output buffer slots copied, in order (see copy_slot).
const COPY_SLOTS: u6 = 37;

// The depth buffer's SDRAM bank (ADR 0003), and what a clear sets it to.
const DEPTH_BANK: u2 = 3;
const FAR: u16 = 0xFFFF;

// The framebuffer's last half block: 3,600 blocks of two.
const LAST_HALF_BLOCK: u13 = 7199;

// A clear of the frame being drawn: its colour, and which buffers.
pub struct ClearCmd {
    pub colour: u16 = 0,
    pub colour_en: u1 = 0,
    pub depth_en: u1 = 0,
}

pub struct ParserOut {
    pub load: Option<VertexWrite>,
    pub start: Option<Start>,
    pub clear: Option<ClearCmd>,
    // The frame being drawn is done: hand it to the display.
    pub frame_done: u1,
    // Waiting to present.
    pub ending: u1,
    // Taking the head of the host link's FIFO.
    pub pop: u1,
    // A read of this register, waiting for the link to take its value.
    pub read: Option<u7>,
    // RENDER_MODE (bits 26:0): its write enables, depth test and alpha
    // test go with each triangle started, and a read returns it.
    pub mode: u27,
    // MEM_DATA's run, held until accepted, and the word to write, taken on
    // `wtake`; MEM_ADDR, and the last 64 bits MEM_DATA read.
    pub mem_req: Option<SdramReq>,
    pub mem_wdata: u16,
    pub mem_addr: u22,
    pub mem_rdata: u64,
    // TEX0_CFG, which changes only with the pipeline idle; and a pulse:
    // the texture cache must be emptied before the next triangle (memory
    // has been written).
    pub tex: u64,
    pub flush: u1,
    // CC_MODE's pass 0, CONST0 and CONST1, which like TEX0_CFG change only
    // with the pipeline idle.
    pub cc: u32,
    pub const0: u32,
    pub const1: u32,
}

pub struct Parser {
    state: u4 = 0,
    // Taking transactions from the host link (else the ROM), and the next
    // ROM entry.
    from_host: u1 = 0,
    pc: u11 = 0,
    // The transaction being carried out.
    #[no_reset]
    t_addr: u8 = 0,
    #[no_reset]
    t_data: u64 = 0,
    // The latched registers.
    attr: u64 = 0,
    mode: u27 = 0x1C,
    cc: u32 = 0x73717371,
    const0: u32 = 0xFFFFFFFF,
    const1: u32 = 0xFFFFFFFF,
    // The primitive: whether the last vertex was a kick (as after reset),
    // its vertices so far (to 3), whether it is a fan (its third vertex
    // was a KICK_FAN), and this vertex's kick.
    kicked: u1 = 1,
    count: u2 = 0,
    fan: u1 = 0,
    kick: u2 = 0,
    // The ring slots of the vertex two back, one back, and this one.
    s0: u2 = 0,
    s1: u2 = 0,
    s2: u2 = 3,
    // The vertex field being written (0 to 9).
    field: u4 = 0,
    // GPU memory: MEM_ADDR (in 64-bit units), a MEM_DATA access's step and
    // its words moved so far, and the 64 bits read (the first word in bits
    // 15:0).
    mem_addr: u22 = 0,
    mem_step: u2 = 0,
    mem_i: u2 = 0,
    #[no_reset]
    mem_rdata: u64 = 0,
    tex: u64 = 0,
    flush: u1 = 0,
    // The registered outputs.
    load_valid: u1 = 0,
    start_valid: u1 = 0,
    clear_valid: u1 = 0,
    frame_done: u1 = 0,
    #[no_reset]
    load: VertexWrite,
    #[no_reset]
    start: Start,
    #[no_reset]
    clear: ClearCmd,
    // The scene (generated: build/gen/scene_*.hex): each transaction's
    // address byte and data.
    #[storage(bram)]
    #[no_reset]
    rom_addr: rom<u8, 2048> = include_hex!("../build/gen/scene_addr.hex"),
    #[storage(bram)]
    #[no_reset]
    rom_data: rom<u64, 2048> = include_hex!("../build/gen/scene_data.hex"),
}

impl Parser {
    // The outputs, from the registers.
    pub fn out(self) -> ParserOut {
        ParserOut {
            load: if self.load_valid == 1 { Some(self.load) } else { None },
            start: if self.start_valid == 1 { Some(self.start) } else { None },
            clear: if self.clear_valid == 1 { Some(self.clear) } else { None },
            frame_done: self.frame_done,
            ending: (self.state == P_PRESENT),
            pop: (self.state == P_DECODE & self.from_host == 1),
            read: if self.state == P_READ { Some(self.t_addr[6:0]) } else { None },
            mode: self.mode,
            mem_req: if self.state == P_MEM & self.mem_step == M_REQ {
                Some(SdramReq { write: !self.t_addr[7:7], addr: self.mem_addr @ 0_u2, len: MEM_WORDS })
            } else {
                None
            },
            mem_wdata: if self.mem_i == 0 {
                self.t_data[15:0]
            } else if self.mem_i == 1 {
                self.t_data[31:16]
            } else if self.mem_i == 2 {
                self.t_data[47:32]
            } else {
                self.t_data[63:48]
            },
            mem_addr: self.mem_addr,
            mem_rdata: self.mem_rdata,
            tex: self.tex,
            flush: self.flush,
            cc: self.cc,
            const0: self.const0,
            const1: self.const1,
        }
    }

    // `enable`: parse (after the framebuffer fill). `free`: the setup
    // engine can take a triangle: idle, and its last outputs copied.
    // `ring_free`: no triangle is using the vertex ring. `clear_ok`: the
    // pipeline is idle. `present_ok`: idle, and the display can take a
    // frame. `link`: the host link's outputs: its FIFO's head, whether a
    // host is connected, and whether it can take a read's reply. `mem_*`:
    // the SDRAM's answers to MEM_DATA's run: accepted, a word taken, a word
    // read.
    pub fn next(
        self,
        enable: u1,
        free: u1,
        ring_free: u1,
        clear_ok: u1,
        present_ok: u1,
        link_enabled: u1,
        head_avail: u1,
        head_addr: u8,
        head_data: u64,
        reply_busy: u1,
        mem_accepted: u1,
        mem_wtake: u1,
        mem_word: Option<u16>,
    ) -> Self {
        let st = self.state;

        // ---- FETCH: the next transaction's source. A host that has gone
        // hands back to the ROM, which starts again from its beginning. --
        let host_gone = st == P_FETCH & self.from_host == 1 & link_enabled == 0;
        let fetching = st == P_FETCH & enable == 1 & !host_gone & (self.from_host == 0 | head_avail == 1);

        // ---- DECODE: the ROM's word, or the FIFO's head, into registers.
        // Nothing is decided from it until EXEC: a block RAM's output is
        // too slow to choose the ROM's next address in the same cycle. ----
        let addr: u8 = if self.from_host == 1 { head_addr } else { self.rom_addr.value() };
        let data: u64 = if self.from_host == 1 { head_data } else { self.rom_data.value() };
        let rom_end = st == P_EXEC & self.from_host == 0 & self.t_addr == ROM_END;

        // ---- EXEC. ------------------------------------------------------
        let a = self.t_addr;
        let is_vertex = a >= REG_VERTEX_NOKICK & a <= REG_VERTEX_KICK_FAN;
        // 0x06 to 0x09 end in 2, 3, 0, 1.
        let kick: u2 = (a[1:0] + 2) as u2 wrap;
        let new_prim = kick == KICK_NONE & self.kicked == 1;
        // A new primitive starts again from slot 0, which the last triangle
        // may still be using: wait for the ring.
        let vertex_go = st == P_EXEC & is_vertex & (!new_prim | ring_free == 1);
        let count: u2 = if new_prim { 1 } else if self.count == 3 { 3 } else { (self.count + 1) as u2 wrap };
        // A vertex's slot is one no triangle still needs: a strip cycles
        // through 0 to 3; a fan keeps 0 for its first vertex and cycles
        // the rest through 1 to 3.
        let new_slot: u2 = if new_prim {
            0
        } else if self.fan == 1 & self.s2 == 3 {
            1
        } else {
            (self.s2 + 1) as u2 wrap
        };
        let present = self.t_data[0:0];
        let clears = self.t_data[2:1] != 0;
        let is_frame = a == REG_FRAME;

        // ---- WRITE: the vertex's ten fields, one a cycle: position and
        // Z and Q from the register, colour and S'T' from ATTR0. ----------
        let d = self.t_data;
        let attr = self.attr;
        let f = self.field;
        let value: u36 = if f == 0 {
            sext16(d[63:48])
        } else if f == 1 {
            sext16(d[47:32])
        } else if f == 2 {
            0_u28 @ attr[63:56]
        } else if f == 3 {
            0_u28 @ attr[55:48]
        } else if f == 4 {
            0_u28 @ attr[47:40]
        } else if f == 5 {
            0_u28 @ attr[39:32]
        } else if f == 6 {
            0_u20 @ d[31:16]
        } else if f == 7 {
            sext16(attr[31:16])
        } else if f == 8 {
            sext16(attr[15:0])
        } else {
            0_u20 @ d[15:0]
        };
        let last_field = st == P_WRITE & f == 9;
        let draws = self.kick != KICK_NONE & self.count == 3;

        // ---- START: the triangle's roles by its kick; its cull mode and
        // program from RENDER_MODE. ----------------------------------------
        let starting = st == P_START & free == 1;
        let roles: u6 = if self.kick == KICK_012 {
            self.s0 @ self.s1 @ self.s2
        } else if self.kick == KICK_021 {
            self.s0 @ self.s2 @ self.s1
        } else {
            0_u2 @ self.s1 @ self.s2
        };
        let cull: u2 = if self.mode[6:5] == 3 { 0 } else { self.mode[6:5] };

        let presenting = st == P_PRESENT & present_ok == 1;
        let latching = st == P_STATE & clear_ok == 1;
        let clearing = st == P_CLEAR & clear_ok == 1;
        let replied = st == P_READ & (reply_busy == 0 | link_enabled == 0);

        // ---- MEM: MEM_DATA, written (from either source) or read (from a
        // host), once everything before it is drawn. ----------------------
        let is_mem_data = (0_u1 @ a[6:0]) == REG_MEM_DATA;
        let mem_read = a[7:7] == 1;
        let in_mem = st == P_MEM;
        let (got_word, word) = match mem_word {
            Some(w) => (1_u1, w),
            None => (0_u1, 0_u16),
        };
        let moved = in_mem & self.mem_step == M_MOVE & ((!mem_read & mem_wtake == 1) | (mem_read & got_word == 1));
        let mem_done = moved & self.mem_i == 3;

        let state: u4 = if st == P_FETCH {
            if fetching { P_DECODE } else { P_FETCH }
        } else if st == P_DECODE {
            P_EXEC
        } else if st == P_EXEC {
            if rom_end {
                P_FETCH
            } else if is_mem_data & (a[7:7] == 0 | self.from_host == 1) {
                P_MEM
            } else if a == REG_TEX0_CFG | a == REG_CC_MODE | a == REG_CONST0 | a == REG_CONST1 {
                P_STATE
            } else if a[7:7] == 1 {
                if self.from_host == 1 { P_READ } else { P_FETCH }
            } else if is_vertex {
                if vertex_go { P_WRITE } else { P_EXEC }
            } else if is_frame & present == 1 {
                P_PRESENT
            } else if is_frame & clears {
                P_CLEAR
            } else {
                P_FETCH
            }
        } else if st == P_WRITE {
            if !last_field { P_WRITE } else if draws { P_START } else { P_FETCH }
        } else if st == P_START {
            if starting { P_FETCH } else { P_START }
        } else if st == P_PRESENT {
            if !presenting { P_PRESENT } else if clears { P_CLEAR } else { P_FETCH }
        } else if st == P_CLEAR {
            if clearing { P_FETCH } else { P_CLEAR }
        } else if in_mem {
            if !mem_done { P_MEM } else if mem_read { P_READ } else { P_FETCH }
        } else if st == P_STATE {
            if clear_ok == 1 { P_FETCH } else { P_STATE }
        } else if replied {
            P_FETCH
        } else {
            P_READ
        };
        let exec_plain = st == P_EXEC & a[7:7] == 0;
        let next_pc: u11 = if host_gone | rom_end {
            0
        } else if st == P_DECODE & self.from_host == 0 {
            (self.pc + 1) as u11 wrap
        } else {
            self.pc
        };

        Self {
            state: state,
            // The ROM hands over to a host only at a present, so a frame is
            // never half from each.
            from_host: if host_gone {
                0
            } else if presenting & self.from_host == 0 & link_enabled == 1 {
                1
            } else {
                self.from_host
            },
            pc: next_pc,
            t_addr: if st == P_DECODE { addr } else { self.t_addr },
            t_data: if st == P_DECODE { data } else { self.t_data },
            attr: if exec_plain & a == REG_ATTR0 { self.t_data } else { self.attr },
            mode: if host_gone {
                MODE_RESET
            } else if exec_plain & a == REG_RENDER_MODE {
                self.t_data[26:0]
            } else {
                self.mode
            },
            kicked: if host_gone { 1 } else if vertex_go { (kick != KICK_NONE) } else { self.kicked },
            count: if host_gone { 0 } else if vertex_go { count } else { self.count },
            fan: if host_gone {
                0
            } else if vertex_go & new_prim {
                0
            } else if vertex_go & self.count == 2 {
                (a == REG_VERTEX_KICK_FAN)
            } else {
                self.fan
            },
            kick: if vertex_go { kick } else { self.kick },
            s0: if vertex_go { self.s1 } else { self.s0 },
            s1: if vertex_go { self.s2 } else { self.s1 },
            s2: if vertex_go { new_slot } else { self.s2 },
            field: if st == P_WRITE { (self.field + 1) as u4 wrap } else { 0 },
            mem_addr: if host_gone {
                0
            } else if exec_plain & a == REG_MEM_ADDR {
                self.t_data[21:0]
            } else if mem_done {
                (self.mem_addr + 1) as u22 wrap
            } else {
                self.mem_addr
            },
            mem_step: if !in_mem {
                M_WAIT
            } else if self.mem_step == M_WAIT & clear_ok == 1 {
                M_REQ
            } else if self.mem_step == M_REQ & mem_accepted == 1 {
                M_MOVE
            } else {
                self.mem_step
            },
            mem_i: if !in_mem { 0 } else if moved { (self.mem_i + 1) as u2 wrap } else { self.mem_i },
            // TEX0_CFG, CC_MODE, CONST0 and CONST1 wait for the triangles
            // before them to be drawn.
            tex: if host_gone {
                0
            } else if latching & self.t_addr == REG_TEX0_CFG {
                self.t_data
            } else {
                self.tex
            },
            cc: if host_gone {
                CC_RESET
            } else if latching & self.t_addr == REG_CC_MODE {
                self.t_data[31:0]
            } else {
                self.cc
            },
            const0: if host_gone {
                CONST_RESET
            } else if latching & self.t_addr == REG_CONST0 {
                self.t_data[31:0]
            } else {
                self.const0
            },
            const1: if host_gone {
                CONST_RESET
            } else if latching & self.t_addr == REG_CONST1 {
                self.t_data[31:0]
            } else {
                self.const1
            },
            // The cache's tags are whole addresses, so only new memory
            // contents make it stale, not a new texture.
            flush: host_gone | (mem_done & !mem_read),
            mem_rdata: if in_mem & mem_read & got_word == 1 { word @ self.mem_rdata[63:16] } else { self.mem_rdata },
            load_valid: (st == P_WRITE),
            start_valid: starting,
            clear_valid: clearing,
            frame_done: presenting,
            load: VertexWrite { slot: self.s2, field: f, value: value },
            start: Start { roles: roles, cull: cull, untextured: !self.tex[0:0] },
            clear: ClearCmd { colour: self.t_data[31:16], colour_en: self.t_data[1:1], depth_en: self.t_data[2:2] },
            rom_addr: self.rom_addr.next(next_pc),
            rom_data: self.rom_data.next(next_pc),
        }
    }
}

pub struct RasterOut {
    // The setup engine's output buffer slot to read.
    pub out_raddr: u6,
    // A kept triangle's outputs are waiting to be copied: the engine must
    // not start another.
    pub pending: u1,
    // Clearing, or copying or drawing a triangle.
    pub busy: u1,
    // A run, held until `accepted`.
    pub req: Option<SdramReq>,
    // The word, and whether to leave it as it was, taken on `wtake`.
    pub wdata: u16,
    pub wmask: u1,
}

// One edge function: A and B (Q13.4 counts), whether a value of 0 is
// inside (a top or left edge), and its value (Q26.8 counts, widened) at
// the current pixel, the current pixel row's start, the current block's
// start, and the current block row's start.
struct EdgeState {
    a: i17 = 0,
    b: i17 = 0,
    tie: u1 = 0,
    // How far the edge's value can rise from a block's first pixel to its
    // other corners: 112 * max(A, 0) + 112 * max(B, 0).
    corner: i24 = 0,
    pix: i40 = 0,
    row: i40 = 0,
    blk: i40 = 0,
    blkrow: i40 = 0,
}

// One plane (a colour, or depth): d/dx and d/dy, and its value (36-bit
// iterator counts, wrapping) at the current pixel, pixel row, block and
// block row.
struct PlaneState {
    dx: i36 = 0,
    dy: i36 = 0,
    pix: i36 = 0,
    row: i36 = 0,
    blk: i36 = 0,
    blkrow: i36 = 0,
}

pub struct Raster {
    state: u4 = 0,
    pending: u1 = 0,
    // COPY: the slot being addressed.
    copy: u6 = 0,
    // The bounding box (Q12.4 counts), its first and last blocks, and the
    // current block.
    #[no_reset]
    xs: i16 = 0,
    #[no_reset]
    ys: i16 = 0,
    #[no_reset]
    xmax: i16 = 0,
    #[no_reset]
    ymax: i16 = 0,
    #[no_reset]
    bx0: i10 = 0,
    #[no_reset]
    bx1: i10 = 0,
    #[no_reset]
    by1: i10 = 0,
    #[no_reset]
    bx: i10 = 0,
    #[no_reset]
    by: i10 = 0,
    #[no_reset]
    e0: EdgeState,
    #[no_reset]
    e1: EdgeState,
    #[no_reset]
    e2: EdgeState,
    #[no_reset]
    pr: PlaneState,
    #[no_reset]
    pg: PlaneState,
    #[no_reset]
    pb: PlaneState,
    #[no_reset]
    pz: PlaneState,
    #[no_reset]
    ps: PlaneState,
    #[no_reset]
    pt: PlaneState,
    #[no_reset]
    pq: PlaneState,
    #[no_reset]
    pa: PlaneState,
    // PIXELS: the pixel (py @ px); WRITE and CLEAR: the word being sent.
    pix: u6 = 0,
    // The depth test, a cycle after PIXELS: the pixel, whether it is
    // covered, its depth and its shade (8 bits a channel).
    zt_valid: u1 = 0,
    #[no_reset]
    zt_pix: u6 = 0,
    #[no_reset]
    zt_cov: u1 = 0,
    #[no_reset]
    zt_z: u16 = 0,
    #[no_reset]
    zt_shade: u32 = 0,
    // DRAIN: cycles left.
    drain: u4 = 0,
    // TEX0_CFG decoded, a cycle behind it (it only changes while this unit
    // is idle): textured; ARGB4444; log2 of the width and height (2 to 10)
    // and each as a mask; the width's log2 less 2 (blocks across); the
    // wrap modes; the base address over 16.
    tc_textured: u1 = 0,
    tc_argb: u1 = 0,
    tc_lw: u4 = 2,
    tc_lh: u4 = 2,
    tc_wmask: u10 = 3,
    tc_hmask: u10 = 3,
    tc_bshift: u4 = 0,
    tc_uwrap: u2 = 0,
    tc_vwrap: u2 = 0,
    tc_base: u20 = 0,
    // CC_MODE's pass 0, CONST0 and CONST1, a cycle behind the parser's.
    tc_cc: u32 = 0x73717371,
    tc_const0: u32 = 0xFFFFFFFF,
    tc_const1: u32 = 0xFFFFFFFF,
    // The texel address pipeline, twelve stages from a pixel's S', T' and
    // Q to its texel's place in memory and the cache.
    #[no_reset]
    tp1: TexStage,
    #[no_reset]
    tp2: TexStage,
    #[no_reset]
    tp3: TexStage,
    #[no_reset]
    tp4: TexStage,
    #[no_reset]
    tp5: TexStage,
    #[no_reset]
    tp6: TexStage,
    #[no_reset]
    tp7: TexStage,
    #[no_reset]
    tp8: TexStage,
    #[no_reset]
    tp9: TexStage,
    #[no_reset]
    tp10: TexStage,
    #[no_reset]
    tp11: TexStage,
    #[no_reset]
    tp12: TexStage,
    // TEXEL: the next pixel to look up; then five stages: the address
    // read, the cache read, the hit test (and the shade stretched to 0 to
    // 256), texture x shade, and the colour tile's write.
    tx_issue: u7 = 0,
    tx1_valid: u1 = 0,
    #[no_reset]
    tx1_pix: u6 = 0,
    tx2_valid: u1 = 0,
    #[no_reset]
    tx2_pix: u6 = 0,
    #[no_reset]
    tx2_addr: u32 = 0,
    #[no_reset]
    tx2_drawn: u1 = 0,
    tx3_valid: u1 = 0,
    #[no_reset]
    tx3_pix: u6 = 0,
    #[no_reset]
    tx3_addr: u32 = 0,
    #[no_reset]
    tx3_drawn: u1 = 0,
    #[no_reset]
    tx3_tag: u21 = 0,
    #[no_reset]
    tx3_texel: u16 = 0,
    #[no_reset]
    tx3_shade: u32 = 0,
    // Then the combiner: its inputs; A, B, C (stretched to 0 to 256) and D
    // for each channel; (A - B) x C, and D; the result; and the alpha test
    // with the colour tile's write. Channels R, G, B, A from the top.
    tx4_valid: u1 = 0,
    tx5_valid: u1 = 0,
    tx6_valid: u1 = 0,
    tx7_valid: u1 = 0,
    #[no_reset]
    tx4: CombStage,
    #[no_reset]
    tx5: CombStage,
    #[no_reset]
    tx6: CombStage,
    #[no_reset]
    tx7: CombStage,
    // TEXEL: a missing block being fetched, the words of it so far, and
    // which line and tag it goes to.
    filling: u1 = 0,
    fill_got: u5 = 0,
    #[no_reset]
    fill_tag: u20 = 0,
    #[no_reset]
    fill_line: u8 = 0,
    // The cache must be emptied before the next triangle (as after reset,
    // when its tags are unknown); FLUSH: the line being emptied.
    need_flush: u1 = 1,
    flush_line: u8 = 0,
    // Which of the block's pixels are drawn (covered and nearer).
    #[no_reset]
    mask: u64 = 0,
    // TEST's verdict, acted on in DECIDE.
    rejected: u1 = 0,
    // ZREAD: depth runs requested (0 to 2), and depths received.
    zreq: u2 = 0,
    zgot: u7 = 0,
    // WRITE: the run (bit 0 the half block, bit 1 depth rather than
    // colour); WRITE and CLEAR: whether its request has been taken.
    run: u2 = 0,
    requested: u1 = 0,
    // CLEAR: the colour, which buffers, the half block, and whether this
    // is its depth run.
    #[no_reset]
    clear_colour: u16 = 0,
    clear_colour_en: u1 = 0,
    clear_depth_en: u1 = 0,
    clear_hb: u13 = 0,
    clear_z: u1 = 0,
    // RENDER_MODE's COLOR_WRITE, Z_WRITE and Z_TEST (bits 2 to 0) for the
    // triangle being drawn, and for the one waiting to be copied.
    flags: u13 = 7,
    pending_flags: u13 = 7,
    // The block's colours and depths, in raster order.
    #[storage(lutram)]
    #[no_reset]
    tile: mem<u16, 64> = 0,
    #[storage(lutram)]
    #[no_reset]
    ztile: mem<u16, 64> = 0,
    // The block's shades and texel addresses (the texel's tag, cache line
    // and place in its block), in raster order.
    #[storage(lutram)]
    #[no_reset]
    stile: mem<u32, 64> = 0,
    #[storage(lutram)]
    #[no_reset]
    atile: mem<u32, 64> = 0,
    // The texture cache: 256 lines, each a 4x4 block of texels, line
    // (by mod 16, bx mod 16); each line's tag is valid @ the block's word
    // address over 16.
    #[storage(bram)]
    #[no_reset]
    ctag: mem<u21, 256> = 0,
    #[storage(bram)]
    #[no_reset]
    cdata: mem<u16, 4096> = 0,
    // 1 / x seeds for the divide by Q: setup's table.
    #[storage(bram)]
    #[no_reset]
    seeds: rom<u18, 1024> = include_hex!("../build/gen/setup_seed.hex"),
}

// One stage of the combiner's pipeline, after the texel pass's hit test
// (each stage's valid bit is a register of its own). Not every field means
// something at every stage.
struct CombStage {
    pix: u6 = 0,
    // The pixel was drawn by the depth test.
    drawn: u1 = 0,
    // The inputs, RGBA8888: texel and shade.
    tex: u32 = 0,
    shade: u32 = 0,
    // A - B for each channel (9 bits, signed), D (RGBA8888), and C
    // stretched, 9 bits a channel.
    dr: i9 = 0,
    dg: i9 = 0,
    db: i9 = 0,
    da: i9 = 0,
    c: u36 = 0,
    d: u32 = 0,
    // (A - B) x C for each channel.
    pr: i20 = 0,
    pg: i20 = 0,
    pb: i20 = 0,
    pa: i20 = 0,
    // The result, RGBA8888.
    out: u32 = 0,
}

// One stage of the texel address pipeline. Not every field means something
// at every stage.
struct TexStage {
    valid: u1 = 0,
    pix: u6 = 0,
    // S' and T' bits 31:7 (signed), and Q's low 32 bits.
    sp: i25 = 0,
    tp: i25 = 0,
    q: u32 = 0,
    // Q's leading zeros; its mantissa (UQ1.16); the seed; x * seed; the
    // Newton-Raphson factor; the reciprocal.
    lz: u5 = 0,
    x: u17 = 0,
    r0: u17 = 0,
    p: u34 = 0,
    c: u17 = 0,
    r: u17 = 0,
    // S' and T' times the reciprocal; the texel coordinates (4 fraction
    // bits); the texel's tag @ line @ place.
    us: i43 = 0,
    vt: i43 = 0,
    // The right shifts that scale them to texels, and the shifted values.
    ru: u6 = 0,
    rv: u6 = 0,
    su: i50 = 0,
    sv: i50 = 0,
    u: i20 = 0,
    v: i20 = 0,
    tu: u10 = 0,
    tv: u10 = 0,
    entry: u32 = 0,
}

impl Raster {
    // The run being written is wanted: its half block has a drawn pixel,
    // and the triangle writes its buffer (colour for runs 0 and 1, depth
    // for 2 and 3).
    fn run_used(self) -> u1 {
        let drawn = if self.run[0:0] == 0 { self.mask[31:0] != 0 } else { self.mask[63:32] != 0 };
        let enabled = if self.run[1:1] == 0 { self.flags[2:2] } else { self.flags[1:1] };
        drawn & enabled == 1
    }

    // A run is wanted: a depth read in ZREAD, a write of a half block with
    // a drawn pixel in WRITE, a clear run in CLEAR; not yet taken.
    fn want(self) -> u1 {
        (self.state == R_ZREAD & self.zreq != 2)
            | (self.state == R_WRITE & self.run_used() & self.requested == 0)
            | (self.state == R_CLEAR & self.requested == 0)
            | (self.state == R_TEXEL & self.filling == 1 & self.requested == 0)
    }

    // The outputs, from the registers. `draw`: the colour buffer's bank.
    pub fn out(self, draw: u2) -> RasterOut {
        let base = block_base(self.bx, self.by);
        let req = if self.state == R_CLEAR {
            let bank = if self.clear_z == 1 { DEPTH_BANK } else { draw };
            SdramReq { write: 1, addr: bank @ 0_u4 @ self.clear_hb @ 0_u5, len: 32 }
        } else if self.state == R_ZREAD {
            let addr = (base + (0_u13 @ self.zreq[0:0] @ 0_u5)) as u19 wrap;
            SdramReq { write: 0, addr: DEPTH_BANK @ 0_u3 @ addr, len: 32 }
        } else if self.state == R_TEXEL {
            SdramReq { write: 0, addr: self.fill_tag @ 0_u4, len: 16 }
        } else {
            let bank = if self.run[1:1] == 1 { DEPTH_BANK } else { draw };
            let addr = (base + (0_u13 @ self.run[0:0] @ 0_u5)) as u19 wrap;
            SdramReq { write: 1, addr: bank @ 0_u3 @ addr, len: 32 }
        };
        let wdata = if self.state == R_CLEAR {
            if self.clear_z == 1 { FAR } else { self.clear_colour }
        } else if self.run[1:1] == 1 {
            self.ztile.value()
        } else {
            self.tile.value()
        };
        RasterOut {
            out_raddr: copy_slot(self.copy),
            pending: self.pending,
            busy: self.state != R_IDLE | self.pending == 1,
            req: if self.want() { Some(req) } else { None },
            wdata: wdata,
            wmask: if self.state == R_CLEAR { 0 } else { !((self.mask >> self.pix)[0:0]) },
        }
    }

    // `kept`: the setup engine has just finished a triangle it kept, and
    // `kept_flags` are its write enables and depth test (RENDER_MODE's bits
    // 4 to 2). `rdata`: the output buffer slot addressed last cycle.
    // `clear`: clear the frame being drawn. `accepted`, `wtake`,
    // `sdram_rdata`: the SDRAM controller's, for this unit's runs. `tex`:
    // TEX0_CFG, which only changes while this unit is idle. `flush`: empty
    // the texture cache before the next triangle.
    pub fn next(
        self,
        kept: u1,
        kept_flags: u13,
        rdata: u36,
        clear: Option<ClearCmd>,
        accepted: u1,
        wtake: u1,
        sdram_rdata: Option<u16>,
        tex: u64,
        flush: u1,
        cc: u32,
        const0: u32,
        const1: u32,
    ) -> Self {
        let st = self.state;
        // TEX0_CFG's fields, from their registers; sizes clamped to 4 to
        // 1024 texels.
        let lw_in = log2_size(tex[11:8]);
        let lh_in = log2_size(tex[15:12]);
        let textured = self.tc_textured == 1;
        let argb = self.tc_argb;
        let lw = self.tc_lw;
        let lh = self.tc_lh;
        let (clearing, clear_in) = match clear {
            Some(c) => (1_u1, c),
            None => (0_u1, ClearCmd { colour: 0, colour_en: 0, depth_en: 0 }),
        };
        let (zin, zword) = match sdram_rdata {
            Some(w) => (1_u1, w),
            None => (0_u1, 0_u16),
        };

        // ---- COPY: each slot arrives a cycle after its address. --------
        let got = st == R_COPY & self.copy != 0;
        let k = (self.copy - 1) as u6 wrap;
        let word = rdata as i36 wrap;
        let copy_done = st == R_COPY & self.copy == COPY_SLOTS;

        // ---- INIT: the box in blocks. The last pixel whose centre is in
        // the box is (max - 8) >> 4, and its block that >> 3. ------------
        let bx0 = (self.xs >> 7) as i10 wrap;
        let by0 = (self.ys >> 7) as i10 wrap;
        let bx1 = ((self.xmax - 8) >> 7) as i10 wrap;
        let by1 = ((self.ymax - 8) >> 7) as i10 wrap;
        let empty = bx1 < bx0 | by1 < by0;

        // ---- TEST: a block wholly outside an edge is skipped; DECIDE acts
        // on the verdict a cycle later. ----------------------------------
        let reject = outside(self.e0) | outside(self.e1) | outside(self.e2);

        // ---- ZREAD: the block's 64 depths, two runs. ---------------------
        let reading = st == R_ZREAD;
        let zread_done = reading & self.zgot == 64;

        // ---- PIXELS: each pixel's coverage, depth and shade, then (a cycle
        // later, in the depth test's stage) drawn if covered and (with the
        // depth test) nearer than the depth there. -------------------------
        let stepping = st == R_PIXELS;
        let covered = inside(self.e0) & inside(self.e1) & inside(self.e2);
        let shade = s8(self.pr.pix) @ s8(self.pg.pix) @ s8(self.pb.pix) @ s8(self.pa.pix);
        let nearer = self.zt_z < self.ztile.value() | self.flags[0:0] == 0;
        let drawn = self.zt_valid == 1 & self.zt_cov == 1 & nearer;
        let row_end = self.pix[2:0] == 7;
        let block_end = self.pix == 63;
        let draining = st == R_DRAIN;
        let drained = draining & self.drain == 0;

        // ---- The texel address pipeline (PIXELS and DRAIN): S' / Q and
        // T' / Q by a reciprocal (setup's seed and a Newton-Raphson step),
        // scaled to texels, wrapped, then the texel's block and line. ----
        let q_low = (self.pq.pix as u36 wrap)[31:0];
        let t0 = TexStage {
            valid: stepping,
            pix: self.pix,
            sp: (self.ps.pix as u36 wrap)[31:7] as i25 wrap,
            tp: (self.pt.pix as u36 wrap)[31:7] as i25 wrap,
            q: if q_low == 0 { 1 } else { q_low },
            ..self.tp1
        };
        let t1 = self.tp1;
        let t2 = self.tp2;
        let t3 = self.tp3;
        let t4 = self.tp4;
        let t5 = self.tp5;
        let t6 = self.tp6;
        let t7 = self.tp7;
        let t8 = self.tp8;
        let t9 = self.tp9;
        let t10 = self.tp10;
        let t11 = self.tp11;
        let t12 = self.tp12;
        let normal = t2.q << t2.lz;
        let rr = t6.r0 * t6.c;
        let u_right = (41 - (0_u2 @ t7.lz) - (0_u3 @ lw)) as u6 wrap;
        let v_right = (41 - (0_u2 @ t7.lz) - (0_u3 @ lh)) as u6 wrap;
        let bxt = t11.tu[9:2];
        let byt = t11.tv[9:2];
        let block = ((0_u8 @ byt) << self.tc_bshift) | (0_u8 @ bxt);
        let tag = (self.tc_base + (0_u4 @ block)) as u20 wrap;
        let entry = tag @ byt[3:0] @ bxt[3:0] @ t11.tv[1:0] @ t11.tu[1:0];

        // ---- TEXEL: each pixel's texel through the cache, in order: its
        // address read; the cache and its shade read; then a hit, or a pixel
        // not drawn, writes its colour, and a miss fetches the block and
        // looks that pixel up again. ---------------------------------------
        let texeling = st == R_TEXEL;
        let pass = texeling & self.filling == 0;
        let a1 = self.atile.value();
        // Untextured, every lookup is a hit (on opaque white).
        let hit = !textured | self.tx3_tag == (1_u1 @ self.tx3_addr[31:12]);
        let tx_ok = pass & self.tx3_valid == 1 & (hit | self.tx3_drawn == 0);
        let tx_miss = pass & self.tx3_valid == 1 & !hit & self.tx3_drawn == 1;
        let issuing = pass & !tx_miss & self.tx_issue != 64;
        // The combiner: each channel's A, B, C and D by CC_MODE; (A - B) x
        // C; + D, clamped; then the alpha test on the result's alpha.
        let ccm = self.tc_cc;
        let c4 = self.tx4;
        let k0 = self.tc_const0;
        let k1 = self.tc_const1;
        let op_a = operand(ccm[3:0], 0, 0, c4.tex, c4.shade, k0, k1)
            @ operand(ccm[3:0], 0, 1, c4.tex, c4.shade, k0, k1)
            @ operand(ccm[3:0], 0, 2, c4.tex, c4.shade, k0, k1)
            @ operand(ccm[19:16], 0, 3, c4.tex, c4.shade, k0, k1);
        let op_b = operand(ccm[7:4], 0, 0, c4.tex, c4.shade, k0, k1)
            @ operand(ccm[7:4], 0, 1, c4.tex, c4.shade, k0, k1)
            @ operand(ccm[7:4], 0, 2, c4.tex, c4.shade, k0, k1)
            @ operand(ccm[23:20], 0, 3, c4.tex, c4.shade, k0, k1);
        let op_c = stretch(operand(ccm[11:8], 1, 0, c4.tex, c4.shade, k0, k1))
            @ stretch(operand(ccm[11:8], 1, 1, c4.tex, c4.shade, k0, k1))
            @ stretch(operand(ccm[11:8], 1, 2, c4.tex, c4.shade, k0, k1))
            @ stretch(operand(ccm[27:24], 0, 3, c4.tex, c4.shade, k0, k1));
        let op_d = operand(ccm[15:12], 0, 0, c4.tex, c4.shade, k0, k1)
            @ operand(ccm[15:12], 0, 1, c4.tex, c4.shade, k0, k1)
            @ operand(ccm[15:12], 0, 2, c4.tex, c4.shade, k0, k1)
            @ operand(ccm[31:28], 0, 3, c4.tex, c4.shade, k0, k1);
        let c5 = self.tx5;
        let c6 = self.tx6;
        let c7 = self.tx7;
        let alpha_test = self.flags[4:3];
        let alpha_ref = self.flags[12:5];
        let alpha = c7.out[7:0];
        let alpha_pass = alpha_test == 0
            | (alpha_test == 1 & alpha < alpha_ref)
            | (alpha_test == 2 & alpha >= alpha_ref)
            | (alpha_test == 3 & alpha != alpha_ref);
        let tx_write = texeling & self.tx7_valid == 1;
        let alpha_fail = tx_write & c7.drawn == 1 & !alpha_pass;
        let texel_done = tx_write & c7.pix == 63;
        let fill_word = texeling & self.filling == 1 & zin == 1;
        let fill_done = fill_word & self.fill_got == 15;

        // ---- FLUSH: every cache line's tag cleared. ----------------------
        let flushing = st == R_FLUSH;
        let flush_done = flushing & self.flush_line == 255;

        // ---- WRITE: colours then depths, each half block with a drawn
        // pixel one run; CLEAR: every half block's colour and depth. ------
        let writing = st == R_WRITE;
        let sending = writing | st == R_CLEAR;
        let want = self.want();
        let sent_last = wtake & self.pix[4:0] == 31;
        let run_done = writing & (!self.run_used() | sent_last);
        // A half block's colour run, then its depth run, each if enabled.
        let clear_run_done = st == R_CLEAR & sent_last;
        let clear_hb_done = clear_run_done & (self.clear_z == 1 | self.clear_depth_en == 0);
        let clear_done = clear_hb_done & self.clear_hb == LAST_HALF_BLOCK;
        let read_ptr: u6 = if sending & wtake == 1 { (self.pix + 1) as u6 wrap } else { self.pix };
        let next_run = (self.run + 1) as u2 wrap;

        // ---- NEXT: the next block in raster order, or done. -------------
        let last_col = self.bx == self.bx1;
        let last_row = self.by == self.by1;

        let state: u4 = if st == R_IDLE {
            if clearing == 1 {
                R_CLEAR
            } else if self.pending == 1 & self.need_flush == 1 {
                R_FLUSH
            } else if self.pending == 1 {
                R_COPY
            } else {
                R_IDLE
            }
        } else if flushing {
            if flush_done { R_IDLE } else { R_FLUSH }
        } else if draining {
            if !drained { R_DRAIN } else { R_TEXEL }
        } else if texeling {
            if texel_done { R_WRITE } else { R_TEXEL }
        } else if st == R_CLEAR {
            if clear_done { R_IDLE } else { R_CLEAR }
        } else if st == R_COPY {
            if copy_done { R_INIT } else { R_COPY }
        } else if st == R_INIT {
            if empty { R_IDLE } else { R_TEST }
        } else if st == R_TEST {
            R_DECIDE
        } else if st == R_DECIDE {
            // Without the depth test there is nothing to read.
            if self.rejected == 1 {
                R_NEXT
            } else if self.flags[0:0] == 1 {
                R_ZREAD
            } else {
                R_PIXELS
            }
        } else if reading {
            if zread_done { R_PIXELS } else { R_ZREAD }
        } else if stepping {
            if block_end { R_DRAIN } else { R_PIXELS }
        } else if writing {
            if run_done & self.run == 3 { R_NEXT } else { R_WRITE }
        } else if last_col & last_row {
            R_IDLE
        } else {
            R_TEST
        };
        let mode: u3 = if st == R_INIT {
            M_INIT
        } else if st == R_DECIDE & self.rejected == 0 {
            M_BLOCK
        } else if stepping & !row_end {
            M_PIXEL
        } else if stepping & !block_end {
            M_ROW
        } else if st == R_NEXT & !last_col {
            M_NEXT_COL
        } else if st == R_NEXT & !last_row {
            M_NEXT_ROW
        } else {
            M_HOLD
        };
        // The depth tile: filled by ZREAD, read in PIXELS for the depth
        // test a cycle later (a memory read takes a cycle) and written with
        // each pixel's depth there, read with the colours in WRITE.
        let zraddr: u6 = if stepping { self.pix } else if writing { read_ptr } else { 0 };
        let zwe = (reading & zin) | self.zt_valid;
        let zwaddr: u6 = if reading { self.zgot[5:0] } else { self.zt_pix };
        let zwdata: u16 = if reading { zword } else { self.zt_z };
        // The colour tile: each pixel's shade from the depth test's stage,
        // then, textured, texture x shade from TEXEL's last.
        let cwe = self.zt_valid | tx_write;
        let cwaddr: u6 = if texeling { c7.pix } else { self.zt_pix };
        let cwdata: u24 = if texeling { c7.out[31:8] } else { self.zt_shade[31:8] };

        Self {
                state: state,
                pending: if kept == 1 { 1 } else if copy_done { 0 } else { self.pending },
                pending_flags: if kept == 1 { kept_flags } else { self.pending_flags },
                flags: if st == R_IDLE & clearing == 0 & self.pending == 1 { self.pending_flags } else { self.flags },
                copy: if st == R_COPY { (self.copy + 1) as u6 wrap } else { 0 },
                xs: if got & k == 9 { word as i16 wrap } else { self.xs },
                ys: if got & k == 10 { word as i16 wrap } else { self.ys },
                xmax: if got & k == 11 { word as i16 wrap } else { self.xmax },
                ymax: if got & k == 12 { word as i16 wrap } else { self.ymax },
                bx0: if st == R_INIT { bx0 } else { self.bx0 },
                bx1: if st == R_INIT { bx1 } else { self.bx1 },
                by1: if st == R_INIT { by1 } else { self.by1 },
                bx: if st == R_INIT {
                    bx0
                } else if st == R_NEXT & last_col {
                    self.bx0
                } else if st == R_NEXT {
                    (self.bx + 1) as i10 wrap
                } else {
                    self.bx
                },
                by: if st == R_INIT {
                    by0
                } else if st == R_NEXT & last_col {
                    (self.by + 1) as i10 wrap
                } else {
                    self.by
                },
                e0: copy_edge(step_edge(self.e0, mode), got, k, word, 0, 3, 4),
                e1: copy_edge(step_edge(self.e1, mode), got, k, word, 1, 5, 6),
                e2: copy_edge(step_edge(self.e2, mode), got, k, word, 2, 7, 8),
                pr: copy_plane(step_plane(self.pr, mode), got, k, word, 13, 16, 17),
                pg: copy_plane(step_plane(self.pg, mode), got, k, word, 14, 18, 19),
                pb: copy_plane(step_plane(self.pb, mode), got, k, word, 15, 20, 21),
                pz: copy_plane(step_plane(self.pz, mode), got, k, word, 22, 23, 24),
                ps: copy_plane(step_plane(self.ps, mode), got, k, word, 25, 26, 27),
                pt: copy_plane(step_plane(self.pt, mode), got, k, word, 28, 29, 30),
                pq: copy_plane(step_plane(self.pq, mode), got, k, word, 31, 32, 33),
                pa: copy_plane(step_plane(self.pa, mode), got, k, word, 34, 35, 36),
                zt_valid: stepping,
                zt_pix: self.pix,
                zt_cov: covered,
                zt_z: depth(self.pz.pix),
                zt_shade: shade,
                drain: if stepping { if textured { DRAIN_TEXTURED } else { DRAIN_PLAIN } } else { (self.drain - 1) as u4 wrap },
                tp1: t0,
                tp2: TexStage { lz: lz32(t1.q), ..t1 },
                tp3: TexStage { x: normal[31:15], ..t2 },
                tp4: TexStage { r0: self.seeds.value()[16:0], ..t3 },
                tp5: TexStage { p: t4.x * t4.r0, ..t4 },
                tp6: TexStage { c: ((0x400000000_u35 - (0_u1 @ t5.p)) as u35 wrap)[33:17], ..t5 },
                tp7: TexStage { r: if rr[33:33] == 1 { R_MAX } else { rr[32:16] }, ..t6 },
                tp8: TexStage {
                    us: t7.sp * ((0_u1 @ t7.r) as i18 wrap),
                    vt: t7.tp * ((0_u1 @ t7.r) as i18 wrap),
                    ru: u_right,
                    rv: v_right,
                    ..t7
                },
                tp9: TexStage { su: widen7(t8.us) >> t8.ru, sv: widen7(t8.vt) >> t8.rv, ..t8 },
                tp10: TexStage { u: saturate20(t9.su), v: saturate20(t9.sv), ..t9 },
                tp11: TexStage {
                    tu: wrap_texel(t10.u, lw, self.tc_wmask, self.tc_uwrap),
                    tv: wrap_texel(t10.v, lh, self.tc_hmask, self.tc_vwrap),
                    ..t10
                },
                tp12: TexStage { entry: entry, ..t11 },
                tc_textured: tex[0:0],
                tc_argb: (tex[7:4] == 1),
                tc_lw: lw_in,
                tc_lh: lh_in,
                tc_wmask: size_mask(lw_in),
                tc_hmask: size_mask(lh_in),
                tc_bshift: (lw_in - 2) as u4 wrap,
                tc_uwrap: tex[17:16],
                tc_vwrap: tex[19:18],
                tc_base: tex[47:32] @ 0_u4,
                tc_cc: cc,
                tc_const0: const0,
                tc_const1: const1,
                tx_issue: if !texeling {
                    0
                } else if tx_miss {
                    0_u1 @ self.tx3_pix
                } else if issuing {
                    (self.tx_issue + 1) as u7 wrap
                } else {
                    self.tx_issue
                },
                tx1_valid: issuing,
                tx1_pix: self.tx_issue[5:0],
                tx2_valid: pass & !tx_miss & self.tx1_valid == 1,
                tx2_pix: self.tx1_pix,
                tx2_addr: a1,
                tx2_drawn: (self.mask >> self.tx1_pix)[0:0],
                tx3_valid: pass & !tx_miss & self.tx2_valid == 1,
                tx3_pix: self.tx2_pix,
                tx3_addr: self.tx2_addr,
                tx3_drawn: self.tx2_drawn,
                tx3_tag: self.ctag.value(),
                tx3_texel: self.cdata.value(),
                tx3_shade: self.stile.value(),
                tx4_valid: tx_ok,
                tx5_valid: texeling & self.tx4_valid == 1,
                tx6_valid: texeling & self.tx5_valid == 1,
                tx7_valid: texeling & self.tx6_valid == 1,
                tx4: CombStage {
                    pix: self.tx3_pix,
                    drawn: self.tx3_drawn,
                    tex: if textured { decode(self.tx3_texel, argb) } else { 0xFFFFFFFF },
                    shade: self.tx3_shade,
                    ..self.tx4
                },
                tx5: CombStage {
                    dr: difference(op_a[31:24], op_b[31:24]),
                    dg: difference(op_a[23:16], op_b[23:16]),
                    db: difference(op_a[15:8], op_b[15:8]),
                    da: difference(op_a[7:0], op_b[7:0]),
                    c: op_c,
                    d: op_d,
                    ..c4
                },
                tx6: CombStage {
                    pr: product(c5.dr, c5.c[35:27]),
                    pg: product(c5.dg, c5.c[26:18]),
                    pb: product(c5.db, c5.c[17:9]),
                    pa: product(c5.da, c5.c[8:0]),
                    ..c5
                },
                tx7: CombStage {
                    out: finish(c6.pr, c6.d[31:24])
                        @ finish(c6.pg, c6.d[23:16])
                        @ finish(c6.pb, c6.d[15:8])
                        @ finish(c6.pa, c6.d[7:0]),
                    ..c6
                },
                filling: if tx_miss { 1 } else if fill_done { 0 } else { self.filling },
                fill_got: if fill_done | !texeling { 0 } else if fill_word { (self.fill_got + 1) as u5 wrap } else { self.fill_got },
                fill_tag: if tx_miss { self.tx3_addr[31:12] } else { self.fill_tag },
                fill_line: if tx_miss { self.tx3_addr[11:4] } else { self.fill_line },
                need_flush: flush | (self.need_flush & !flushing),
                flush_line: if flushing { (self.flush_line + 1) as u8 wrap } else { 0 },
                pix: if stepping {
                    (self.pix + 1) as u6 wrap
                } else if run_done {
                    // The next run's half block.
                    next_run[0:0] @ 0_u5
                } else if sending {
                    read_ptr
                } else {
                    0
                },
                rejected: reject,
                mask: if st == R_TEST {
                    0
                } else if drawn {
                    self.mask | ((0_u63 @ drawn) << self.zt_pix)
                } else if alpha_fail {
                    // A pixel the alpha test fails writes neither colour
                    // nor depth.
                    self.mask & (((0_u63 @ 1_u1) << c7.pix) ^ 0xFFFFFFFFFFFFFFFF)
                } else {
                    self.mask
                },
                zreq: if reading { (self.zreq + (want & accepted)) as u2 wrap } else { 0 },
                zgot: if reading { (self.zgot + zin) as u7 wrap } else { 0 },
                run: if run_done { next_run } else if writing { self.run } else { 0 },
                requested: if (writing & !run_done) | (st == R_CLEAR & !clear_run_done) | (texeling & self.filling == 1 & !fill_done) {
                    self.requested | (want & accepted)
                } else {
                    0
                },
                clear_colour: if st == R_IDLE & clearing == 1 { clear_in.colour } else { self.clear_colour },
                clear_colour_en: if st == R_IDLE & clearing == 1 { clear_in.colour_en } else { self.clear_colour_en },
                clear_depth_en: if st == R_IDLE & clearing == 1 { clear_in.depth_en } else { self.clear_depth_en },
                clear_hb: if st != R_CLEAR {
                    0
                } else if clear_hb_done {
                    (self.clear_hb + 1) as u13 wrap
                } else {
                    self.clear_hb
                },
                // Each half block starts with its colour run, if enabled.
                clear_z: if st == R_IDLE & clearing == 1 {
                    !clear_in.colour_en
                } else if clear_hb_done {
                    !self.clear_colour_en
                } else if clear_run_done {
                    1
                } else {
                    self.clear_z
                },
                tile: self.tile.next(read_ptr, cwe, cwaddr, cwdata[23:19] @ cwdata[15:10] @ cwdata[7:3]),
                ztile: self.ztile.next(zraddr, zwe, zwaddr, zwdata),
                stile: self.stile.next(self.tx1_pix, self.zt_valid, self.zt_pix, self.zt_shade),
                atile: self.atile.next(self.tx_issue[5:0], t12.valid, t12.pix, t12.entry),
                ctag: self.ctag.next(
                    a1[11:4],
                    fill_done | flushing,
                    if flushing { self.flush_line } else { self.fill_line },
                    if flushing { 0 } else { 1_u1 @ self.fill_tag },
                ),
                cdata: self.cdata.next(a1[11:0], fill_word, self.fill_line @ self.fill_got[3:0], zword),
                seeds: self.seeds.next(normal[30:21]),
        }
    }
}

// The output buffer slot copied in COPY cycle c: E01, E12, E20 (0x00-0x02);
// A01, B01, A12, B12, A20, B20 (0x20-0x25); xs, ys, xmax, ymax (0x26-0x29);
// the R, G, B starts (0x2A-0x2C); R, G, B d/dx and d/dy (0x03-0x08); the Z
// start (0x2E), d/dx and d/dy (0x0B, 0x0C); then S', T' and Q, each its
// start (0x2F-0x31), d/dx and d/dy (0x0D-0x12). (The untextured program
// leaves those last nine slots as they were; they go unused.)
fn copy_slot(c: u6) -> u6 {
    if c < 3 {
        c
    } else if c < 16 {
        (0x1D + c) as u6 wrap
    } else if c < 22 {
        (c - 13) as u6 wrap
    } else if c == 22 {
        0x2E
    } else if c == 23 {
        0x0B
    } else if c == 24 {
        0x0C
    } else if c == 25 {
        0x2F
    } else if c == 26 {
        0x0D
    } else if c == 27 {
        0x0E
    } else if c == 28 {
        0x30
    } else if c == 29 {
        0x0F
    } else if c == 30 {
        0x10
    } else if c == 31 {
        0x31
    } else if c == 32 {
        0x11
    } else if c == 33 {
        0x12
    } else if c == 34 {
        0x2D
    } else if c == 35 {
        0x09
    } else if c == 36 {
        0x0A
    } else {
        0
    }
}

// An edge's registers after a COPY cycle: its value is slot `ei`, A slot
// `ai`, B slot `bi`.
fn copy_edge(e: EdgeState, got: u1, k: u6, word: i36, ei: u6, ai: u6, bi: u6) -> EdgeState {
    EdgeState {
        a: if got & k == ai { word as i17 wrap } else { e.a },
        b: if got & k == bi { word as i17 wrap } else { e.b },
        blk: if got & k == ei { word as i40 wrap } else { e.blk },
        ..e
    }
}

// A plane's registers after a COPY cycle: its start is slot `si`, d/dx
// `xi`, d/dy `yi`.
fn copy_plane(p: PlaneState, got: u1, k: u6, word: i36, si: u6, xi: u6, yi: u6) -> PlaneState {
    PlaneState {
        dx: if got & k == xi { word } else { p.dx },
        dy: if got & k == yi { word } else { p.dy },
        blk: if got & k == si { word } else { p.blk },
        ..p
    }
}

// 16 * x, for a Q13.4 count: the step to the next pixel.
fn times16(x: i17) -> i21 {
    ((x as u17 wrap) @ 0_u4) as i21 wrap
}

// 128 * x: the step to the next block.
fn times128(x: i17) -> i24 {
    ((x as u17 wrap) @ 0_u7) as i24 wrap
}

// An edge's registers, moved by `mode`.
fn step_edge(e: EdgeState, mode: u3) -> EdgeState {
    if mode == M_INIT {
        // The value copied is at the box's first pixel, which is the first
        // block's. A top or left edge's 0 is inside.
        EdgeState {
            tie: e.a > 0 | (e.a == 0 & e.b > 0),
            corner: corner(e.a, e.b),
            pix: e.blk,
            row: e.blk,
            blkrow: e.blk,
            ..e
        }
    } else if mode == M_BLOCK {
        EdgeState { pix: e.blk, row: e.blk, ..e }
    } else if mode == M_PIXEL {
        EdgeState { pix: (e.pix + times16(e.a)) as i40 wrap, ..e }
    } else if mode == M_ROW {
        let row = (e.row + times16(e.b)) as i40 wrap;
        EdgeState { pix: row, row: row, ..e }
    } else if mode == M_NEXT_COL {
        EdgeState { blk: (e.blk + times128(e.a)) as i40 wrap, ..e }
    } else if mode == M_NEXT_ROW {
        let blkrow = (e.blkrow + times128(e.b)) as i40 wrap;
        EdgeState { blk: blkrow, blkrow: blkrow, ..e }
    } else {
        e
    }
}

// 8 * x, wrapping: a plane's step to the next block.
fn times8(x: i36) -> i36 {
    ((x as u36 wrap)[32:0] @ 0_u3) as i36 wrap
}

// A plane's registers, moved by `mode`.
fn step_plane(p: PlaneState, mode: u3) -> PlaneState {
    if mode == M_INIT {
        PlaneState { pix: p.blk, row: p.blk, blkrow: p.blk, ..p }
    } else if mode == M_BLOCK {
        PlaneState { pix: p.blk, row: p.blk, ..p }
    } else if mode == M_PIXEL {
        PlaneState { pix: (p.pix + p.dx) as i36 wrap, ..p }
    } else if mode == M_ROW {
        let row = (p.row + p.dy) as i36 wrap;
        PlaneState { pix: row, row: row, ..p }
    } else if mode == M_NEXT_COL {
        PlaneState { blk: (p.blk + times8(p.dx)) as i36 wrap, ..p }
    } else if mode == M_NEXT_ROW {
        let blkrow = (p.blkrow + times8(p.dy)) as i36 wrap;
        PlaneState { blk: blkrow, blkrow: blkrow, ..p }
    } else {
        p
    }
}

// How far an edge's value rises from a block's first pixel to its other
// corners, seven pixels on: 112 * max(A, 0) + 112 * max(B, 0).
fn corner(a: i17, b: i17) -> i24 {
    let pa: u16 = if a > 0 { (a as u17 wrap)[15:0] } else { 0 };
    let pb: u16 = if b > 0 { (b as u17 wrap)[15:0] } else { 0 };
    // 112 * x = 128 * x - 16 * x.
    let ma = ((pa @ 0_u7) - (0_u3 @ pa @ 0_u4)) as u23 wrap;
    let mb = ((pb @ 0_u7) - (0_u3 @ pb @ 0_u4)) as u23 wrap;
    ((0_u1 @ ma) + (0_u1 @ mb)) as i24 wrap
}

// The edge's largest value over the block's four corner pixels is below
// 0: no pixel of the block is inside it.
fn outside(e: EdgeState) -> u1 {
    e.blk + e.corner < 0
}

// The current pixel is inside the edge: its value is positive, or 0 on a
// top or left edge.
fn inside(e: EdgeState) -> u1 {
    e.pix > 0 | (e.pix == 0 & e.tie == 1)
}

// An 8-bit channel's iterator count as 8 bits: over 2^16, rounded half
// up, clamped (models/setup/src/texture.rs `shade8`).
fn s8(v: i36) -> u8 {
    let q = (v + 32768) >> 16;
    if q < 0 {
        0
    } else if q > 255 {
        255
    } else {
        (q as u21 wrap)[7:0]
    }
}

// A 16-bit field, sign-extended to a vertex ring word.
fn sext16(v: u16) -> u36 {
    ((v as i16 wrap) as i36 wrap) as u36 wrap
}

// The depth plane's iterator count as a 16-bit depth: over 2^16, rounded
// half up, clamped.
fn depth(v: i36) -> u16 {
    let q = (v + 32768) >> 16;
    if q < 0 {
        0
    } else if q > 65535 {
        65535
    } else {
        (q as u21 wrap)[15:0]
    }
}

// A block's first word in the tiled framebuffer: (by * 80 + bx) * 64.
fn block_base(bx: i10, by: i10) -> u19 {
    let x = (bx as u10 wrap)[6:0];
    let y = (by as u10 wrap)[5:0];
    let index = ((0_u1 @ y @ 0_u6) + (0_u3 @ y @ 0_u4) + (0_u6 @ x)) as u13 wrap;
    index @ 0_u6
}

// TEX0_CFG's WIDTH_LOG2 or HEIGHT_LOG2 as used: 2 to 10.
fn log2_size(f: u4) -> u4 {
    if f < 2 {
        2
    } else if f > 10 {
        10
    } else {
        f
    }
}

// The leading zeros of a nonzero 32-bit value.
fn lz32(q: u32) -> u5 {
    if q[31:16] == 0 {
        if q[15:8] == 0 {
            (24 + (0_u2 @ lz8(q[7:0]))) as u5 wrap
        } else {
            (16 + (0_u2 @ lz8(q[15:8]))) as u5 wrap
        }
    } else if q[31:24] == 0 {
        (8 + (0_u2 @ lz8(q[23:16]))) as u5 wrap
    } else {
        0_u2 @ lz8(q[31:24])
    }
}

// The leading zeros of a byte (7 for 0 or 1).
fn lz8(b: u8) -> u3 {
    if b[7:7] == 1 {
        0
    } else if b[6:6] == 1 {
        1
    } else if b[5:5] == 1 {
        2
    } else if b[4:4] == 1 {
        3
    } else if b[3:3] == 1 {
        4
    } else if b[2:2] == 1 {
        5
    } else if b[1:1] == 1 {
        6
    } else {
        7
    }
}

// A texture coordinate in texels (4 fraction bits) from S' (or T') times
// the reciprocal: shifted left by 7 (here), then right by 0 to 39,
// rounding down, then saturated to 20 bits (texture.rs `coordinate`).
fn widen7(us: i43) -> i50 {
    ((us as u43 wrap) @ 0_u7) as i50 wrap
}

// A shifted texture coordinate, saturated to 20 bits.
fn saturate20(shifted: i50) -> i20 {
    if shifted < COORD_MIN {
        COORD_MIN as i20 wrap
    } else if shifted > COORD_MAX {
        COORD_MAX as i20 wrap
    } else {
        shifted as i20 wrap
    }
}

// 2^log2 - 1: a size's mask.
fn size_mask(log2: u4) -> u10 {
    (((1_u11 << log2) as u11 wrap) - 1) as u10 wrap
}

// A texel coordinate's texel along it, by its wrap mode: 0 repeat,
// 1 clamp to the edge, 2 mirror, 3 (reserved) repeat; the texture is
// 2^log2 texels along it, `size_mask` being 2^log2 - 1 (texture.rs
// `wrap`).
fn wrap_texel(u: i20, log2: u4, size_mask: u10, mode: u2) -> u10 {
    let ui = u >> 4;
    let low = (ui as u16 wrap)[9:0];
    let flipped = (((ui as u16 wrap) >> log2)[0:0]) == 1;
    if mode == 1 {
        if ui < 0 {
            0
        } else if ui > (0_u6 @ size_mask) as i16 wrap {
            size_mask
        } else {
            low
        }
    } else if mode == 2 & flipped {
        (low & size_mask) ^ size_mask
    } else {
        low & size_mask
    }
}

// A texel as 8 bits a channel, R @ G @ B @ A: RGB565 with each field's
// bits repeated and opaque, or ARGB4444 with each nibble repeated
// (texture.rs `decode`).
fn decode(t: u16, argb: u1) -> u32 {
    if argb == 1 {
        t[11:8] @ t[11:8] @ t[7:4] @ t[7:4] @ t[3:0] @ t[3:0] @ t[15:12] @ t[15:12]
    } else {
        t[15:11] @ t[15:13] @ t[10:5] @ t[10:9] @ t[4:0] @ t[4:2] @ 0xFF_u8
    }
}

// Channel k (0 R, 1 G, 2 B, 3 A) of an RGBA8888 value.
fn channel(x: u32, k: u2) -> u8 {
    if k == 0 {
        x[31:24]
    } else if k == 1 {
        x[23:16]
    } else if k == 2 {
        x[15:8]
    } else {
        x[7:0]
    }
}

// A combiner input's channel k, by its code (host-interface.md §7): 1 the
// texel, 3 the shade, 4 CONST0, 5 CONST1, 6 one, 7 zero; where `broadcast`
// (RGB_C), 8, 10 and 11 the texel's, shade's and CONST0's alpha; anything
// else 0 (texture.rs `combine`).
fn operand(code: u4, broadcast: u1, k: u2, tex: u32, shade: u32, c0: u32, c1: u32) -> u8 {
    if code == 1 {
        channel(tex, k)
    } else if code == 3 {
        channel(shade, k)
    } else if code == 4 {
        channel(c0, k)
    } else if code == 5 {
        channel(c1, k)
    } else if code == 6 {
        255
    } else if broadcast == 1 & code == 8 {
        tex[7:0]
    } else if broadcast == 1 & code == 10 {
        shade[7:0]
    } else if broadcast == 1 & code == 11 {
        c0[7:0]
    } else {
        0
    }
}

// A - B, signed.
fn difference(a: u8, b: u8) -> i9 {
    (((0_u1 @ a) as i9 wrap) - ((0_u1 @ b) as i9 wrap)) as i9 wrap
}

// (A - B) x C, C stretched.
fn product(diff: i9, c: u9) -> i20 {
    (diff as i10 wrap) * ((0_u1 @ c) as i10 wrap)
}

// D + ((A - B) x C + 128) / 256 rounded down, clamped to 0 to 255.
fn finish(p: i20, d: u8) -> u8 {
    let v = ((p + 128) >> 8) + ((0_u1 @ d) as i9 wrap);
    if v < 0 {
        0
    } else if v > 255 {
        255
    } else {
        (v as u14 wrap)[7:0]
    }
}

// A channel stretched from 0 to 255 to 0 to 256, so that 255 is 1.
fn stretch(c: u8) -> u9 {
    ((0_u1 @ c) + (0_u8 @ c[7:7])) as u9 wrap
}

