// The triangle setup engine (docs/design/setup-engine.md, ADR 0001).
//
// A microcoded datapath: each cycle the sequencer issues one micro-word
// from two ROMs at the same address, one multiplier (MUL) slot operation
// and one ALU slot operation. The program is generated by models/setup
// (setup-gen, run by `just gen`), which also holds the engine's
// cycle-level golden model, models/setup/src/interp.rs: this module must
// match it cycle for cycle.
//
// Pipeline, counted from the issue cycle t (the cycle a word is out of the
// ROMs):
//   t    read addresses go to the vertex ring and the two temporary banks
//   t+1  operands arrive (memories read first: a write in cycle t isn't
//        seen) and are registered
//   t+2  an ALU result (or TST's flags) is written; an RCPLD looks up its
//        seed; an LZC finds the area's leading one; a MUL product is formed
//   t+3  an RCPLD's seed, or an LZC's mantissa and E, is written; the
//        product accumulates
//   t+4  the sum is shifted (by E as it is then)
//   t+5  the sum is rounded, saturated and written
//
// Only the sequencer, the valid bits and the buffer bank are reset; the
// datapath is #[no_reset] (ADR 0006).

// Where each program starts in the micro-ROMs (models/setup/src/emit.rs).
const PROGRAM_FULL: u8 = 0;
const PROGRAM_UNTEXTURED: u8 = 128;

// ALU operations (models/setup/src/isa.rs).
const ALU_MOV: u4 = 1;
const ALU_ADD: u4 = 2;
const ALU_SUB: u4 = 3;
const ALU_NEG: u4 = 4;
const ALU_MIN: u4 = 5;
const ALU_MAX: u4 = 6;
const ALU_SNAP: u4 = 7;
const ALU_LZC: u4 = 8;
const ALU_RCPLD: u4 = 9;
const ALU_TST: u4 = 10;
const ALU_ADDV: u4 = 11;

// MUL operations.
const MUL_MUL: u2 = 1;
const MUL_MAC: u2 = 2;
const MUL_MSUB: u2 = 3;

// Sequencer actions.
const SEQ_CHECK: u2 = 1;
const SEQ_END: u2 = 2;

// Cull modes.
const CULL_BACK: u2 = 1;
const CULL_FRONT: u2 = 2;

// Results.
pub const RESULT_KEPT: u2 = 0;
pub const RESULT_ZERO_AREA: u2 = 1;
pub const RESULT_CULLED: u2 = 2;

// A write to the vertex ring: field `field` of slot `slot`, as a 36-bit
// word (coordinates and S', T' sign-extended, the rest zero-extended).
pub struct VertexWrite {
    pub slot: u2,
    pub field: u4,
    pub value: u36,
}

// Start a triangle: the ring slot of each role (role 0 in bits 5:4), the
// cull mode (0 none, 1 back, 2 front), and the program.
pub struct Start {
    pub roles: u6,
    pub cull: u2,
    pub untextured: u1,
}

// One memory's write port, as the engine drives it this cycle.
pub struct WritePort {
    pub we: u1,
    pub addr: u6,
    pub data: u36,
}

pub struct SetupOut {
    // A triangle is in progress: a start is ignored.
    pub busy: u1,
    // High for one cycle after a triangle finishes, with its result and
    // whether its roles 1 and 2 were swapped.
    pub done: u1,
    pub result: u2,
    pub flipped: u1,
    // The committed output buffer's slot `out_raddr` of the last cycle.
    pub rdata: u36,
    // The write ports, for the cycle-exact test against the interpreter.
    pub alu_bank: WritePort,
    pub mul_bank: WritePort,
    pub alu_out: WritePort,
    pub mul_out: WritePort,
}

// An issued ALU word, on its way to its operands.
struct AluStage {
    op: u4 = 0,
    a: u7 = 0,
    b: u7 = 0,
    temp: u6 = 0,
    out: u7 = 0,
}

// An ALU operation with its operands registered: what it does, decoded
// to one bit per operation so that the result select is shallow, and
// where its result goes.
struct AluExec {
    mov: u1 = 0,
    add: u1 = 0,
    sub: u1 = 0,
    neg: u1 = 0,
    min: u1 = 0,
    max: u1 = 0,
    snap: u1 = 0,
    addv: u1 = 0,
    lzc: u1 = 0,
    rcpld: u1 = 0,
    tst: u1 = 0,
    temp: u6 = 0,
    out: u7 = 0,
}

// An RCPLD waiting for its seed.
struct SeedStage {
    temp: u6 = 0,
}

// An LZC waiting to shift: the area, and its leading one's position (E).
struct LzcStage {
    temp: u6 = 0,
    a: i36 = 0,
    e: u6 = 0,
}

// A MUL term or sum on its way down the pipeline, with the settings that
// follow it to the post-shifter.
struct MulCtl {
    op: u2 = 0,
    temp: u6 = 0,
    out: u7 = 0,
    shift: u6 = 0,
    by_e: u1 = 0,
    round: u1 = 0,
    sat: u1 = 0,
}

// A sum past its accumulate stage (its shift amount fixed): where it goes,
// and how it is rounded and saturated.
struct PostCtl {
    temp: u6 = 0,
    out: u7 = 0,
    round: u1 = 0,
    sat: u1 = 0,
}

#[module]
pub struct SetupEngine {
    // The sequencer: running, the word being issued, the program's first
    // word, and the triangle's roles, cull mode and flip.
    running: u1 = 0,
    pc: u8 = 0,
    // This cycle's sequencer action: each ROM word carries the next word's,
    // so it comes from a register, not straight off the block RAM.
    seq_now: u2 = 0,
    base: u8 = 0,
    roles: [u2; 3] = [0, 1, 2],
    cull: u2 = 0,
    flipped: u1 = 0,
    // The output buffer bank being written; the other is committed.
    wbank: u1 = 0,
    // The last triangle's result.
    done: u1 = 0,
    result: u2 = 0,
    done_flipped: u1 = 0,
    // E and the flags (N, Z).
    e: u6 = 0,
    flags: u2 = 0,

    // Valid bits of the pipeline stages.
    alu1_valid: u1 = 0,
    alu2_valid: u1 = 0,
    seed3_valid: u1 = 0,
    lzc3_valid: u1 = 0,
    mul1_valid: u1 = 0,
    mul2_valid: u1 = 0,
    mul3_valid: u1 = 0,
    mul4_valid: u1 = 0,
    mul5_valid: u1 = 0,

    // The datapath.
    #[no_reset]
    alu1: AluStage,
    #[no_reset]
    alu2: AluExec,
    #[no_reset]
    alu2_a: i36 = 0,
    #[no_reset]
    alu2_b: i36 = 0,
    // a < b, compared as the operands are registered (for MIN, MAX, SNAP).
    #[no_reset]
    alu2_lt: u1 = 0,
    #[no_reset]
    seed3: SeedStage,
    #[no_reset]
    lzc3: LzcStage,
    #[no_reset]
    mul1: MulCtl,
    #[no_reset]
    mul1_a7: u7 = 0,
    #[no_reset]
    mul1_b7: u7 = 0,
    #[no_reset]
    mul2: MulCtl,
    #[no_reset]
    mul2_a: i36 = 0,
    #[no_reset]
    mul2_b: i18 = 0,
    #[no_reset]
    mul3: MulCtl,
    #[no_reset]
    mul3_p: i54 = 0,
    #[no_reset]
    mul4: PostCtl,
    // The shift stage's amount, fixed (with E) as the sum accumulates.
    #[no_reset]
    mul4_amount: u7 = 0,
    #[no_reset]
    mul5: PostCtl,
    // The shifted sum, before rounding: (acc << 7) >> (s - 1), or >> (s - 2)
    // when rounding.
    #[no_reset]
    mul5_y: i63 = 0,
    #[no_reset]
    acc: i56 = 0,
    // Which output memory the last buffer read was from.
    #[no_reset]
    read_mul: u1 = 0,

    // The micro-ROMs and the reciprocal seeds (generated: build/gen/).
    #[storage(bram)]
    #[no_reset]
    mul_rom: rom<u38, 256> = include_hex!("../build/gen/setup_mul.hex"),
    #[storage(bram)]
    #[no_reset]
    alu_rom: rom<u33, 256> = include_hex!("../build/gen/setup_alu.hex"),
    #[storage(bram)]
    #[no_reset]
    seeds: rom<u18, 1024> = include_hex!("../build/gen/setup_seed.hex"),
    // The vertex ring: slot @ field. Read ports: ALU a, ALU b.
    #[storage(lutram)]
    #[no_reset]
    ring: mem<u36, 64, 2> = 0,
    // The temporary banks. Read ports: ALU a, ALU b, MUL a, MUL b.
    #[storage(lutram)]
    #[no_reset]
    alu_bank: mem<u36, 32, 4> = 0,
    #[storage(lutram)]
    #[no_reset]
    mul_bank: mem<u36, 32, 4> = 0,
    // The output buffers, two banks of 32 slots each: bank @ slot. One
    // read port each, so block RAM.
    #[storage(bram)]
    #[no_reset]
    alu_out: mem<u36, 64> = 0,
    #[storage(bram)]
    #[no_reset]
    mul_out: mem<u36, 64> = 0,
}

impl SetupEngine {
    pub fn step(self, load: Option<VertexWrite>, start: Option<Start>, out_raddr: u6) -> (Self, SetupOut) {
        // ---- Issue (cycle t) ----------------------------------------------
        let mw = self.mul_rom.value();
        let aw = self.alu_rom.value();
        let issue = self.running;
        let m_op = mw[37:36];
        let m_a = mw[35:29];
        let m_b = mw[28:22];
        let a_op = aw[32:29];
        let a_a = aw[28:22];
        let a_b = aw[21:15];
        let seq = self.seq_now;

        // The vertex ring's read addresses: the slot of the field's role.
        let ring_a = self.roles[a_a[5:4]] @ a_a[3:0];
        let ring_b = self.roles[a_b[5:4]] @ a_b[3:0];
        let bank_addrs = [a_a[4:0], a_b[4:0], m_a[4:0], m_b[4:0]];

        // ---- Operands (t+1) ----------------------------------------------
        let ring_v = self.ring.value();
        let alu_v = self.alu_bank.value();
        let mul_v = self.mul_bank.value();
        let sel_a = operand(self.alu1.a, ring_v[0], alu_v[0], mul_v[0]);
        let sel_b = operand(self.alu1.b, ring_v[1], alu_v[1], mul_v[1]);

        // ---- The ALU (t+2), from registered operands ------------------
        let a = self.alu2_a;
        let b = self.alu2_b;
        let x = self.alu2;
        // LZC, t+2: the leading one (0 for an area that isn't positive).
        let lzc_e: u6 = if a > 0 { msb((a as u36 wrap)[34:0]) } else { 0 };
        // LZC, t+3: the mantissa.
        let lzc_m: i36 = if self.lzc3.a > 0 {
            self.lzc3.a << ((33 - self.lzc3.e) as u6 wrap)
        } else {
            0
        };
        // One comparator for MIN, MAX and SNAP, a cycle earlier.
        let a_lt_b = self.alu2_lt == 1;
        let smaller: i36 = if a_lt_b { a } else { b };
        // Every operation's result, then the one the decoded operation picks
        // (an AND-OR of one-bit selects).
        let au = a as u36 wrap;
        let low = smaller as u36 wrap;
        // SNAP: clipped at 0 (by the sign bit) and snapped down to 8 pixels.
        let snapped: u36 = if low[35:35] == 1 { 0 } else { low[35:7] @ 0_u7 };
        let r_mov: u36 = if x.mov == 1 { au } else { 0 };
        let r_add: u36 = if x.add == 1 { (a + b) as u36 wrap } else { 0 };
        let r_sub: u36 = if x.sub == 1 { (a - b) as u36 wrap } else { 0 };
        let r_neg: u36 = if x.neg == 1 { -a as u36 wrap } else { 0 };
        let r_min: u36 = if x.min == 1 { low } else { 0 };
        let r_max: u36 = if x.max == 1 { (if a_lt_b { b } else { a }) as u36 wrap } else { 0 };
        let r_snap: u36 = if x.snap == 1 { snapped } else { 0 };
        // ADDV: only the low 36 bits are kept, so a 36-bit add.
        let r_addv: u36 = if x.addv == 1 { (au + ((b as u36 wrap)[19:0] @ 0_u16)) as u36 wrap } else { 0 };
        let alu_result = r_mov | r_add | r_sub | r_neg | r_min | r_max | r_snap | r_addv;
        let alu_live = self.alu2_valid & !(x.rcpld | x.tst | x.lzc);
        let e = if self.lzc3_valid == 1 { self.lzc3.e } else { self.e };
        let flags = if self.alu2_valid & x.tst == 1 {
            (a < 0) @ (a == 0)
        } else {
            self.flags
        };
        let seed_index = au[32:23];
        let rcpld = self.alu2_valid & x.rcpld;
        let lzc = self.alu2_valid & x.lzc;

        // The ALU bank's one write port: an ALU result, or a cycle later a
        // seed or a mantissa (the schedule never has two at once).
        let seed_we = self.seed3_valid & self.seed3.temp[5:5] == 1;
        let lzc_we = self.lzc3_valid & self.lzc3.temp[5:5] == 1;
        let alu_bank_w = if seed_we {
            WritePort { we: 1, addr: 0_u1 @ self.seed3.temp[4:0], data: 0_u18 @ self.seeds.value() }
        } else if lzc_we {
            WritePort { we: 1, addr: 0_u1 @ self.lzc3.temp[4:0], data: lzc_m as u36 wrap }
        } else {
            WritePort {
                we: alu_live & self.alu2.temp[5:5],
                addr: 0_u1 @ self.alu2.temp[4:0],
                data: alu_result,
            }
        };
        let alu_out_w = WritePort {
            we: alu_live & self.alu2.out[6:6],
            addr: self.wbank @ self.alu2.out[4:0],
            data: alu_result,
        };

        // ---- The multiplier ---------------------------------------------
        // t+1: operands; t+2: product; t+3: accumulate; t+4: shift;
        // t+5: round, saturate and write.
        let ma = mul_operand(self.mul1_a7, alu_v[2], mul_v[2]);
        let mb = (mul_operand(self.mul1_b7, alu_v[3], mul_v[3]) as u36 wrap)[17:0] as i18 wrap;
        let product: i54 = self.mul2_a * self.mul2_b;
        let acc: i56 = if self.mul3.op == MUL_MAC {
            (self.acc + self.mul3_p) as i56 wrap
        } else if self.mul3.op == MUL_MSUB {
            (self.acc - self.mul3_p) as i56 wrap
        } else {
            self.mul3_p as i56 wrap
        };
        // The post-shifter: (acc << 8) >> s, done as (acc << 7) >> (s - 1)
        // to stay within 64 bits. Rounding half up shifts one bit less here
        // and adds one below the last kept bit in the next cycle.
        // t+3: the amount, with E as it is now.
        let e_shift: u6 = if self.mul3.by_e == 1 { self.e } else { 0 };
        let s: u7 = self.mul3.shift + e_shift;
        let amount: u7 = if self.mul3.round == 1 { (s - 2) as u7 wrap } else { (s - 1) as u7 wrap };
        // t+4: the shift.
        let x: i63 = ((self.acc as u56 wrap) @ 0_u7) as i63 wrap;
        let y: i63 = x >> self.mul4_amount;
        let shifted: i63 = if self.mul5.round == 1 {
            ((self.mul5_y + 1) >> 1) as i63 wrap
        } else {
            self.mul5_y
        };
        // Saturation, without comparators: the sum fits 36 bits when its
        // bits from 35 up are all copies of the sign.
        let su = shifted as u63 wrap;
        let fits = su[62:35] == 0 | su[62:35] == 0xFFFFFFF;
        let limit: u36 = if su[62:62] == 1 { 0x800000000 } else { 0x7FFFFFFFF };
        let sum: u36 = if self.mul5.sat == 1 & !fits { limit } else { su[35:0] };
        let mul_bank_w = WritePort {
            we: self.mul5_valid & self.mul5.temp[5:5],
            addr: 0_u1 @ self.mul5.temp[4:0],
            data: sum,
        };
        let mul_out_w = WritePort {
            we: self.mul5_valid & self.mul5.out[6:6],
            addr: self.wbank @ self.mul5.out[4:0],
            data: sum,
        };

        // ---- The sequencer (t) ------------------------------------------
        let (start_valid, st) = match start {
            Some(s) => (1_u1, s),
            None => (0_u1, Start { roles: 0b000110, cull: 0, untextured: 0 }),
        };
        let n = self.flags[1:1];
        let z = self.flags[0:0];
        let culled = self.flipped == 0
            & ((self.cull == CULL_BACK & n == 1) | (self.cull == CULL_FRONT & n == 0));
        let checking = issue & seq == SEQ_CHECK;
        let abort = checking & (z == 1 | culled);
        let restart = checking & !abort & n == 1;
        let ending = issue & seq == SEQ_END;
        let stop = abort | ending;
        let begin = !self.running & start_valid;
        let new_base: u8 = if st.untextured == 1 { PROGRAM_UNTEXTURED } else { PROGRAM_FULL };
        let pc_next: u8 = if begin {
            new_base
        } else if restart {
            self.base
        } else {
            (self.pc + 1) as u8 wrap
        };
        let roles = if begin {
            [st.roles[5:4], st.roles[3:2], st.roles[1:0]]
        } else if restart {
            [self.roles[0], self.roles[2], self.roles[1]]
        } else {
            self.roles
        };

        let (load_we, lw) = match load {
            Some(l) => (1_u1, l),
            None => (0_u1, VertexWrite { slot: 0, field: 0, value: 0 }),
        };
        let read_slot = !self.wbank @ out_raddr[4:0];
        let rdata = if self.read_mul == 1 { self.mul_out.value() } else { self.alu_out.value() };

        (
            Self {
                running: (self.running & !stop) | begin,
                pc: pc_next,
                seq_now: if begin | restart | stop { 0 } else { aw[1:0] },
                base: if begin { new_base } else { self.base },
                roles: roles,
                cull: if begin { st.cull } else { self.cull },
                flipped: if begin { 0 } else { self.flipped | restart },
                wbank: self.wbank ^ ending,
                done: stop,
                result: if !stop {
                    self.result
                } else if abort & z == 1 {
                    RESULT_ZERO_AREA
                } else if abort {
                    RESULT_CULLED
                } else {
                    RESULT_KEPT
                },
                done_flipped: if stop { self.flipped } else { self.done_flipped },
                e: e,
                flags: flags,
                alu1_valid: issue & a_op != 0,
                alu2_valid: self.alu1_valid,
                seed3_valid: rcpld,
                lzc3_valid: lzc,
                mul1_valid: issue & m_op != 0,
                mul2_valid: self.mul1_valid,
                mul3_valid: self.mul2_valid,
                mul4_valid: self.mul3_valid,
                mul5_valid: self.mul4_valid,
                alu1: AluStage { op: a_op, a: a_a, b: a_b, temp: aw[14:9], out: aw[8:2] },
                alu2: AluExec {
                    mov: self.alu1.op == ALU_MOV,
                    add: self.alu1.op == ALU_ADD,
                    sub: self.alu1.op == ALU_SUB,
                    neg: self.alu1.op == ALU_NEG,
                    min: self.alu1.op == ALU_MIN,
                    max: self.alu1.op == ALU_MAX,
                    snap: self.alu1.op == ALU_SNAP,
                    addv: self.alu1.op == ALU_ADDV,
                    lzc: self.alu1.op == ALU_LZC,
                    rcpld: self.alu1.op == ALU_RCPLD,
                    tst: self.alu1.op == ALU_TST,
                    temp: self.alu1.temp,
                    out: self.alu1.out,
                },
                alu2_a: sel_a,
                alu2_b: sel_b,
                alu2_lt: sel_a < sel_b,
                seed3: SeedStage { temp: self.alu2.temp },
                lzc3: LzcStage { temp: self.alu2.temp, a: a, e: lzc_e },
                mul1: MulCtl {
                    op: m_op,
                    temp: mw[21:16],
                    out: mw[15:9],
                    shift: mw[8:3],
                    by_e: mw[2:2],
                    round: mw[1:1],
                    sat: mw[0:0],
                },
                mul1_a7: m_a,
                mul1_b7: m_b,
                mul2: self.mul1,
                mul2_a: ma,
                mul2_b: mb,
                mul3: self.mul2,
                mul3_p: product,
                mul4: PostCtl {
                    temp: self.mul3.temp,
                    out: self.mul3.out,
                    round: self.mul3.round,
                    sat: self.mul3.sat,
                },
                mul4_amount: amount,
                mul5: self.mul4,
                mul5_y: y,
                acc: if self.mul3_valid == 1 { acc } else { self.acc },
                read_mul: out_raddr[5:5] == 0,
                mul_rom: self.mul_rom.next(pc_next),
                alu_rom: self.alu_rom.next(pc_next),
                seeds: self.seeds.next(seed_index),
                ring: self.ring.next([ring_a, ring_b], load_we, lw.slot @ lw.field, lw.value),
                alu_bank: self.alu_bank.next(bank_addrs, alu_bank_w.we, alu_bank_w.addr[4:0], alu_bank_w.data),
                mul_bank: self.mul_bank.next(bank_addrs, mul_bank_w.we, mul_bank_w.addr[4:0], mul_bank_w.data),
                alu_out: self.alu_out.next(read_slot, alu_out_w.we, alu_out_w.addr, alu_out_w.data),
                mul_out: self.mul_out.next(read_slot, mul_out_w.we, mul_out_w.addr, mul_out_w.data),
            },
            SetupOut {
                busy: self.running,
                done: self.done,
                result: self.result,
                flipped: self.done_flipped,
                rdata: rdata,
                alu_bank: alu_bank_w,
                mul_bank: mul_bank_w,
                alu_out: alu_out_w,
                mul_out: mul_out_w,
            },
        )
    }
}

// An ALU operand: a vertex field (0x00-0x2F), a constant (0x30-0x3F), or a
// register of the ALU bank (0x40-0x5F) or the MUL bank (0x60-0x7F).
fn operand(addr: u7, ring: u36, alu: u36, mul: u36) -> i36 {
    if addr < 0x30 {
        ring as i36 wrap
    } else if addr < 0x40 {
        constant(addr[3:0])
    } else if addr < 0x60 {
        alu as i36 wrap
    } else {
        mul as i36 wrap
    }
}

// A multiplier operand: a register of the ALU or the MUL bank.
fn mul_operand(addr: u7, alu: u36, mul: u36) -> i36 {
    if addr < 0x60 { alu as i36 wrap } else { mul as i36 wrap }
}

// The constants (models/setup/src/isa.rs, Constant).
fn constant(i: u4) -> i36 {
    if i == 1 {
        8
    } else if i == 2 {
        10232
    } else if i == 3 {
        5752
    } else if i == 4 {
        17179869184
    } else {
        0
    }
}

// The position of the highest set bit of a positive area count, the
// exponent E (an area is under 2^33, so at most 32). 0 for 0.
fn msb(a: u35) -> u6 {
    if a[34:34] == 1 {
        34
    } else if a[33:33] == 1 {
        33
    } else if a[32:32] == 1 {
        32
    } else if a[31:31] == 1 {
