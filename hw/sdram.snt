// SDRAM controller for the board's W9825G6KH (4 banks x 8192 rows x 512
// columns x 16 bits), run from the 75 MHz core clock.
//
// The chip runs at CAS latency 2 with burst length 1: a run of words in one
// row is one ACTIVE, then a READ or WRITE every cycle, the last with
// auto-precharge (A10 high), which closes the row by itself; the next run
// can start the cycle after, in a bank that is ready (each bank counts down
// tWR + tRP after a write, tRP after a read, before its next ACTIVE). The
// timing is the slowest of all the part's speed grades (datasheet section
// 9.5) rounded up to whole 13.3 ns cycles, so any grade works. A requester
// asks for a run of 1 to 64 words that doesn't cross a row, and holds the
// request until `accepted`; write data is taken a word per cycle on
// `wtake`, with `wmask` high to leave that word as it was (DQM, which masks
// a write in the same cycle), and read data comes back a word per cycle on
// `rdata`. Every output
// comes from a register, so a requester can compute its request from them
// without a combinational loop.
//
// A word address is bank (bits 23:22), row (21:9), column (8:0).
//
// Every pin comes straight from a register. board/top.sv makes the SDRAM
// clock a phase-shifted copy of the core clock and owns the DQ tristate
// buffers; `dq_in` is DQ as the pins see it.

// Cycles from reset to the first command: the datasheet's 200 us power-up
// pause (section 7.1) at 75 MHz (15,000 cycles), plus margin.
const INIT_WAIT: u15 = 15100;

// Datasheet timing at 75 MHz, slowest grade, in cycles.
// tRCD (20 ns): ACTIVE to READ/WRITE.
const T_RCD: u15 = 2;
// tRP (20 ns): PRECHARGE to ACTIVE/REFRESH.
const T_RP: u15 = 2;
// tRAS (45 ns): ACTIVE to PRECHARGE.
const T_RAS: u3 = 4;
// tRC (65 ns): REFRESH to anything, and ACTIVE to ACTIVE.
const T_RC: u15 = 5;
// tWR (2 tCK): last write data to PRECHARGE.
const T_WR: u15 = 2;
// tRSC (2 tCK): MODE REGISTER SET to the next command.
const T_RSC: u15 = 2;

// Cycles between REFRESH commands. The datasheet needs 8192 per 64 ms, one
// per 585 cycles on average; refresh waits for a run in progress (at most
// about 40 cycles), so ask early.
const REFRESH_INTERVAL: u10 = 545;

// A write run after a read run starts one cycle later than it could, so its
// first WRITE is CAS latency + 2 cycles after the last READ: the chip floats
// DQ up to tHZ (6 ns) after the edge that ends its last word, which the
// FPGA mustn't drive into.

// REFRESH commands in the power-up sequence.
const INIT_REFRESHES: u4 = 8;

// The mode register: burst length 1, sequential, CAS latency 2, burst write.
const MODE: u13 = 0x020;

// Cycles from a READ on the pins to the cycle `dq_q` holds its data: CAS
// latency 2, plus `dq_q` itself; the data reaches the FPGA in time for the
// core clock edge that ends the CAS latency's last cycle. This is the bit of
// `rd_pipe` that marks the word arriving. (Phases 4 to 8 captured a cycle
// later, assuming a cycle of board delay, and on the board every word read
// was the one after it; the read words come back to back, so capturing a
// cycle earlier keeps the same timing margin.)
const READ_CAPTURE: u3 = 3;

// Commands: CS#, RAS#, CAS#, WE# (datasheet section 8).
const CMD_NOP: u4 = 0b0111;
const CMD_ACTIVE: u4 = 0b0011;
const CMD_READ: u4 = 0b0101;
const CMD_WRITE: u4 = 0b0100;
const CMD_PRECHARGE: u4 = 0b0010;
const CMD_REFRESH: u4 = 0b0001;
const CMD_MODE: u4 = 0b0000;

// The SDRAM pins, all registered. DQ is split for the tristate buffer in
// board/top.sv.
pub struct SdramPins {
    pub cke: u1,
    pub cs_n: u1,
    pub ras_n: u1,
    pub cas_n: u1,
    pub we_n: u1,
    pub ba: u2,
    pub a: u13,
    // Data mask, active high: bit 0 masks DQ[7:0], bit 1 DQ[15:8].
    pub dqm: u2,
    pub dq_out: u16,
    // High while the controller drives DQ.
    pub dq_oe: u1,
}

// A request for a run of words.
pub struct SdramReq {
    // 1 to write the run, 0 to read it.
    pub write: u1 = 0,
    // Word address of the first word.
    pub addr: u24 = 0,
    // Words in the run, 1 to 64. The run mustn't cross a row (512 words).
    pub len: u7 = 0,
}

pub struct SdramOut {
    pub pins: SdramPins,
    // High once the power-up sequence is done.
    pub ready: u1,
    // High in the cycle after a request is taken; the requester moves on to
    // its next request. (The controller is busy for many cycles after taking
    // one, so the request it still sees in this cycle is ignored.)
    pub accepted: u1,
    // High in each cycle `wdata` and `wmask` are taken for a write run.
    pub wtake: u1,
    // A word of a read run, in order.
    pub rdata: Option<u16>,
}

enum State {
    // The power-up pause.
    Init,
    // PRECHARGE ALL done: the eight refreshes, then MODE REGISTER SET.
    InitRefresh,
    // Waiting for a request or a refresh.
    Idle,
    // A row is open: one READ or WRITE per cycle, the last with
    // auto-precharge.
    Access,
}

// Registers that only matter while the state, the command and the valid
// bits say so (address, write data, run position, captured read data) are
// #[no_reset] (ADR 0006); CS#, the command, DQM and the DQ enable reset to
// NOP, masked and released.
#[module]
pub struct SdramController {
    state: State = State::Init,
    // NOP cycles still to go before the next command.
    delay: u15 = INIT_WAIT,
    // The registered pins (CKE is always high).
    cmd: u4 = CMD_NOP,
    #[no_reset]
    ba: u2 = 0,
    #[no_reset]
    a: u13 = 0,
    // DQM is held high until the mode register is set (section 7.1).
    dqm: u2 = 0b11,
    #[no_reset]
    dq_out: u16 = 0,
    // A request was taken last cycle.
    accepted: u1 = 0,
    // A word of write data is taken this cycle: free, in ACCESS, writing.
    // A function of the other registers, kept as a register of its own so
    // that the output depends on no input, even through the generated
    // Verilog's one `always_comb` (which `wdata` is read in).
    wtake: u1 = 0,
    dq_oe: u1 = 0,
    // Refreshes still to do in the power-up sequence.
    init_refreshes: u4 = INIT_REFRESHES,
    // Counts down to the next refresh; 0 means one is due.
    refresh_timer: u10 = REFRESH_INTERVAL,
    ready: u1 = 0,
    // The run in progress: direction, bank, next column, words to go.
    write: u1 = 0,
    #[no_reset]
    bank: u2 = 0,
    #[no_reset]
    column: u9 = 0,
    remaining: u7 = 0,
    // Cycles until each bank may be activated again (its auto-precharge
    // done): 0 ready.
    wait0: u3 = 0,
    wait1: u3 = 0,
    wait2: u3 = 0,
    wait3: u3 = 0,
    // The last command was a run's last READ: a write run waits a cycle.
    read_end: u1 = 0,
    // Cycles since the ACTIVE was on the pins, saturating (for tRAS).
    since_active: u3 = 0,
    // Bit i: a READ was on the pins i cycles ago.
    rd_pipe: u5 = 0,
    // DQ, registered as it arrives.
    #[no_reset]
    dq_q: u16 = 0,
}

impl SdramController {
    pub fn step(self, req: Option<SdramReq>, wdata: u16, wmask: u1, dq_in: u16) -> (Self, SdramOut) {
        let free = self.delay == 0;
        let refresh_due = self.refresh_timer == 0;
        let (valid, r) = match req {
            Some(r) => (1_u1, r),
            None => (0_u1, SdramReq { write: 0, addr: 0, len: 0 }),
        };
        let idle = free & self.state == State::Idle;
        let rb = r.addr[23:22];
        let bank_wait: u3 = if rb == 0 { self.wait0 } else if rb == 1 { self.wait1 } else if rb == 2 { self.wait2 } else { self.wait3 };
        let bank_ready = bank_wait == 0;
        let all_ready = self.wait0 == 0 & self.wait1 == 0 & self.wait2 == 0 & self.wait3 == 0;
        // A write after a read run's last READ waits a cycle (DQ turnaround).
        let turnaround = self.read_end == 1 & r.write == 1;
        let take = valid == 1 & bank_ready & !turnaround;
        let accepted = idle & !refresh_due & take;
        let wtake = self.wtake;

        // What every cycle does unless a command is issued: a NOP, the
        // waits and counters moving on, DQ registered.
        let base = Self {
            delay: if free { 0 } else { (self.delay - 1) as u15 wrap },
            cmd: CMD_NOP,
            dq_oe: 0,
            refresh_timer: if refresh_due { 0 } else { (self.refresh_timer - 1) as u10 wrap },
            since_active: if self.since_active == 7 { 7 } else { (self.since_active + 1) as u3 wrap },
            wait0: if self.wait0 == 0 { 0 } else { (self.wait0 - 1) as u3 wrap },
            wait1: if self.wait1 == 0 { 0 } else { (self.wait1 - 1) as u3 wrap },
            wait2: if self.wait2 == 0 { 0 } else { (self.wait2 - 1) as u3 wrap },
            wait3: if self.wait3 == 0 { 0 } else { (self.wait3 - 1) as u3 wrap },
            read_end: 0,
            dq_q: dq_in,
            ..self
        };

        let next = if !free {
            base
        } else {
            match self.state {
                State::Init => Self {
                    state: State::InitRefresh,
                    cmd: CMD_PRECHARGE,
                    a: 0x400,
                    delay: (T_RP - 1) as u15 wrap,
                    ..base
                },
                State::InitRefresh => if self.init_refreshes != 0 {
                    Self {
                        cmd: CMD_REFRESH,
                        delay: (T_RC - 1) as u15 wrap,
                        init_refreshes: (self.init_refreshes - 1) as u4 wrap,
                        ..base
                    }
                } else {
                    Self {
                        state: State::Idle,
                        cmd: CMD_MODE,
                        a: MODE,
                        dqm: 0,
                        delay: (T_RSC - 1) as u15 wrap,
                        refresh_timer: REFRESH_INTERVAL,
                        ready: 1,
                        ..base
                    }
                },
                State::Idle => if refresh_due {
                    // Every bank must be precharged (tRP met) first.
                    if all_ready {
                        Self {
                            cmd: CMD_REFRESH,
                            delay: (T_RC - 1) as u15 wrap,
                            refresh_timer: REFRESH_INTERVAL,
                            ..base
                        }
                    } else {
                        base
                    }
                } else if take {
                    Self {
                        state: State::Access,
                        cmd: CMD_ACTIVE,
                        ba: r.addr[23:22],
                        a: r.addr[21:9],
                        delay: (T_RCD - 1) as u15 wrap,
                        write: r.write,
                        bank: r.addr[23:22],
                        column: r.addr[8:0],
                        remaining: r.len,
                        since_active: 0,
                        ..base
                    }
                } else {
                    base
                },
                State::Access => {
                    let last = self.remaining == 1;
                    // The last access's auto-precharge starts at least
                    // tRAS after the ACTIVE: a read's a cycle after it, so
                    // a read run too short for that waits (a write's starts
                    // tWR after it, always late enough; and a write mustn't
                    // wait, `wtake` having promised its word).
                    let early = last & self.write == 0 & ((0_u1 @ self.since_active) + 1) < (T_RAS - 1) as u5 wrap;
                    // After the last, the bank is ready again tWR + tRP
                    // (a write) or tRP (a read) later.
                    let wait: u3 = if self.write == 1 { (T_WR + T_RP - 1) as u3 wrap } else { T_RP as u3 wrap };
                    let closing = last & !early;
                    if early {
                        base
                    } else {
                        Self {
                            state: if last { State::Idle } else { State::Access },
                            cmd: if self.write == 1 { CMD_WRITE } else { CMD_READ },
                            ba: self.bank,
                            // A10 high on the last: auto-precharge.
                            a: 0_u2 @ (if last { 1_u1 } else { 0_u1 }) @ 0_u1 @ self.column,
                            // A write's DQM masks its own word; a read's
                            // must be low (it masks the data two cycles
                            // later).
                            dqm: if self.write == 1 { wmask @ wmask } else { 0 },
                            dq_out: wdata,
                            dq_oe: self.write,
                            column: (self.column + 1) as u9 wrap,
                            remaining: (self.remaining - 1) as u7 wrap,
                            wait0: if closing & self.bank == 0 { wait } else { base.wait0 },
                            wait1: if closing & self.bank == 1 { wait } else { base.wait1 },
                            wait2: if closing & self.bank == 2 { wait } else { base.wait2 },
                            wait3: if closing & self.bank == 3 { wait } else { base.wait3 },
                            read_end: if closing & self.write == 0 { 1 } else { 0 },
                            ..base
                        }
                    }
                },
            }
        };

        let out = SdramOut {
            pins: SdramPins {
                cke: 1,
                cs_n: self.cmd[3:3],
                ras_n: self.cmd[2:2],
                cas_n: self.cmd[1:1],
                we_n: self.cmd[0:0],
                ba: self.ba,
                a: self.a,
                dqm: self.dqm,
                dq_out: self.dq_out,
                dq_oe: self.dq_oe,
            },
            ready: self.ready,
            accepted: self.accepted,
            wtake: wtake,
            rdata: if self.rd_pipe[READ_CAPTURE:READ_CAPTURE] == 1 { Some(self.dq_q) } else { None },
        };
        (
            Self {
                rd_pipe: self.rd_pipe[3:0] @ (next.cmd == CMD_READ),
                accepted: accepted,
                wtake: next.delay == 0 & next.state == State::Access & next.write == 1,
                ..next
            },
            out,
        )
    }
}
