// Synthesis root for the setup engine on its own (`just setup-report`):
// an LFSR drives its inputs, and its outputs are folded into 8 bits, so
// that place and route sees the whole engine through a handful of pins.
// Not part of the design.

mod setup;

use root::setup::SetupEngine;
use root::setup::Start;
use root::setup::VertexWrite;

struct SetupSynth {
    lfsr: u64 = 1,
    engine: SetupEngine,
    // The engine's outputs, registered before they are folded, so that the
    // folding isn't on the engine's paths.
    words: u36 = 0,
    flags: u8 = 0,
    addrs: u8 = 0,
    pub fold: u8 = 0,
}

impl SetupSynth {
    #[clock(domain = core, period = 1)]
    fn tick(self) -> SetupSynth {
        let l = self.lfsr;
        let fb = l[63:63] ^ l[62:62] ^ l[60:60] ^ l[59:59];
        let load: Option<VertexWrite> = if l[0:0] == 1 {
            Some(VertexWrite { slot: l[2:1], field: l[6:3], value: l[42:7] })
        } else {
            None
        };
        let start: Option<Start> = if l[43:43] == 1 {
            Some(Start { roles: l[49:44], cull: l[51:50], untextured: l[52:52] })
        } else {
            None
        };
        let (engine, o) = self.engine.step(load, start, l[58:53]);
        let words = o.rdata ^ o.alu_bank.data ^ o.mul_bank.data ^ o.alu_out.data ^ o.mul_out.data;
        let flags = o.busy @ o.done @ o.result @ o.flipped @ o.alu_bank.we @ o.mul_bank.we @ o.alu_out.we;
        let addrs = (o.alu_bank.addr @ o.mul_out.we @ o.mul_bank.addr[0:0])
            ^ (o.alu_out.addr @ o.mul_out.addr[1:0]);
        let w = self.words;
        let fold = w[7:0] ^ w[15:8] ^ w[23:16] ^ w[31:24] ^ (0_u4 @ w[35:32]) ^ self.flags ^ self.addrs;
        SetupSynth {
            lfsr: l[62:0] @ fb,
            engine: engine,
            words: words,
            flags: flags,
            addrs: addrs,
            fold: fold,
        }
    }
}
